                    + 'class="btn btn-outline-success btn-sm btn-them-dong-item" '
                    + 'data-kv-idx="' + kvIdx + '">'
                    + '<i class="bi bi-plus-circle me-1"></i>Thêm dòng'
                    + '</button>'
                    + '</div>'
                    + '</div>';
            }

            // ── Thêm khu vực mới ─────────────────────────────────────────
            $(document).on('click', '#btnThemKhuVuc', function () {
                var html = taoCardKhuVuc(khuVucIndex, '');
                $('#containerKhuVuc').append(html);
                // Thêm 1 dòng mặc định
                themDongItem(khuVucIndex);
                khuVucIndex++;
            });

            // ── Xóa khu vực ──────────────────────────────────────────────
            $(document).on('click', '.btn-xoa-khu-vuc', function () {
                $(this).closest('.card-khu-vuc').remove();
                capNhatTongQuanTienDo();
            });

            // ── Thêm dòng vào bảng khu vực ───────────────────────────────
            function themDongItem(kvIdx) {
                var itemIdx = $('.tbody-items-' + kvIdx + ' tr').length;
                var html = taoHtmlDongItem(kvIdx, itemIdx);
                $('.tbody-items-' + kvIdx).append(html);
            }

            $(document).on('click', '.btn-them-dong-item', function () {
                var kvIdx = $(this).data('kv-idx');
                themDongItem(kvIdx);
            });

            // ── Xóa dòng ─────────────────────────────────────────────────
            $(document).on('click', '.btn-xoa-dong-item', function () {
                var kvIdx = $(this).closest('.card-khu-vuc').data('kv-idx');
                $(this).closest('tr').remove();
                capNhatTongQuanTienDo();
                capNhatSummaryKhuVuc(kvIdx); // *** THÊM MỚI ***
            });

            // ── Tính % tiến độ từng dòng khi KLHĐ/KLTT thay đổi ─────────
            $(document).on('input', '.inp-klhd, .inp-kltt', function () {
                var $row = $(this).closest('tr');
                var klhd = parseFloat($row.find('.inp-klhd').val()) || 0;
                var kltt = parseFloat($row.find('.inp-kltt').val()) || 0;
                var pct = klhd > 0 ? Math.min((kltt / klhd) * 100, 100) : 0;
                $row.find('.pct-tien-do').text(pct.toFixed(1) + '%');
                capNhatTongQuanTienDo();

                // *** THÊM MỚI ***
                var kvIdx = $row.closest('.card-khu-vuc').data('kv-idx');
                capNhatSummaryKhuVuc(kvIdx);
            });

            // Khi thay đổi dropdown hạng mục
            $(document).on('change', '.dd-hang-muc', function () {
                var kvIdx = $(this).closest('.card-khu-vuc').data('kv-idx');
                capNhatSummaryKhuVuc(kvIdx); // *** THÊM MỚI ***
            });

            // ── Tính tổng tỉ trọng realtime ──────────────────────────────
            $(document).on('input', '.ti-trong', function () {
                capNhatTongTiTrong();
                capNhatTongQuanTienDo();
            });

            function capNhatTongTiTrong() {
                var xd = parseFloat($('#cfg_XayDung').val()) || 0;
                var kct = parseFloat($('#cfg_KetCauThep').val()) || 0;
                var ldt = parseFloat($('#cfg_LapDatThietBi').val()) || 0;
                var hmk = parseFloat($('#cfg_HangMucKhac').val()) || 0;
                var tong = xd + kct + ldt + hmk;

                var la100 = Math.abs(tong - 100) < 0.01;

                $('#cfg_TongTiTrong').html('<span class="'
                    + (la100 ? 'text-success' : 'text-danger')
                    + '">' + tong.toFixed(2) + '%</span>');

                // Hiện/ẩn cảnh báo động ***
                if (!la100 && tong > 0) {
                    $('#cfg_TongTiTrongCanhBao').text(tong.toFixed(2) + '%');
                    $('#cfg_CanhBaoTiTrong').show();
                } else {
                    $('#cfg_CanhBaoTiTrong').hide();
                }

                // Cập nhật badge tỉ trọng trong card tổng quan ***
                $('#badge_TiTrong_XayDung').text('Trọng số: ' + xd.toFixed(1) + '%');
                $('#badge_TiTrong_KetCauThep').text('Trọng số: ' + kct.toFixed(1) + '%');
                $('#badge_TiTrong_LapDatThietBi').text('Trọng số: ' + ldt.toFixed(1) + '%');
                $('#badge_TiTrong_HangMucKhac').text('Trọng số: ' + hmk.toFixed(1) + '%');
            }

            // ── Tính tiến độ tổng quan theo từng loại hạng mục ──────────
            function capNhatTongQuanTienDo() {
                var tiTrong = {
                    'Xây dựng': parseFloat($('#cfg_XayDung').val()) || 0,
                    'Kết cấu thép': parseFloat($('#cfg_KetCauThep').val()) || 0,
                    'Lắp đặt thiết bị': parseFloat($('#cfg_LapDatThietBi').val()) || 0,
                    'Khác': parseFloat($('#cfg_HangMucKhac').val()) || 0
                };

                // Tính % tiến độ trung bình theo từng loại
                var sumPct = {
                    'Xây dựng': 0, 'Kết cấu thép': 0,
                    'Lắp đặt thiết bị': 0, 'Khác': 0
                };
                var count = {
                    'Xây dựng': 0, 'Kết cấu thép': 0,
                    'Lắp đặt thiết bị': 0, 'Khác': 0
                };

                $('#containerKhuVuc .tbl-khu-vuc tbody tr').each(function () {
                    var $row = $(this);
                    var hangMuc = $row.find('.dd-hang-muc').val()
                        || $row.find('.txt-hang-muc-tay').val()
                        || '';
                    var klhd = parseFloat($row.find('.inp-klhd').val()) || 0;
                    var kltt = parseFloat($row.find('.inp-kltt').val()) || 0;
                    var pct = klhd > 0
                        ? Math.min((kltt / klhd) * 100, 100) : 0;

                    var key = hangMuc;
                    if (!sumPct.hasOwnProperty(key)) key = 'Khác';
                    sumPct[key] += pct;
                    count[key]++;
                });

                // Tính % trung bình từng loại
                var avgXayDung = count['Xây dựng'] > 0
                    ? sumPct['Xây dựng'] / count['Xây dựng'] : 0;
                var avgKetCauThep = count['Kết cấu thép'] > 0
                    ? sumPct['Kết cấu thép'] / count['Kết cấu thép'] : 0;
                var avgLapDatThietBi = count['Lắp đặt thiết bị'] > 0
                    ? sumPct['Lắp đặt thiết bị'] / count['Lắp đặt thiết bị'] : 0;
                var avgKhac = count['Khác'] > 0
                    ? sumPct['Khác'] / count['Khác'] : 0;

                // Tổng tiến độ = bình quân gia quyền theo tỉ trọng
                var tongTienDo = (avgXayDung * tiTrong['Xây dựng']
                    + avgKetCauThep * tiTrong['Kết cấu thép']
                    + avgLapDatThietBi * tiTrong['Lắp đặt thiết bị']
                    + avgKhac * tiTrong['Khác']) / 100;

                $('#td_XayDung').text(avgXayDung.toFixed(1) + '%');
                $('#td_KetCauThep').text(avgKetCauThep.toFixed(1) + '%');
                $('#td_LapDatThietBi').text(avgLapDatThietBi.toFixed(1) + '%');
                $('#td_HangMucKhac').text(avgKhac.toFixed(1) + '%');
                $('#td_TongTienDo').text(tongTienDo.toFixed(1) + '%');
            }

            // ── Tính và cập nhật summary tiến độ từng khu vực ────────────
            function capNhatSummaryKhuVuc(kvIdx) {
                var tongPct = 0;
                var tongDong = 0;

                var sumHM = {
                    'Xây dựng': { tong: 0, count: 0 },
                    'Kết cấu thép': { tong: 0, count: 0 },
                    'Lắp đặt thiết bị': { tong: 0, count: 0 },
                    'Khác': { tong: 0, count: 0 }
                };

                $('.tbody-items-' + kvIdx + ' tr').each(function () {
                    var $row = $(this);
                    var klhd = parseFloat($row.find('.inp-klhd').val()) || 0;
                    var kltt = parseFloat($row.find('.inp-kltt').val()) || 0;
                    var pct = klhd > 0
                        ? Math.min((kltt / klhd) * 100, 100) : 0;

                    tongPct += pct;
                    tongDong++;

                    // Xác định nhóm hạng mục
                    var ddVal = $row.find('.dd-hang-muc').val();
                    var txtVal = $row.find('.txt-hang-muc-tay').val().trim();

                    var nhom;
                    if (ddVal && ddVal !== '') {
                        // Chọn từ dropdown
                        nhom = ddVal; // 'Xây dựng', 'Kết cấu thép', 'Lắp đặt thiết bị'
                    } else {
                        // Nhập tay → Hạng mục khác
                        nhom = 'Khác';
                    }

                    if (!sumHM.hasOwnProperty(nhom)) nhom = 'Khác';
                    sumHM[nhom].tong += pct;
                    sumHM[nhom].count++;
                });

                // Tính tiến độ chung
                var chung = tongDong > 0
                    ? (tongPct / tongDong).toFixed(1) : 0;

                // Tính tiến độ từng hạng mục
                var avgXD = sumHM['Xây dựng'].count > 0
                    ? (sumHM['Xây dựng'].tong / sumHM['Xây dựng'].count).toFixed(1)
                    : null;
                var avgKCT = sumHM['Kết cấu thép'].count > 0
                    ? (sumHM['Kết cấu thép'].tong / sumHM['Kết cấu thép'].count).toFixed(1)
                    : null;
                var avgLDT = sumHM['Lắp đặt thiết bị'].count > 0
                    ? (sumHM['Lắp đặt thiết bị'].tong / sumHM['Lắp đặt thiết bị'].count).toFixed(1)
                    : null;
                var avgKhac = sumHM['Khác'].count > 0
                    ? (sumHM['Khác'].tong / sumHM['Khác'].count).toFixed(1)
                    : null;

                // Cập nhật badge — ẩn nếu không có dữ liệu
                $('.summary-chung-' + kvIdx).text('Chung: ' + chung + '%');

                if (avgXD !== null) {
                    $('.summary-xd-' + kvIdx)
                        .text('Xây dựng: ' + avgXD + '%').show();
                } else {
                    $('.summary-xd-' + kvIdx).hide();
                }

                if (avgKCT !== null) {
                    $('.summary-kct-' + kvIdx)
                        .text('Kết cấu thép: ' + avgKCT + '%').show();
                } else {
                    $('.summary-kct-' + kvIdx).hide();
                }

                if (avgLDT !== null) {
                    $('.summary-ldt-' + kvIdx)
                        .text('Lắp đặt thiết bị: ' + avgLDT + '%').show();
                } else {
                    $('.summary-ldt-' + kvIdx).hide();
                }

                if (avgKhac !== null) {
                    $('.summary-khac-' + kvIdx)
                        .text('Hạng mục khác: ' + avgKhac + '%').show();
                } else {
                    $('.summary-khac-' + kvIdx).hide();
                }
            }

            // ── Bind dữ liệu khi load modal ──────────────────────────────
            window.bindTienDoData = function (data) {
                if (!data) {
                    // Reset về mặc định
                    $('#cfg_XayDung, #cfg_KetCauThep, '
                        + '#cfg_LapDatThietBi, #cfg_HangMucKhac').val('');
                    $('#cfg_DanhGiaChung').val(0);
                    $('#containerKhuVuc').empty();
                    khuVucIndex = 0;
                    // Thêm 1 card khu vực mặc định
                    var html = taoCardKhuVuc(khuVucIndex, '');
                    $('#containerKhuVuc').append(html);
                    themDongItem(khuVucIndex);
                    khuVucIndex++;
                    capNhatTongTiTrong();
                    capNhatTongQuanTienDo();
                    return;
                }

                // Bind cấu hình tỉ trọng
                $('#cfg_XayDung').val(data.TiTrongXayDung || 0);
                $('#cfg_KetCauThep').val(data.TiTrongKetCauThep || 0);
                $('#cfg_LapDatThietBi').val(data.TiTrongLapDatThietBi || 0);
                $('#cfg_HangMucKhac').val(data.TiTrongHangMucKhac || 0);
                $('#cfg_DanhGiaChung').val(
                    data.DanhGiaChung !== null && data.DanhGiaChung !== undefined
                        ? data.DanhGiaChung
                        : ''
                );
                capNhatTongTiTrong();

                // Bind danh sách khu vực
                $('#containerKhuVuc').empty();
                khuVucIndex = 0;

                if (!data.DanhSachKhuVuc || data.DanhSachKhuVuc.length === 0) {
                    // Thêm 1 card mặc định nếu chưa có dữ liệu
                    var html = taoCardKhuVuc(khuVucIndex, '');
                    $('#containerKhuVuc').append(html);
                    themDongItem(khuVucIndex);
                    khuVucIndex++;
                } else {
                    $.each(data.DanhSachKhuVuc, function (i, kv) {
                        var html = taoCardKhuVuc(khuVucIndex, kv.TenKhuVuc, kv.CreatedByUserId); // *** THÊM tham số ***
                        $('#containerKhuVuc').append(html);
                        var kvIdx = khuVucIndex;

                        // Bind các dòng
                        if (kv.DanhSachDong && kv.DanhSachDong.length > 0) {
                            $.each(kv.DanhSachDong, function (j, dong) {
                                themDongItem(kvIdx);
                                var $lastRow = $('.tbody-items-' + kvIdx + ' tr:last');
                                $lastRow.attr('data-item-id', dong.ProgressAreaItemId || 0);
                                $lastRow.attr('data-created-by', dong.CreatedByUserId || ''); // *** THÊM ***
                                // Set giá trị từng dòng
                                if (dong.HangMucCongViec) {
                                    $lastRow.find('.dd-hang-muc').val(dong.HangMucCongViec);
                                    // Dropdown hiện, textbox ẩn (mặc định)
                                } else if (dong.HangMucNhapTay) {
                                    // *** THÊM MỚI: có nhập tay → ẩn dropdown, hiện textbox ***
                                    $lastRow.find('.dd-hang-muc').hide().val('');
                                    $lastRow.find('.txt-hang-muc-tay').show().val(dong.HangMucNhapTay);
                                    $lastRow.find('.btn-toggle-nhap-tay').html('<small class="text-muted">🔽 Chọn danh sách</small>');
                                }
                                $lastRow.find('.txt-hang-muc-tay').val(dong.HangMucNhapTay || '');
                                // --- THÊM MỚI: Bind dữ liệu cho 2 cột mới ---
                                $lastRow.find('.inp-mo-ta').val(dong.MoTaHangMuc || '');
                                $lastRow.find('.inp-y-kien-pda').val(dong.YKienPDA || '');
                                // --------------------------------------------
                                $lastRow.find('.inp-dvt').val(dong.DVT || '');
                                $lastRow.find('.inp-klhd').val(dong.KLHD || 0);
                                $lastRow.find('.inp-kltt').val(dong.KLTT || 0);
                                $lastRow.find('.inp-ghi-chu').val(dong.GhiChu || '');

                                // Tính % tiến độ
                                var klhd = parseFloat(dong.KLHD) || 0;
                                var kltt = parseFloat(dong.KLTT) || 0;
                                var pct = klhd > 0
                                    ? Math.min((kltt / klhd) * 100, 100) : 0;
                                $lastRow.find('.pct-tien-do')
                                    .text(pct.toFixed(1) + '%');
                            });
                        } else {
                            themDongItem(kvIdx);
                        }
                        khuVucIndex++;
                        capNhatSummaryKhuVuc(kvIdx); // *** THÊM MỚI ***
                    });
                }
                capNhatTongQuanTienDo();
                // *** THÊM MỚI: Sau khi render xong, xử lý quyền sửa/xóa ***
                if (data && data.DanhSachKhuVuc && !isManagerOrAdminGlobal) {
                    $.each(data.DanhSachKhuVuc, function (i, kv) {
                        var $card = $('#containerKhuVuc .card-khu-vuc').eq(i);
                        var cardCanEdit = kv.CreatedByUserId == currentUserIdGlobal
                            || kv.CreatedByUserId == null;

                        if (!cardCanEdit) {
                            // Ẩn nút xóa khu vực + disable tên khu vực
                            $card.find('.btn-xoa-khu-vuc').hide();
                            $card.find('.inp-ten-khu-vuc').prop('disabled', true);
                        }

                        // *** THAY ĐỔI: Xử lý quyền ở cấp DÒNG ***
                        $card.find('tbody tr').each(function () {
                            var itemId = parseInt($(this).data('item-id')) || 0;
                            var createdBy = parseInt($(this).data('created-by')) || 0;

                            // Dòng mới (itemId = 0) → luôn cho phép sửa/xóa
                            if (itemId === 0) return;

                            // Dòng cũ — kiểm tra CreatedByUserId
                            var rowCanEdit = createdBy === currentUserIdGlobal;
                            if (!rowCanEdit) {
                                $(this).find('input, select, textarea')
                                    .prop('disabled', true);
                                $(this).find('.btn-xoa-dong-item').hide();
                            }
                        });
                    });
                }
            };

            // ── Thu thập dữ liệu để lưu ──────────────────────────────────
            window.collectTienDoData = function () {
                var danhSachKhuVuc = [];
                $('#containerKhuVuc .card-khu-vuc').each(function () {
                    var $card = $(this);
                    var kvIdx = $card.data('kv-idx');
                    var tenKV = $card.find('.inp-ten-khu-vuc').val().trim();
                    if (!tenKV) return; // bỏ qua card chưa nhập tên

                    // *** THÊM MỚI: Lấy CreatedByUserId từ data attribute ***
                    var createdBy = $card.data('created-by') || null;

                    var danhSachDong = [];
                    $card.find('.tbl-khu-vuc tbody tr').each(function () {
                        var $row = $(this);
                        danhSachDong.push({
                            ProgressAreaItemId: parseInt($row.data('item-id')) || 0,
                            CreatedByUserId: parseInt($row.data('created-by')) || null, // *** THÊM ***
                            HangMucCongViec: $row.find('.dd-hang-muc').val() || null,
                            HangMucNhapTay: $row.find('.txt-hang-muc-tay').val() || null,
                            // --- THÊM MỚI 2 TRƯỜNG DƯỚI ĐÂY ---
                            MoTaHangMuc: $row.find('.inp-mo-ta').val() || null,
                            YKienPDA: $row.find('.inp-y-kien-pda').val() || null,
                            // ---------------------------------
                            DVT: $row.find('.inp-dvt').val() || null,
                            KLHD: parseFloat($row.find('.inp-klhd').val()) || 0,
                            KLTT: parseFloat($row.find('.inp-kltt').val()) || 0,
                            GhiChu: $row.find('.inp-ghi-chu').val() || null
                        });
                    });

                    danhSachKhuVuc.push({
                        TenKhuVuc: tenKV,
                        CreatedByUserId: createdBy, // *** THÊM MỚI ***
                        DanhSachDong: danhSachDong
                    });
                });

                return {
                    TiTrongXayDung: parseFloat($('#cfg_XayDung').val()) || 0,
                    TiTrongKetCauThep: parseFloat($('#cfg_KetCauThep').val()) || 0,
                    TiTrongLapDatThietBi: parseFloat($('#cfg_LapDatThietBi').val()) || 0,
                    TiTrongHangMucKhac: parseFloat($('#cfg_HangMucKhac').val()) || 0,
                    DanhGiaChung: $('#cfg_DanhGiaChung').val() !== ''
                        ? parseInt($('#cfg_DanhGiaChung').val())
                        : null,
                    DanhSachKhuVuc: danhSachKhuVuc,
                    TongTienDo: parseFloat(
                        $('#td_TongTienDo').text().replace('%', '')
                    ) || 0
                };
            };

            // ── Toggle nhập tay / dropdown Hạng mục ─────────────────────
            $(document).on('click', '.btn-toggle-nhap-tay', function () {
                var $td = $(this).closest('td');
                var $dd = $td.find('.dd-hang-muc');
                var $txt = $td.find('.txt-hang-muc-tay');
                var $btn = $(this);
                var isNhapTay = $dd.is(':visible');

                if (isNhapTay) {
                    // Chuyển sang nhập tay
                    $dd.hide().val('');
                    $txt.show().focus();
                    $btn.html('<small class="text-muted">🔽 Chọn danh sách</small>');
                } else {
                    // Chuyển về dropdown
                    $txt.hide().val('');
                    $dd.show();
                    $btn.html('<small class="text-muted">✏️ Nhập tay</small>');
                }

                var kvIdx = $(this).closest('.card-khu-vuc').data('kv-idx');
                capNhatSummaryKhuVuc(kvIdx); // *** THÊM MỚI ***
            });

            // ── Xóa hồ sơ ────────────────────────────────────────────────
            $(document).on('click', '.btn-delete', function () {
                var budgetId    = $(this).data('budget-id');
                var tenHangMuc  = $(this).data('ten-hang-muc') || 'này';

                if (!confirm('Bạn có chắc chắn muốn xóa hồ sơ "'
                           + tenHangMuc + '" không?\n'
                           + 'Thao tác này không thể hoàn tác!')) return;

                var $btn = $(this);
                $btn.prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split"></i>');

                $.ajax({
                    url:  '@Url.Action("Delete", "Budget")',
                    type: 'POST',
                    data: { id: budgetId },
                    success: function (res) {
                        if (res.success) {
                            // Reload giữ nguyên filter/search/page
                            location.reload();
                        } else {
                            alert(res.message);
                            $btn.prop('disabled', false)
                                .html('<i class="bi bi-trash"></i> Xóa');
                        }
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi khi xóa hồ sơ.');
                        $btn.prop('disabled', false)
                            .html('<i class="bi bi-trash"></i> Xóa');
                    }
                });
            });

            function _updateModalButtons(workflowType, ngayDuyetBGD, isOwner) {
                var isAdmin   = @(ViewBag.IsManagerOrAdmin == true ? "true" : "false");
                var isTraHoSo = (workflowType === 4);
                var coDuyetBGD = (ngayDuyetBGD !== null
                               && ngayDuyetBGD !== undefined
                               && ngayDuyetBGD !== '');
                var isDuyet   = (workflowType === 1 || workflowType === 2);

                // ── Reset tất cả về ẩn ───────────────────────────────────
                $('#btnSaveDetailsModal').hide();
                $('#btnTraHoSo').hide();
                $('#btnGuiLai').hide();
                $('#btnChinhSua').hide();
                $('#btnGuiChinhSua').hide();

                // ── Reset field về disabled (mặc định) ───────────────────
                _setAllPhieuEditable(false);
                _setPhieuEditable(false);

                // ── ADMIN ────────────────────────────────────────────────
                if (isAdmin) {
                    // Lưu thông tin: luôn hiện với Admin
                    $('#btnSaveDetailsModal').show();

                    // Trả hồ sơ: chưa có NgayDuyetBGD
                    if (!coDuyetBGD && !isTraHoSo) {
                        $('#btnTraHoSo').show();
                    }
                    return;
                }

                // ── USER (chủ hồ sơ) ─────────────────────────────────────
                if (!isOwner) return; // Không phải chủ hồ sơ → không có button

                // WorkflowType = 4: Gửi lại
                if (isTraHoSo) {
                    $('#btnGuiLai').show();
                    _setPhieuEditable(true); // Mở field cho user chỉnh sửa
                    return;
                }

                // Đã duyệt BGĐ (WorkflowType 1|2 + có NgayDuyetBGD): Lưu thông tin
                if (isDuyet && coDuyetBGD) {
                    $('#btnSaveDetailsModal').show();
                    return;
                }

                // Chưa có NgayDuyetBGD: Chỉnh sửa
                if (!coDuyetBGD) {
                    if (!_isEditMode) {
                        // Bình thường: hiện Chỉnh sửa
                        $('#btnChinhSua')
                            .removeClass('btn-secondary')
                            .addClass('btn-warning')
                            .html('<i class="bi bi-pencil me-1"></i>Chỉnh sửa')
                            .show();
                    } else {
                        // Edit mode: hiện Gửi chỉnh sửa + Hủy
                        _setAllPhieuEditable(true);
                        $('#btnGuiChinhSua').show();
                        $('#btnChinhSua')
                            .removeClass('btn-warning')
                            .addClass('btn-secondary')
                            .html('<i class="bi bi-x-circle me-1"></i>Hủy chỉnh sửa')
                            .show();
                    }
                }
            }

            // ── Nút Chỉnh sửa / Hủy chỉnh sửa ──────────────────────────
            $(document).on('click', '#btnChinhSua', function () {
                _isEditMode = !_isEditMode;
                console.log('_isEditMode: ' +_isEditMode)

                if (_isEditMode) {
                    _setAllPhieuEditable(true);
                } else {
                    // Hủy: restore snapshot
                    _restoreSnapshot(_snapshotPhieu);
                    _setAllPhieuEditable(false);
                }

                // Cập nhật lại toàn bộ button
                _updateModalButtons(
                    _currentWorkflowType,
                    _currentNgayDuyetBGD,
                    _currentIsOwner
                );
            });

            // ── Nút Gửi lại (WorkflowType = 4) ──────────────────────────
            $(document).on('click', '#btnGuiLai', function () {
                var $btn = $(this);
                var fd   = new FormData();

                fd.append('BudgetRegistrationId', currentBudgetId);
                fd.append('ProjectAreaId',
                    $('#modal_AreaName').val() === '-1' ? '' : $('#modal_AreaName').val());
                fd.append('TenHangMuc',          $('#modal_TenHangMuc').val()      || '');
                fd.append('DuToan',              parseCurrency($('#modal_DuToan').val()));
                fd.append('SoToTrinh',           $('#modal_SoToTrinh').val()        || '');
                fd.append('CategoryTypeId',      $('#modal_CategoryTypeId').val()   || '');
                fd.append('PriorityLevelId',     $('#modal_PriorityLevelId').val()  || '');
                fd.append('SoLuong',             $('#modal_SoLuong').val()          || '');
                fd.append('NgayBatDau',          $('#modal_NgayBatDau').val()       || '');
                fd.append('NgayKetThuc',         $('#modal_NgayKetThuc').val()      || '');
                fd.append('InvestmentReasonId',  $('#modal_InvestmentReasonId').val() || '');
                fd.append('LyDoDauTu',           $('#modal_LyDoDauTu').val()        || '');
                fd.append('MoTaKyThuat',         $('#modal_MoTaKyThuat').val()      || '');
                fd.append('LinkTaiLieuLienQuan', $('#modal_LinkTaiLieu').val()      || '');

                var fileInput = document.getElementById('revisionFileInput');
                if (fileInput && fileInput.files.length > 0) {
                    for (var i = 0; i < fileInput.files.length; i++) {
                        fd.append('HoSoCanCu', fileInput.files[i]);
                    }
                }

                $btn.prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i>Đang gửi...');

                $.ajax({
                    url         : '@Url.Action("SubmitRevision", "Budget")',
                    type        : 'POST',
                    data        : fd,
                    processData : false,
                    contentType : false,
                    success: function (res) {
                        if (res.success) {
                            showModalAlert('success', res.message);
                        } else {
                            showModalAlert('danger', res.message);
                        }
                    },
                    error   : function () { showModalAlert('danger', 'Lỗi kết nối.'); },
                    complete: function () {
                        $btn.prop('disabled', false)
                            .html('<i class="bi bi-send me-1"></i>Gửi lại');
                    }
                });
            });

            // ── Nút Gửi thông tin chỉnh sửa ─────────────────────────────
            $(document).on('click', '#btnGuiChinhSua', function () {
                var lyDo = $('#modal_LyDoChinhSua').val().trim();
                if (!lyDo) {
                    alert('Vui lòng nhập lý do chỉnh sửa.');
                    $('#modal_LyDoChinhSua').focus();
                    return;
                }

                var $btn = $(this);
                var fd   = new FormData();

                fd.append('BudgetRegistrationId', currentBudgetId);
                fd.append('RevisionType',         '2');
                fd.append('LyDoChinhSua',         lyDo);
                fd.append('ProjectAreaId',
                    $('#modal_AreaName').val() === '-1' ? '' : $('#modal_AreaName').val());
                fd.append('ProjectAreaCustom',
                    $('#modal_AreaName').val() === '-1'
                        ? $('#modal_ProjectAreaCustom').val() : '');
                fd.append('TenHangMuc',          $('#modal_TenHangMuc').val()      || '');
                fd.append('DuToan',              parseCurrency($('#modal_DuToan').val()));
                fd.append('SoToTrinh',           $('#modal_SoToTrinh').val()        || '');
                fd.append('CategoryTypeId',      $('#modal_CategoryTypeId').val()   || '');
                fd.append('PriorityLevelId',     $('#modal_PriorityLevelId').val()  || '');
                fd.append('SoLuong',             $('#modal_SoLuong').val()          || '');
                fd.append('NgayBatDau',          $('#modal_NgayBatDau').val()       || '');
                fd.append('NgayKetThuc',         $('#modal_NgayKetThuc').val()      || '');
                fd.append('InvestmentReasonId', $('#modal_InvestmentReasonId').val() || '');
                fd.append('LyDoDauTu',           $('#modal_LyDoDauTu').val()        || '');
                fd.append('MoTaKyThuat',         $('#modal_MoTaKyThuat').val()      || '');
                fd.append('LinkTaiLieuLienQuan', $('#modal_LinkTaiLieu').val()      || '');

                var fileInput = document.getElementById('revisionFileInput');
                if (fileInput && fileInput.files.length > 0) {
                    for (var i = 0; i < fileInput.files.length; i++) {
                        fd.append('HoSoCanCu', fileInput.files[i]);
                    }
                }

                $btn.prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i>Đang gửi...');

                $.ajax({
                    url         : '@Url.Action("SubmitEditRequest", "Budget")',
                    type        : 'POST',
                    data        : fd,
                    processData : false,
                    contentType : false,
                    success: function (res) {
                        if (res.success) {
                            showModalAlert('success', res.message);
                            // Thoát edit mode sau khi gửi thành công
                            _isEditMode = false;
                            _setAllPhieuEditable(false);
                            _restoreSnapshot(_snapshotPhieu);
                            _updateModalButtons(
                                _currentWorkflowType,
                                _currentNgayDuyetBGD,
                                _currentIsOwner
                            );
                        } else {
                            showModalAlert('danger', res.message);
                        }
                    },
                    error   : function () { showModalAlert('danger', 'Lỗi kết nối.'); },
                    complete: function () {
                        $btn.prop('disabled', false)
                            .html('<i class="bi bi-send me-1"></i>Gửi thông tin chỉnh sửa');
                    }
                });
            });

            // Nút Trả hồ sơ → mở modal nhập lý do
            $(document).on('click', '#btnTraHoSo', function () {
                // Reset modal
                $('#txtLyDoTra').val('');
                $('#errLyDoTra').hide();

                // Mở modal nhập lý do
                var modal = new bootstrap.Modal(
                    document.getElementById('traHoSoModal'));
                modal.show();
            });

            // Nút Xác nhận trong modal Trả hồ sơ
            $(document).on('click', '#btnConfirmTraHoSo', function () {
                var lyDo = $('#txtLyDoTra').val().trim();

                // Validate
                if (!lyDo) {
                    $('#errLyDoTra').show();
                    $('#txtLyDoTra').focus();
                    return;
                }
                $('#errLyDoTra').hide();

                var $btn = $(this);
                $btn.prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i>Đang xử lý...');

                $.ajax({
                    url  : '@Url.Action("TraHoSo", "Budget")',
                    type : 'POST',
                    data : { budgetId: currentBudgetId, lyDoTra: lyDo },
                    success: function (res) {
                        if (res.success) {
                            // Đóng modal Trả hồ sơ
                            bootstrap.Modal.getInstance(
                                document.getElementById('traHoSoModal')).hide();

                            // Cập nhật trạng thái modal chi tiết
                            showModalAlert('success', res.message);
                            _currentWorkflowType = 4;
                            _updateModalButtons(4, _currentNgayDuyetBGD, _currentIsOwner);
                        } else {
                            showModalAlert('danger', res.message);
                            bootstrap.Modal.getInstance(
                                document.getElementById('traHoSoModal')).hide();
                        }
                    },
                    error: function () {
                        showModalAlert('danger', 'Lỗi kết nối.');
                        bootstrap.Modal.getInstance(
                            document.getElementById('traHoSoModal')).hide();
                    },
                    complete: function () {
                        $btn.prop('disabled', false)
                            .html('<i class="bi bi-arrow-return-left me-1"></i>Xác nhận trả hồ sơ');
                    }
                });
            });

            $('#budgetDetailsModal').on('hidden.bs.modal', function () {
                _isEditMode = false;
                _currentWorkflowType = null;
                _currentNgayDuyetBGD = null;
                _currentIsOwner = false;
                _snapshotPhieu = null;
                _setAllPhieuEditable(false);
                _setPhieuEditable(false);
                NhatKyTienDo.reset();
            });

            function _setPhieuEditable(editable) {
                // Danh sách đầy đủ các field user được phép chỉnh sửa
                var editableFields = [
                    '#modal_AreaName',
                    '#modal_TenHangMuc',
                    '#modal_DuToan',
                    '#modal_SoToTrinh',
                    '#modal_CategoryTypeId',
                    '#modal_PriorityLevelId',
                    '#modal_SoLuong',
                    '#modal_NgayBatDau',
                    '#modal_NgayKetThuc',
                    '#modal_LyDoDauTu',
                    '#modal_InvestmentReasonId',
                    '#modal_MoTaKyThuat',
                    '#modal_LinkTaiLieu'
                ];
                $.each(editableFields, function (_, sel) {
                    if (editable) {
                        $(sel).removeAttr('disabled');
                        $(sel).removeAttr('readonly'); // Bổ sung: Xóa thuộc tính readonly khi cho phép edit
                    } else {
                        $(sel).attr('disabled', 'disabled');
                        $(sel).attr('readonly', 'readonly'); // Bổ sung: Thêm thuộc tính readonly khi không cho edit
                    }
                });

                // Hiện/ẩn input file đính kèm
                if (editable) {
                    $('#revisionFileSection').show();
                } else {
                    $('#revisionFileSection').hide();
                }
            }

            // Auto-open modal nếu URL có ?openBudget=xxx
            (function () {
                var params = new URLSearchParams(window.location.search);
                var budgetId = params.get('openBudget');
                if (budgetId) {
                    // Tìm nút view của budgetId tương ứng và trigger click
                    var $btn = $('[data-budget-id="' + budgetId + '"].btn-view-modal');
                    if ($btn.length) {
                        $btn.trigger('click');
                    }
                    // Xóa query string khỏi URL để tránh mở lại khi F5
                    window.history.replaceState({}, '', '/Budget/Index');
                }
            })();

            // ── Biến lưu snapshot dữ liệu ban đầu ───────────────────────
            var _snapshotPhieu = null;
            var _isEditMode    = false;

            // ── Danh sách field tab Phiếu đăng ký ───────────────────────
            var _phieuFields = [
                '#modal_AreaName', '#modal_TenHangMuc', '#modal_DuToan',
                '#modal_SoToTrinh', '#modal_CategoryTypeId', '#modal_PriorityLevelId',
                '#modal_SoLuong', '#modal_NgayBatDau', '#modal_NgayKetThuc',
                '#modal_InvestmentReasonId', '#modal_LyDoDauTu', '#modal_MoTaKyThuat', '#modal_LinkTaiLieu'
            ];

            // Chụp snapshot giá trị hiện tại các field
            function _captureSnapshot() {
                var snap = {};
                $.each(_phieuFields, function (_, sel) {
                    snap[sel] = $(sel).val();
                });
                snap['#modal_ProjectAreaCustom'] = $('#modal_ProjectAreaCustom').val();
                snap['customAreaVisible']        = $('#modal_customAreaWrapper').is(':visible');
                return snap;
            }

            // Restore về snapshot
            function _restoreSnapshot(snap) {
                $.each(_phieuFields, function (_, sel) {
                    $(sel).val(snap[sel] || '');
                });
                $('#modal_ProjectAreaCustom').val(snap['#modal_ProjectAreaCustom'] || '');
                if (snap['customAreaVisible']) {
                    $('#modal_customAreaWrapper').show();
                } else {
                    $('#modal_customAreaWrapper').hide();
                }

                var selectedText = $('#modal_InvestmentReasonId').find('option:selected').text().trim();
                if (selectedText === "Điền thủ công") {
                    $('#modal_divLyDoNhapTay').show();
                } else {
                    $('#modal_divLyDoNhapTay').hide();
                }
            }

            // Bật/tắt toàn bộ field tab Phiếu đăng ký
            function _setAllPhieuEditable(editable) {
                $.each(_phieuFields, function (_, sel) {
                    if (editable) {
                        $(sel).removeAttr('disabled');
                        $(sel).removeAttr('readonly');
                    } else {
                        $(sel).attr('disabled', 'disabled');
                    }
                });
                if (editable) {
                    $('#lyDoChinhSuaSection').show();
                    $('#revisionFileSection').show();
                } else {
                    $('#lyDoChinhSuaSection').hide();
                    $('#revisionFileSection').hide();
                    $('#modal_LyDoChinhSua').val('');
                }
            }

            // Sự kiện click nút để mở Popup chọn cấu trúc cột Excel
            $(document).on('click', '#btnOpenExportModal', function () {
                $('#chk_SelectAllFields').prop('checked', true);
                $('.col-chk').prop('checked', true);

                var myModal = new bootstrap.Modal(document.getElementById('excelFieldsModal'));
                myModal.show();
            });

            // 1. Luồng xử lý khi click vào ô Checkbox "Chọn tất cả" tổng
            $(document).on('change', '#chk_SelectAllFields', function () {
                var isChecked = $(this).is(':checked');
                // Gán trạng thái của ô tổng cho tất cả các ô con có class .col-chk
                $('.col-chk').prop('checked', isChecked);
            });

            // 2. Luồng xử lý khi click vào từng ô con .col-chk đơn lẻ để đồng bộ ngược lại ô tổng
            $(document).on('change', '.col-chk', function () {
                var totalCheckboxes = $('.col-chk').length;
                var checkedCheckboxes = $('.col-chk:checked').length;

                // Nếu số lượng ô đang tích bằng tổng số lượng ô hiện có -> ô tổng tự động tích chọn
                if (checkedCheckboxes === totalCheckboxes) {
                    $('#chk_SelectAllFields').prop('checked', true);
                } else {
                    // Chỉ cần 1 ô con bị hủy -> ô tổng lập tức hủy chọn
                    $('#chk_SelectAllFields').prop('checked', false);
                }
            });

            // Sự kiện nhấn nút "Bắt đầu Tải về Excel" trong Modal
            $(document).on('click', '#btnExecuteExport', function () {
                var $btn = $(this);

                // Thu thập danh sách các field được chọn (mảng chuỗi)
                var selectedFields = [];
                $('.col-chk:checked').each(function () {
                    selectedFields.push($(this).val());
                });

                if (selectedFields.length === 0) {
                    alert('Vui lòng chọn ít nhất 1 trường thông tin để xuất Excel.');
                    return;
                }

                // Lấy các giá trị filter hiện có trên URL hoặc từ ô input/select của trang Index
                var search = $('#searchInput').val() || '';
                var sortOrder = $('#sortOrder').val() || '';
                var phongBanId = $('#phongBanId').val() || '';

                // SỬA LỖI TẠI ĐÂY: Kiểm tra nghiêm ngặt không dùng toán tử || để tránh mất số "0"
                var filterTrangThaiRaw = $('#filterTrangThai').val();
                var filterTrangThai = (filterTrangThaiRaw !== undefined && filterTrangThaiRaw !== null) ? filterTrangThaiRaw : '';

                // Tạo cấu trúc dữ liệu gửi đi dạng Query String ẩn
                var params = $.param({
                    search: search,
                    sortOrder: sortOrder,
                    phongBanId: phongBanId,
                    filterTrangThai: filterTrangThai, // Lúc này số 0 đã được giữ nguyên vẹn dưới dạng chuỗi "0"
                    fields: selectedFields
                }, true);

                // Thực hiện tải xuống không làm đứng trang
                window.location.href = '@Url.Action("ExportExcel", "Budget")?' + params;

                // Ẩn modal chọn cấu trúc cột
                bootstrap.Modal.getInstance(document.getElementById('excelFieldsModal')).hide();
            });

            $("#phongBanId").chosen({
                width: "100%"
            });

        });
    </script>
    <script>
        var NhatKyTienDo = (function ($) {
            'use strict';

            var workItemList = [];
            var currentBudgetId = 0;
            var _initializedId = null; // THÊM MỚI: lưu budgetId đã init

            function init(budgetId) {
                // THÊM MỚI: nếu đã init cho budgetId này rồi thì bỏ qua
                if (_initializedId === budgetId) {
                    return;
                }

                currentBudgetId = budgetId;
                _initializedId = budgetId; // đánh dấu đã init
                $('#nk-vung2').empty();

                $.get('/Budget/GetWorkItems', function (items) {
                    workItemList = items;

                    $.get('/Budget/GetProgressLog', { budgetId: budgetId }, function (data) {
                        if (data.exists) {
                            _loadFromServer(data);
                        } else {
                            $('#nk-vung2').append(_createKhuVuc());
                            _recalcTotal();
                        }
                    });
                });

                $('#btn-add-kv').off('click').on('click', function () {
                    $('#nk-vung2').append(_createKhuVuc());
                    _recalcTotal();
                });

                $('#btn-save-progress').off('click').on('click', _saveProgress);
            }

            function _loadFromServer(data) {
                $('#nk-danhgia').val(data.DanhGiaChung || '');
                $('#nk-luuy').val(data.LuuY || '');

                $.each(data.Areas, function (_, area) {
                    var $kv = _createKhuVuc();
                    var $tbody = $kv.find('tbody');
                    $kv.find('.kv-name-input').val(area.TenKhuVuc || '');
                    $tbody.empty();

                    $.each(area.Items, function (_, item) {
                        var $row = _createRow(item.TenHangMuc);
                        $row.find('.inp-dvt').val(item.DonViTinh || '');
                        $row.find('.inp-klkh').val(item.KLKeHoach || 0);
                        $row.find('.inp-kltt').val(item.KLThucTe || 0);
                        $row.find('.inp-date-bd').val(item.NgayBatDauKH || '');
                        $row.find('.inp-date-kt').val(item.NgayKetThucKH || '');
                        $row.find('.inp-ghichu').val(item.GhiChu || '');
                        _recalcRow($row);
                        $tbody.append($row);
                    });

                    _recalcKhuVuc($kv);

                    // THÊM MỚI: khởi tạo lock sau khi load
                    _refreshRowLocks($kv);

                    $('#nk-vung2').append($kv);
                });

                _recalcTotal();
            }

            function _createRow(tenHangMuc) {
                var $tr = $([
                    '<tr>',
                    '  <td class="col-hangmuc"></td>',
                    '  <td class="col-dvt"><input type="text" class="inp-dvt" placeholder="ĐVT"/></td>',
                    '  <td class="col-kl"><input type="number" class="inp-klkh" min="0" value="0"/></td>',
                    '  <td class="col-kl"><input type="number" class="inp-kltt" min="0" value="0"/></td>',
                    '  <td class="col-pct pct-cell"><span class="row-pct">0.0%</span></td>',
                    '  <td class="col-date"><input type="date" class="inp-date-bd"/></td>',
                    '  <td class="col-date"><input type="date" class="inp-date-kt"/></td>',
                    '  <td class="col-ghichu"><input type="text" class="inp-ghichu" placeholder="Ghi chú"/></td>',
                    '  <td class="col-action">',
                    '    <button class="btn-remove-row" type="button" title="Xóa dòng">',
                    '      <i class="bi bi-trash3"></i>',
                    '    </button>',
                    '  </td>',
                    '</tr>'
                ].join(''));

                var $inp = $('<input type="text" class="inp-hangmuc" placeholder="Tên hạng mục"/>')
                    .val(tenHangMuc || '');
                $tr.find('td.col-hangmuc').append($inp);

                // Recalc % khi KL thay đổi
                $tr.on('input', '.inp-klkh, .inp-kltt', function () {
                    _recalcRow($tr);
                    _recalcKhuVuc($tr.closest('.nk-kv-wrapper'));
                });

                // THÊM MỚI: xử lý min date cho Ngày KT
                $tr.on('change', '.inp-date-bd', function () {
                    var bdVal = $(this).val();
                    var $kt = $tr.find('.inp-date-kt');
                    if (bdVal) {
                        // Set min = Ngày bắt đầu
                        $kt.attr('min', bdVal);
                        // Nếu Ngày KT hiện tại < Ngày bắt đầu → xóa để tránh giá trị sai
                        if ($kt.val() && $kt.val() < bdVal) {
                            $kt.val('');
                        }
                    } else {
                        // Xóa Ngày bắt đầu → bỏ giới hạn, giữ nguyên giá trị Ngày KT
                        $kt.removeAttr('min');
                    }
                });

                // Xóa dòng
                $tr.on('click', '.btn-remove-row', function () {
                    var $kv = $tr.closest('.nk-kv-wrapper');
                    $tr.remove();
                    _recalcKhuVuc($kv);
                    // THÊM MỚI: cập nhật lock sau khi xóa dòng
                    _refreshRowLocks($kv);
                });

                return $tr;
            }

            function _createRowWithDropdown() {
                var $tr = _createRow('');
                var $cell = $tr.find('td.col-hangmuc').empty();
                var $wrap = $('<div class="d-flex gap-1"></div>');

                var $select = $('<select class="form-select form-select-sm inp-hangmuc-select"></select>');
                $select.append('<option value="">-- Chọn hạng mục --</option>');

                $.each(workItemList, function (_, w) {
                    $select.append(
                        // SỬA: w.workItemId → w.WorkItemId, w.name → w.Name
                        $('<option></option>').val(w.WorkItemId).text(w.Name)
                    );
                });

                $select.append('<option value="__manual__">✏️ Nhập tay...</option>');

                var $manual = $('<input type="text" class="inp-hangmuc inp-hangmuc-manual"'
                    + ' placeholder="Nhập tên hạng mục..." style="display:none"/>');

                $select.on('change', function () {
                    if ($(this).val() === '__manual__') {
                        $manual.show().focus();
                        $select.hide();
                    }
                });

                $wrap.append($select).append($manual);
                $cell.append($wrap);
                return $tr;
            }

            function _createKhuVuc() {
                var $wrapper = $('<div class="nk-kv-wrapper"></div>');

                var $header = $([
                    '<div class="nk-kv-header">',
