                    $tbody.append(_createRowWithDropdown());
                    _recalcKhuVuc($wrapper);
                });

                var $footer = $('<div class="nk-table-footer"></div>').append($btnAddRow);

                $wrapper
                    .append($header)
                    .append($('<div class="nk-kv-table-wrap"></div>').append($table))
                    .append($footer);

                return $wrapper;
            }

            function _recalcRow($tr) {
                var kh = parseFloat($tr.find('.inp-klkh').val()) || 0;
                var tt = parseFloat($tr.find('.inp-kltt').val()) || 0;
                var pct = kh === 0 ? 0 : Math.min((tt / kh) * 100, 100);
                $tr.find('.row-pct').text(pct.toFixed(1) + '%');

                // THÊM MỚI: cập nhật lock sau khi % thay đổi
                _refreshRowLocks($tr.closest('.nk-kv-wrapper'));
            }

            function _recalcKhuVuc($kv) {
                var $spans = $kv.find('.row-pct');
                var sum = 0;
                $spans.each(function () { sum += parseFloat($(this).text()) || 0; });
                var avg = $spans.length === 0 ? 0 : sum / $spans.length;
                $kv.find('.kv-pct-badge').text(avg.toFixed(1) + '%');
                _recalcTotal();
            }

            function _recalcTotal() {
                var $badges = $('#nk-vung2 .kv-pct-badge');
                var sum = 0;
                $badges.each(function () { sum += parseFloat($(this).text()) || 0; });
                var avg = $badges.length === 0 ? 0 : sum / $badges.length;
                $('#nk-total-pct').html(avg.toFixed(1) + '<span style="font-size:1rem">%</span>');
            }

