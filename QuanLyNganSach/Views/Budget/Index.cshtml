            function getFileIcon(extension) {
                if (!extension) return 'text';
                extension = extension.toLowerCase().replace('.', '');

                var icons = {
                    'pdf': 'pdf text-danger',
                    'doc': 'word text-primary',
                    'docx': 'word text-primary',
                    'xls': 'excel text-success',
                    'xlsx': 'excel text-success',
                    'ppt': 'ppt text-warning',
                    'pptx': 'ppt text-warning',
                    'jpg': 'image text-info',
                    'jpeg': 'image text-info',
                    'png': 'image text-info',
                    'gif': 'image text-info',
                    'zip': 'zip text-secondary',
                    'rar': 'zip text-secondary'
                };

                return icons[extension] || 'text';
            }

            // Dữ liệu dropdown dùng cho tab Phân nhiệm trong modal
            var dsPhongBan = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DsPhongBanModal));
            var dsChucNang = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DsChucNangModal));

            var currentBudgetId = 0;
            var modalRowIndex   = 0;

            // ── Mở modal khi click nút Xem ──────────────────────────────
            $(document).on('click', '.btn-view-modal', function () {
                currentBudgetId = $(this).data('budget-id');
                modalRowIndex   = 0;

                // Reset về trạng thái loading
                $('#modalLoading').show();
                $('#modalContent').hide();
                $('#detail-phieu-btn').tab('show');

                $('#budgetDetailsModal').modal('show');
                loadDetailsModal(currentBudgetId);
            });

            // ── Gọi API GetDetailsModal ──────────────────────────────────
            function loadDetailsModal(id) {
                $.ajax({
                    url: '@Url.Action("GetDetailsModal", "Budget")',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (!res.success) {
                            alert(res.message);
                            $('#budgetDetailsModal').modal('hide');
                            return;
                        }
                        bindModalData(res.data);
                        $('#modalLoading').hide();
                        $('#modalContent').show();
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi khi tải dữ liệu.');
                        $('#budgetDetailsModal').modal('hide');
                    }
                });
            }

            // ── Bind dữ liệu vào các field ──────────────────────────────
            function bindModalData(data) {

                // Header
                $('#modalMaHangMuc').text(data.MaHangMuc);

                // Tab Phiếu đăng ký
                $('#modal_AreaName').val(data.ProjectAreaId);
                $('#modal_TenPhongBan').val(data.TenPhongBan);
                $('#modal_MaHangMuc').val(data.MaHangMuc);
                $('#modal_TenHangMuc').val(data.TenHangMuc);
                $('#modal_DuToan').val(formatCurrency(data.DuToan));
                $('#modal_SoToTrinh').val(data.SoToTrinh);
                $('#modal_CategoryTypeName').val(data.CategoryTypeName);
                $('#modal_PriorityLevelName').val(data.PriorityLevelName);
                $('#modal_SoLuong').val(data.SoLuong);
                $('#modal_NgayBatDau').val(formatDate(data.NgayBatDau));
                $('#modal_NgayKetThuc').val(formatDate(data.NgayKetThuc));
                $('#modal_TenNguoiDangKy').val(data.TenNguoiDangKy);
                $('#modal_LyDoDauTu').val(data.LyDoDauTu);
                $('#modal_MoTaKyThuat').val(data.MoTaKyThuat);
                $('#modal_LinkTaiLieu').val(data.LinkTaiLieuLienQuan);

                // Attachments
                renderAttachments(data.Attachments);

                // Workflow dropdown
                if (data.IsManagerOrAdmin) {
                    $('#workflowSection').show();
                    $('#modal_WorkflowType').val(data.WorkflowType || '');
                    applyWorkflowTabs(data.WorkflowType);
                } else {
                    $('#workflowSection').hide();
                }

                // Tab Phân nhiệm
                renderModalPhanNhiem(data.DanhSachPhanNhiem || []);

                // *** THÊM MỚI — gọi bind tab Phê duyệt ***
                //bindPheDuyetData(data.ThongTinPheDuyet, data.IsManagerOrAdmin);
                bindPheDuyetData(data.NganSachGoc, data.IsManagerOrAdmin);
                renderDanhSachBoSung(data.DanhSachBoSung);
            }

            // ── Render Attachments ───────────────────────────────────────
            function renderAttachments(attachments) {
                var html = '';
                if (!attachments || attachments.length === 0) {
                    html = '<span class="text-muted small">Không có file đính kèm.</span>';
                } else {
                    $.each(attachments, function (i, a) {
                        html += '<div class="d-flex align-items-center gap-2 py-1 border-bottom">'
                            + '<i class="bi bi-file-earmark text-primary"></i>'
                            + '<a href="/' + a.FilePath + '" '
                            + 'download="' + a.FileName + '" '   // *** THÊM download ***
                            + 'class="text-truncate flex-fill">'
                            + a.FileName
                            + '</a>'
                            + '<span class="text-muted small">' + a.FileSizeFormatted + '</span>'
                            + '<span class="text-muted small">'
                            + formatDate(a.UploadedDate) + ' — ' + a.UploadedBy
                            + '</span>'
                            + '</div>';
                    });
                }
                $('#modal_AttachmentsList').html(html);
            }

            // ── Hiển thị/ẩn tab Phê duyệt & Nhật ký theo WorkflowType ──
            function applyWorkflowTabs(workflowType) {
                if (parseInt(workflowType) === 1) {
                    $('#tabPheDuyetItem').removeClass('d-none');
                    $('#tabNhatKyItem').removeClass('d-none');
                } else {
                    $('#tabPheDuyetItem').addClass('d-none');
                    $('#tabNhatKyItem').addClass('d-none');
                    // Nếu đang ở tab bị ẩn thì quay về tab Phiếu
                    if ($('#detail-pheduyet').hasClass('active') ||
                        $('#detail-nhatky').hasClass('active')) {
                        $('#detail-phieu-btn').tab('show');
                    }
                }
            }

            // ── Lắng nghe thay đổi WorkflowType ─────────────────────────
            $(document).on('change', '#modal_WorkflowType', function () {
                applyWorkflowTabs($(this).val());
            });

            // ── Render tab Phân nhiệm từ dữ liệu có sẵn ─────────────────
            function renderModalPhanNhiem(list) {
                $('#modalPhanNhiemBody').empty();
                modalRowIndex = 0;
                $.each(list, function (i, pn) {
                    var row = taoHtmlDongModal(modalRowIndex++);
                    var $row = $(row);

                    // Set giá trị dropdown Phòng ban
                    $row.find('select[name*=PhongBanId]').val(pn.PhongBanId);

                    // Set dropdown Chức năng (nếu có Id)
                    if (pn.ChucNangNhiemVuId) {
                        $row.find('.ddModalChucNang').val(pn.ChucNangNhiemVuId);
                    }
                    // Set textbox nhập tay
                    $row.find('.txtModalChucNangTay').val(pn.TenChucNangNhapTay || '');

                    $row.find('input[name*=Email]').val(pn.Email || '');
                    $row.find('input[name*=GhiChu]').val(pn.GhiChu || '');

                    $('#modalPhanNhiemBody').append($row);
                });
                capNhatSTTModal();
            }

            // ── Tạo HTML 1 dòng Phân nhiệm trong modal ──────────────────
            function taoHtmlDongModal(idx) {
                var optionsPhongBan = '<option value="">-- Chọn --</option>';
                $.each(dsPhongBan, function (i, pb) {
                    optionsPhongBan += '<option value="' + pb.value + '">'
                                     + pb.text + '</option>';
                });

                var optionsChucNang = '<option value="">-- Chọn hoặc nhập tay --</option>';
                $.each(dsChucNang, function (i, cn) {
                    optionsChucNang += '<option value="' + cn.value + '">'
                                     + cn.text + '</option>';
                });

                return '<tr data-index="' + idx + '">'
                    + '<td class="text-center stt-modal"></td>'
                    + '<td>'
                    + '<select name="DanhSachPhanNhiem[' + idx + '].PhongBanId" '
                    +         'class="form-select form-select-sm" required>'
                    + optionsPhongBan + '</select>'
                    + '</td>'
                    + '<td>'
                    + '<select name="DanhSachPhanNhiem[' + idx + '].ChucNangNhiemVuId" '
                    +         'class="form-select form-select-sm mb-1 ddModalChucNang">'
                    + optionsChucNang + '</select>'
                    + '<input type="text" '
                    +        'name="DanhSachPhanNhiem[' + idx + '].TenChucNangNhapTay" '
                    +        'class="form-control form-control-sm txtModalChucNangTay" '
                    +        'placeholder="Hoặc nhập tay tại đây..." />'
                    + '</td>'
                    + '<td>'
                    + '<input type="email" '
                    +        'name="DanhSachPhanNhiem[' + idx + '].Email" '
                    +        'class="form-control form-control-sm" '
                    +        'placeholder="email@example.com" />'
                    + '</td>'
                    + '<td>'
                    + '<input type="text" '
                    +        'name="DanhSachPhanNhiem[' + idx + '].GhiChu" '
                    +        'class="form-control form-control-sm" '
                    +        'placeholder="Ghi chú..." />'
                    + '</td>'
                    + '<td class="text-center">'
                    + '<button type="button" class="btn btn-danger btn-sm btnModalXoaDong">'
                    + '<i class="bi bi-trash"></i></button>'
                    + '</td>'
                    + '</tr>';
            }

            // ── Cập nhật STT + badge đếm dòng modal ─────────────────────
            function capNhatSTTModal() {
                var rows = $('#modalPhanNhiemBody tr');
                rows.each(function (i) {
                    $(this).find('.stt-modal').text(i + 1);
                });
                var count = rows.length;
                $('#modalPhanNhiemCount').text(count)
                    .toggleClass('bg-secondary', count === 0)
                    .toggleClass('bg-primary',   count > 0);
            }

            // ── Thêm dòng Phân nhiệm trong modal ────────────────────────
            $(document).on('click', '#btnModalThemDong', function () {
                $('#modalPhanNhiemBody').append(taoHtmlDongModal(modalRowIndex++));
                capNhatSTTModal();
            });

            // ── Xóa dòng Phân nhiệm trong modal ─────────────────────────
            $(document).on('click', '.btnModalXoaDong', function () {
                $(this).closest('tr').remove();
                capNhatSTTModal();
            });

            // ── Nút Lưu thông tin ────────────────────────────────────────
            $(document).on('click', '#btnSaveDetailsModal', function () {
                var $btn = $(this);

                // Thu thập dữ liệu Phân nhiệm từ các dòng trong bảng
                var danhSachPhanNhiem = [];
                $('#modalPhanNhiemBody tr').each(function () {
                    var $row    = $(this);
                    var idx     = $row.data('index');
                    var phongBanId = $row.find('select[name*=PhongBanId]').val();
                    if (!phongBanId) return; // bỏ dòng chưa chọn phòng ban

                    danhSachPhanNhiem.push({
                        PhongBanId:         phongBanId,
                        ChucNangNhiemVuId:  $row.find('.ddModalChucNang').val() || null,
                        TenChucNangNhapTay: $row.find('.txtModalChucNangTay').val() || null,
                        Email:              $row.find('input[name*=Email]').val() || null,
                        GhiChu:             $row.find('input[name*=GhiChu]').val() || null
                    });
                });

                var payload = {
                    BudgetRegistrationId: currentBudgetId,
                    WorkflowType:         $('#modal_WorkflowType').val() || null,
                    DanhSachPhanNhiem: danhSachPhanNhiem,
                    // *** THÊM MỚI ***
                    //ThongTinPheDuyet: {
                    //    BudgetRegistrationId: currentBudgetId,
                    //    ProcessType: parseInt($('#pd_ProcessType').val()) || 1,
                    //    NgayDuyetPDA: $('#pd_NgayDuyetPDA').val() || null,
                    //    NgayDuyetPKT: $('#pd_NgayDuyetPKT').val() || null,
                    //    NgayDuyetERPD: $('#pd_NgayDuyetERPD').val() || null,
                    //    NgayDuyetBTC: $('#pd_NgayDuyetBTC').val() || null,
                    //    NgayDuyetBGD: $('#pd_NgayDuyetBGD').val() || null,
                    //    // *** THAY ĐỔI: lấy giá trị từ input thay vì hardcode 0 ***
                    //    // Thay đoạn DuToanPheDuyet trong payload
                    //    DuToanPheDuyet: (function () {
                    //        if ($('#pd_DuToanPheDuyet').prop('disabled')) return null;
                    //        var raw = $('#pd_DuToanPheDuyet').val()
                    //            .replace(/,/g, '')  // bỏ dấu phẩy en-US
                    //            .replace(/\./g, ''); // bỏ dấu chấm (nếu có)
                    //        return raw ? parseFloat(raw) : null;
                    //    })(),
                    //    SoThongBao: $('#pd_SoThongBao').val() || null,
                    //    SoFMIO: $('#pd_SoFMIO').val() || null
                    //}
                    // Thay toàn bộ phần ThongTinPheDuyet cũ trong payload

                    // Ngân sách gốc
                    NganSachGoc: {
                        BudgetRegistrationId: currentBudgetId,
                        ProcessType: parseInt($('#pd_ProcessType').val()) || 1,
                        NgayDuyetPDA: $('#pd_NgayDuyetPDA').val() || null,
                        NgayDuyetPKT: $('#pd_NgayDuyetPKT').val() || null,
                        NgayDuyetERPD: $('#pd_NgayDuyetERPD').val() || null,
                        NgayDuyetBTC: $('#pd_NgayDuyetBTC').val() || null,
                        NgayDuyetBGD: $('#pd_NgayDuyetBGD').val() || null,
                        DuToanPheDuyet: (function () {
                            if ($('#pd_DuToanPheDuyet').prop('disabled')) return null;
                            var raw = $('#pd_DuToanPheDuyet').val()
                                .replace(/,/g, '').replace(/\./g, '');
                            return raw ? parseFloat(raw) : null;
                        })(),
                        SoThongBao: $('#pd_SoThongBao').val() || null,
                        SoFMIO: $('#pd_SoFMIO').val() || null,
                        IsSupplementary: false,
                        SupplementaryOrder: 0
                    },

                    // Danh sách đợt bổ sung
                    DanhSachBoSung: (function () {
                        var list = [];
                        $('#containerBoSung .card-bo-sung').each(function () {
                            var $card = $(this);
                            var idx = $card.data('index');
                            var rawNS = $('#bs_NganSach_' + idx).val()
                                .replace(/,/g, '').replace(/\./g, '');
                            list.push({
                                BudgetRegistrationId: currentBudgetId,
                                ProcessType: parseInt($card.find('.bs-ProcessType').val()) || 1,
                                NgayDuyetPDA: $('#bs_PDA_' + idx).val() || null,
                                NgayDuyetPKT: $('#bs_PKT_' + idx).val() || null,
                                NgayDuyetERPD: $('#bs_ERPD_' + idx).val() || null,
                                NgayDuyetBTC: $('#bs_BTC_' + idx).val() || null,
                                NgayDuyetBGD: $('#bs_BGD_' + idx).val() || null,
                                LyDoBoSung: $('#bs_LyDo_' + idx).val() || null,
                                NganSachBoSung: rawNS ? parseFloat(rawNS) : 0,
                                IsSupplementary: true
                            });
                        });
                        return list;
                    })()
                };

                $btn.prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i> Đang lưu...');

                $.ajax({
                    url:         '@Url.Action("SaveDetailsModal", "Budget")',
                    type:        'POST',
                    contentType: 'application/json',
                    data:        JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            // Hiện thông báo thành công ngay trong modal
                            showModalAlert('success', res.message);
                        } else {
                            showModalAlert('danger', res.message);
                        }
                    },
                    error: function () {
                        showModalAlert('danger', 'Đã xảy ra lỗi khi lưu thông tin.');
                    },
                    complete: function () {
                        $btn.prop('disabled', false)
                            .html('<i class="bi bi-save me-1"></i> Lưu thông tin');
                    }
                });
            });

            // ── Helper: hiện alert trong modal ──────────────────────────
            function showModalAlert(type, message) {
                var html = '<div class="alert alert-' + type + ' alert-dismissible '
                         + 'fade show mt-3" role="alert">'
                         + '<i class="bi bi-' + (type === 'success'
                             ? 'check-circle-fill' : 'exclamation-triangle-fill')
                         + ' me-2"></i>' + message
                         + '<button type="button" class="btn-close" '
                         +          'data-bs-dismiss="alert"></button>'
                         + '</div>';
                // Chèn alert vào đầu modal-body
                $('#modalContent').prepend(html);
                setTimeout(function () {
                    $('#modalContent .alert').fadeOut('slow', function () {
                        $(this).remove();
                    });
                }, 4000);
            }

            // ── Helper: format ngày từ JSON date .NET ───────────────────
            function formatDate(jsonDate) {
                if (!jsonDate) return '';
                var ms = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'));
                var d  = new Date(ms);
                return ('0' + d.getDate()).slice(-2) + '/'
                     + ('0' + (d.getMonth() + 1)).slice(-2) + '/'
                     + d.getFullYear();
            }

            // ── Helper: format số tiền ───────────────────────────────────
            function formatCurrency(value) {
                if (!value) return '0';
                return Number(value).toLocaleString('en-US');
            }

            window.bindPheDuyetData = function (pd, isManagerOrAdmin) {
                if (!pd) pd = { ProcessType: 1, TrangThaiPheDuyet: 0 };

                // Dropdown Khởi tạo quy trình
                if (isManagerOrAdmin) {
                    $('#processTypeSection').show();
                } else {
                    $('#processTypeSection').hide();
                }
                $('#pd_ProcessType').val(pd.ProcessType || 1);
                applyProcessType(pd.ProcessType || 1);

                // Mốc ngày
                $('#pd_NgayDuyetPDA').val(toDateInputValue(pd.NgayDuyetPDA));
                $('#pd_NgayDuyetPKT').val(toDateInputValue(pd.NgayDuyetPKT));
                $('#pd_NgayDuyetERPD').val(toDateInputValue(pd.NgayDuyetERPD));
                $('#pd_NgayDuyetBTC').val(toDateInputValue(pd.NgayDuyetBTC));
                $('#pd_NgayDuyetBGD').val(toDateInputValue(pd.NgayDuyetBGD));

                // Dự toán
                $('#pd_DuToanGoc').val(pd.DuToanGoc
                    ? Number(pd.DuToanGoc).toLocaleString('en-US') : '');
                $('#pd_DuToanPheDuyet').val(pd.DuToanPheDuyet || '');

                // Textbox
                $('#pd_SoThongBao').val(pd.SoThongBao || '');
                $('#pd_SoFMIO').val(pd.SoFMIO || '');

                // Trạng thái
                applyTrangThaiPheDuyet(pd.TrangThaiPheDuyet || 0, isManagerOrAdmin);

                // Cập nhật disable/enable mốc ngày
                updateMocNgayState();
            };

            // ── Hiển thị/ẩn ERPD, BTC theo ProcessType ──────────────────
            function applyProcessType(processType) {
                if (parseInt(processType) === 1) {
                    $('.moc-tapDoan').show();
                } else {
                    $('.moc-tapDoan').hide();
                    $('#pd_NgayDuyetERPD').val('');
                    $('#pd_NgayDuyetBTC').val('');
                }
                updateMocNgayState();
            }

            $(document).on('change', '#pd_ProcessType', function () {
                applyProcessType($(this).val());
            });

            // ── Enable/disable mốc ngày theo tuần tự ────────────────────
            function updateMocNgayState() {
                var processType = parseInt($('#pd_ProcessType').val()) || 1;

                var pdaVal = $('#pd_NgayDuyetPDA').val();
                var pktVal = $('#pd_NgayDuyetPKT').val();
                var erpdVal = $('#pd_NgayDuyetERPD').val();
                var btcVal = $('#pd_NgayDuyetBTC').val();
                var bgdVal = $('#pd_NgayDuyetBGD').val();

                // Enable/disable theo tuần tự
                toggleMocNgay('#pd_NgayDuyetPKT', !!pdaVal);

                if (processType === 1) {
                    toggleMocNgay('#pd_NgayDuyetERPD', !!pktVal);
                    toggleMocNgay('#pd_NgayDuyetBTC', !!erpdVal);
                    toggleMocNgay('#pd_NgayDuyetBGD', !!btcVal);
                } else {
                    toggleMocNgay('#pd_NgayDuyetBGD', !!pktVal);
                }

                // *** THÊM MỚI: Tính trạng thái realtime theo logic mới ***
                var isManagerOrAdmin = !!$('#processTypeSection').is(':visible');
                var trangThai;
                if (!!bgdVal) {
                    trangThai = 2;
                } else if (!!pdaVal || !!pktVal || !!erpdVal || !!btcVal) {
                    trangThai = 1;
                } else {
                    trangThai = 0;
                }
                applyTrangThaiPheDuyet(trangThai, isManagerOrAdmin);
            }

            function toggleMocNgay(selector, enabled) {
                var $el = $(selector);
                if (enabled) {
                    $el.prop('disabled', false).removeClass('bg-light');
                } else {
                    $el.prop('disabled', true).addClass('bg-light').val('');
                }
            }

            // Lắng nghe thay đổi trên tất cả mốc ngày
            $(document).on('change', '.moc-ngay', function () {
                updateMocNgayState();
            });

            // ── Hiển thị badge trạng thái + disable button ───────────────
            function applyTrangThaiPheDuyet(trangThai, isManagerOrAdmin) {
                var $badge = $('#badgeTrangThaiPheDuyet');
                var $duToanInput = $('#pd_DuToanPheDuyet');

                switch (trangThai) {
                    case 0: // Chờ trình
                        $badge.text('Chờ trình')
                            .removeClass('bg-success bg-warning text-dark')
                            .addClass('bg-secondary');
                        $duToanInput.val('')
                            .prop('disabled', true)
                            .attr('placeholder', 'Chưa có duyệt từ BGĐ');
                        break;

                    case 1: // Đang trình
                        var duToanGoc = $('#pd_DuToanGoc').val();

                        // Format số (nếu cần)
                        var formatted = duToanGoc
                            ? Number(duToanGoc.replace(/[^\d]/g, '')).toLocaleString('vi-VN') + ' VND'
                            : '';
                        $badge.text('Đang trình' + (formatted ? ' ' + formatted : ''))
                            .removeClass('bg-success bg-secondary')
                            .addClass('bg-warning text-dark');
                        $duToanInput.val('')
                            .prop('disabled', true)
                            .attr('placeholder', 'Chưa có duyệt từ BGĐ');
                        break;

                    case 2: // Đã phê duyệt
                        $badge.text('Đã phê duyệt')
                            .removeClass('bg-warning bg-secondary text-dark')
                            .addClass('bg-success');

                        // Đọc DuToanGoc (đang format vi-VN dấu chấm), strip về số thuần
                        var duToanGocRaw = $('#pd_DuToanGoc').val()
                            .replace(/\./g, '')   // bỏ dấu chấm vi-VN
                            .replace(/,/g, '');   // bỏ dấu phẩy (nếu có)
                        var duToanGocNum = parseFloat(duToanGocRaw) || 0;

                        // Hiển thị format dấu phẩy (en-US: 12,000,000,000)
                        $('#pd_DuToanPheDuyet')
                            .val(duToanGocNum.toLocaleString('en-US'))
                            .prop('disabled', !isManagerOrAdmin)
                            .attr('placeholder', 'Nhập dự toán phê duyệt');
                        break;
                }
            }

            // ── Helper: convert JSON Date sang yyyy-MM-dd cho input date ─
            function toDateInputValue(jsonDate) {
                if (!jsonDate) return '';
                var ms = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'));
                if (isNaN(ms)) return '';
                var d = new Date(ms);
                return d.getFullYear() + '-'
                     + ('0' + (d.getMonth() + 1)).slice(-2) + '-'
                     + ('0' + d.getDate()).slice(-2);
            }

            var boSungIndex = 0; // index cho name binding

            // ── Template HTML cho 1 card bổ sung ────────────────────────
            function taoCardBoSung(idx, order, data) {
                data = data || {};
                var processType = data.ProcessType || 1;

                return '<div class="card border-success mb-3 card-bo-sung" '
                    + 'data-index="' + idx + '">'

                    // Header card
                    + '<div class="card-header bg-success text-white d-flex '
                    + 'justify-content-between align-items-center py-2">'
                    + '<span class="fw-semibold">'
                    + '<i class="bi bi-plus-circle me-1"></i>'
                    + '<span class="ten-dot">Đợt bổ sung lần ' + order + '</span>'
                    + '</span>'
                    + '<div class="d-flex align-items-center gap-2">'

                    // Dropdown Khởi tạo quy trình
                    + '<select class="form-select form-select-sm w-auto bs-ProcessType" '
                    + 'style="min-width:180px;" '
                    + 'data-index="' + idx + '">'
                    + '<option value="1"'
                    + (processType == 1 ? ' selected' : '') + '>'
                    + 'Theo QT Tập đoàn</option>'
                    + '<option value="2"'
                    + (processType == 2 ? ' selected' : '') + '>'
                    + 'Theo QT Công ty</option>'
                    + '</select>'

                    // Nút xóa
                    + '<button type="button" '
                    + 'class="btn btn-danger btn-sm btn-xoa-bo-sung" '
                    + 'data-index="' + idx + '">'
                    + '<i class="bi bi-trash"></i>'
                    + '</button>'
                    + '</div>'
                    + '</div>'

                    // Body card
                    + '<div class="card-body">'

                    // Tiến độ duyệt
                    + '<h6 class="fw-semibold text-muted mb-3">'
                    + '<i class="bi bi-calendar-check me-1"></i>Tiến độ duyệt</h6>'
                    + '<div class="row g-3 mb-4 bs-tien-do-row">'

                    // PDA
                    + '<div class="col-md-2 col-sm-4">'
                    + '<label class="form-label small fw-semibold">PDA</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_PDA_' + idx + '" data-index="' + idx + '" data-moc="PDA" '
                    + 'value="' + (data.NgayDuyetPDA
                        ? toDateInputValue(data.NgayDuyetPDA) : '') + '" />'
                    + '</div>'

                    // PKT
                    + '<div class="col-md-2 col-sm-4">'
                    + '<label class="form-label small fw-semibold">PKT</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_PKT_' + idx + '" data-index="' + idx + '" data-moc="PKT" '
                    + 'value="' + (data.NgayDuyetPKT
                        ? toDateInputValue(data.NgayDuyetPKT) : '') + '" disabled />'
                    + '</div>'

                    // ERPD
                    + '<div class="col-md-2 col-sm-4 bs-moc-tapDoan-' + idx + '" '
                    + 'style="display:' + (processType == 1 ? 'block' : 'none') + ';">'
                    + '<label class="form-label small fw-semibold">ERPD</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_ERPD_' + idx + '" data-index="' + idx + '" data-moc="ERPD" '
                    + 'value="' + (data.NgayDuyetERPD
                        ? toDateInputValue(data.NgayDuyetERPD) : '') + '" disabled />'
                    + '</div>'

                    // BTC
                    + '<div class="col-md-2 col-sm-4 bs-moc-tapDoan-' + idx + '" '
                    + 'style="display:' + (processType == 1 ? 'block' : 'none') + ';">'
                    + '<label class="form-label small fw-semibold">BTC</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_BTC_' + idx + '" data-index="' + idx + '" data-moc="BTC" '
                    + 'value="' + (data.NgayDuyetBTC
                        ? toDateInputValue(data.NgayDuyetBTC) : '') + '" disabled />'
                    + '</div>'

                    // BGĐ
                    + '<div class="col-md-2 col-sm-4">'
                    + '<label class="form-label small fw-semibold">BGĐ</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_BGD_' + idx + '" data-index="' + idx + '" data-moc="BGD" '
                    + 'value="' + (data.NgayDuyetBGD
                        ? toDateInputValue(data.NgayDuyetBGD) : '') + '" disabled />'
                    + '</div>'

                    + '</div>' // end row tiến độ

                    // Lý do bổ sung + Ngân sách bổ sung
                    + '<div class="row g-3 mb-3">'
                    + '<div class="col-md-6">'
                    + '<label class="form-label small fw-semibold">Lý do bổ sung</label>'
                    + '<input type="text" class="form-control form-control-sm" '
                    + 'id="bs_LyDo_' + idx + '" '
                    + 'placeholder="Nhập lý do bổ sung..." '
                    + 'value="' + (data.LyDoBoSung || '') + '" />'
                    + '</div>'
                    + '<div class="col-md-3">'
                    + '<label class="form-label small fw-semibold">Ngân sách bổ sung</label>'
                    + '<input type="text" class="form-control form-control-sm bs-ngan-sach" '
                    + 'id="bs_NganSach_' + idx + '" '
                    + 'placeholder="0" '
                    + 'value="' + formatCurrencyBS(data.NganSachBoSung || 0) + '" />'
                    + '</div>'
                    + '<div class="col-md-3 d-flex align-items-end">'
                    + '<span class="badge fs-6 p-2 bs-badge-trang-thai" '
                    + 'id="bs_Badge_' + idx + '"></span>'
                    + '</div>'
                    + '</div>'

                    + '</div>' // end card-body
                    + '</div>'; // end card
            }

            // ── Thêm card bổ sung mới ────────────────────────────────────
            $(document).on('click', '#btnThemBoSung', function () {
                var order = $('#containerBoSung .card-bo-sung').length + 1;
                var html = taoCardBoSung(boSungIndex, order, {});
                $('#containerBoSung').append(html);
                capNhatMocNgayBoSung(boSungIndex);
                capNhatBadgeBoSung(boSungIndex);
                boSungIndex++;
            });

            // ── Xóa card bổ sung + đánh lại số thứ tự ───────────────────
            $(document).on('click', '.btn-xoa-bo-sung', function () {
                $(this).closest('.card-bo-sung').remove();
                // Đánh lại số thứ tự hiển thị
                $('#containerBoSung .card-bo-sung').each(function (i) {
                    $(this).find('.ten-dot').text('Đợt bổ sung lần ' + (i + 1));
                });
            });

            // ── Thay đổi ProcessType của từng card bổ sung ───────────────
            $(document).on('change', '.bs-ProcessType', function () {
                var idx = $(this).data('index');
                var processType = parseInt($(this).val());
                if (processType === 1) {
                    $('.bs-moc-tapDoan-' + idx).show();
                } else {
                    $('.bs-moc-tapDoan-' + idx).hide();
                    $('#bs_ERPD_' + idx).val('');
                    $('#bs_BTC_' + idx).val('');
                }
                capNhatMocNgayBoSung(idx);
                capNhatBadgeBoSung(idx);
            });

            // ── Enable/disable mốc ngày tuần tự cho từng card ────────────
            function capNhatMocNgayBoSung(idx) {
                var processType = parseInt(
                    $('#containerBoSung .card-bo-sung[data-index="' + idx + '"] '
                        + '.bs-ProcessType').val()) || 1;

                var pdaVal = $('#bs_PDA_' + idx).val();
                var pktVal = $('#bs_PKT_' + idx).val();
                var erpdVal = $('#bs_ERPD_' + idx).val();
                var btcVal = $('#bs_BTC_' + idx).val();

                toggleBSMocNgay('#bs_PKT_' + idx, !!pdaVal);

                if (processType === 1) {
                    toggleBSMocNgay('#bs_ERPD_' + idx, !!pktVal);
                    toggleBSMocNgay('#bs_BTC_' + idx, !!erpdVal);
                    toggleBSMocNgay('#bs_BGD_' + idx, !!btcVal);
                } else {
                    toggleBSMocNgay('#bs_BGD_' + idx, !!pktVal);
                }

                capNhatBadgeBoSung(idx);
            }

            function toggleBSMocNgay(selector, enabled) {
                var $el = $(selector);
                if (enabled) {
                    $el.prop('disabled', false).removeClass('bg-light');
                } else {
                    $el.prop('disabled', true).addClass('bg-light').val('');
                }
            }

            // ── Cập nhật badge trạng thái cho từng card ──────────────────
            function capNhatBadgeBoSung(idx) {
                var bgdVal = $('#bs_BGD_' + idx).val();
                var pdaVal = $('#bs_PDA_' + idx).val();
                var pktVal = $('#bs_PKT_' + idx).val();
                var erpdVal = $('#bs_ERPD_' + idx).val();
                var btcVal = $('#bs_BTC_' + idx).val();

                var $badge = $('#bs_Badge_' + idx);
                if (!!bgdVal) {
                    $badge.text('Đã phê duyệt')
                        .removeClass('bg-secondary bg-warning text-dark')
                        .addClass('bg-success');
                } else if (!!pdaVal || !!pktVal || !!erpdVal || !!btcVal) {
                    $badge.text('Đang trình')
                        .removeClass('bg-success bg-secondary')
                        .addClass('bg-warning text-dark');
                } else {
                    $badge.text('Chờ trình')
                        .removeClass('bg-success bg-warning text-dark')
                        .addClass('bg-secondary');
                }
            }

            // ── Lắng nghe thay đổi mốc ngày trên card bổ sung ───────────
            $(document).on('change', '.bs-moc-ngay', function () {
                var idx = $(this).data('index');
                capNhatMocNgayBoSung(idx);
            });

            // ── Render danh sách bổ sung khi load modal ──────────────────
            window.renderDanhSachBoSung = function (danhSachBoSung) {
                $('#containerBoSung').empty();
                boSungIndex = 0;
                if (!danhSachBoSung || danhSachBoSung.length === 0) return;

                $.each(danhSachBoSung, function (i, item) {
                    var html = taoCardBoSung(boSungIndex, i + 1, item);
                    $('#containerBoSung').append(html);
                    capNhatMocNgayBoSung(boSungIndex);
                    capNhatBadgeBoSung(boSungIndex);
                    boSungIndex++;
                });
            };

            // ── Helper: format số tiền cho card bổ sung ──────────────────
            window.formatCurrencyBS = function (value) {
                if (!value && value !== 0) return '0';
                return Number(value).toLocaleString('en-US');
            };

            // ── Helper: convert JSON Date (dùng lại từ scope ngoài) ──────
            function toDateInputValue(jsonDate) {
                if (!jsonDate) return '';
                var ms = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'));
                if (isNaN(ms)) return '';
                var d = new Date(ms);
                return d.getFullYear() + '-'
                    + ('0' + (d.getMonth() + 1)).slice(-2) + '-'
                    + ('0' + d.getDate()).slice(-2);
            }


        });
    </script>
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .table thead th {
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
