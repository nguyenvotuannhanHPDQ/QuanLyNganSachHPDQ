            // ── Enable/disable mốc ngày theo tuần tự ────────────────────
            function updateMocNgayState() {
                var processType = parseInt($('#pd_ProcessType').val()) || 1;

                var pdaVal = $('#pd_NgayDuyetPDA').val();
                var pktVal = $('#pd_NgayDuyetPKT').val();
                var erpdVal = $('#pd_NgayDuyetERPD').val();
                var btcVal = $('#pd_NgayDuyetBTC').val();
                var bgdVal = $('#pd_NgayDuyetBGD').val();

                // Enable/disable theo tuần tự
                toggleMocNgay('#pd_NgayDuyetPKT', !!pdaVal);

                if (processType === 1) {
                    toggleMocNgay('#pd_NgayDuyetERPD', !!pktVal);
                    toggleMocNgay('#pd_NgayDuyetBTC', !!erpdVal);
                    toggleMocNgay('#pd_NgayDuyetBGD', !!btcVal);
                } else {
                    toggleMocNgay('#pd_NgayDuyetBGD', !!pktVal);
                }

                // *** THÊM MỚI: Tính trạng thái realtime theo logic mới ***
                var isManagerOrAdmin = !!$('#processTypeSection').is(':visible');
                var trangThai;
                if (!!bgdVal) {
                    trangThai = 2;
                } else if (!!pdaVal || !!pktVal || !!erpdVal || !!btcVal) {
                    trangThai = 1;
                } else {
                    trangThai = 0;
                }
                applyTrangThaiPheDuyet(trangThai, isManagerOrAdmin);

                capNhatCardTongHop(); // *** THÊM MỚI ***
            }

