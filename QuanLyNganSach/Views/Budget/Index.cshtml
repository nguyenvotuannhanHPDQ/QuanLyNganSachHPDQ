@section Scripts {
    <script>
        $(document).ready(function () {

            // Khai báo ở đầu section Scripts
            var currentUserIdGlobal = @(ViewBag.CurrentUserId ?? 0);

            var isPhanNhiemSearchMode = false;

            // Thêm vào đầu $(document).ready() — khai báo biến state
            var _currentWorkflowType = null;
            var _currentNgayDuyetBGD = null;
            var _currentIsOwner = false;

            // Format khi nhập
            $('#DuToan_Display').on('input', function () {
                var raw = $(this).val().replace(/,/g, '');
                var num = parseFloat(raw) || 0;

                // Cập nhật hidden field (số thuần)
                $hidden.val(num > 0 ? num : '');

                // Format hiển thị
                if (raw === '' || raw === '0') {
                    $(this).val('');
                    return;
                }
                var formatted = num.toLocaleString('en-US');
                $(this).val(formatted);
            });

            $('#modal_InvestmentReasonId').change(function () {
                var selectedText = $(this).find('option:selected').text().trim();
                var $divNhapTay = $('#modal_divLyDoNhapTay');
                var $txtNhapTay = $('#modal_LyDoDauTu');

                if (selectedText === "Điền thủ công") {
                    $divNhapTay.slideDown(200);
                } else {
                    $divNhapTay.slideUp(200);
                    $txtNhapTay.val(''); // Xóa text nhập tay nếu chuyển sang chọn lý do mẫu
                }
            });

            // Search on input with debounce
            var searchTimeout;
            $('#searchInput').on('keyup', function (e) {
                // Don't submit on Enter key here (handled separately)
                if (e.which === 13) {
                    return;
                }

                clearTimeout(searchTimeout);
                var searchValue = $(this).val(); // Capture value

                searchTimeout = setTimeout(function () {
                    // Ensure value is set before submit
                    $('#searchInput').val(searchValue);
                    $('#searchForm').submit();
                }, 500); // Wait 500ms after user stops typing
            });

            // Filter by status - submit form immediately
            $('input[name="status"]').on('change', function () {
                $('#searchForm').submit();
            });

            // Auto-submit when department filter changes (for Manager/Admin)
            $('#phongBanId, #filterTienDo, #filterTrangThai').on('change', function () {
                $('#searchForm').submit();
            });

            // Clear search button
            $('#clearSearch').on('click', function () {
                $('#searchInput').val('');
                $('#searchForm').submit();
            });

            // Handle Enter key explicitly
            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    clearTimeout(searchTimeout); // Cancel debounce
                    $('#searchForm').submit();
                }
            });

            // Auto-submit when sort order changes
            $('#sortOrder').on('change', function () {
                var sortValue = $(this).val();
                var currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('sortOrder', sortValue);
                currentUrl.searchParams.delete('page'); // Reset về trang 1
                window.location.href = currentUrl.toString();
            });

            function getFileIcon(extension) {
                if (!extension) return 'text';
                extension = extension.toLowerCase().replace('.', '');

                var icons = {
                    'pdf': 'pdf text-danger',
                    'doc': 'word text-primary',
                    'docx': 'word text-primary',
                    'xls': 'excel text-success',
                    'xlsx': 'excel text-success',
                    'ppt': 'ppt text-warning',
                    'pptx': 'ppt text-warning',
                    'jpg': 'image text-info',
                    'jpeg': 'image text-info',
                    'png': 'image text-info',
                    'gif': 'image text-info',
                    'zip': 'zip text-secondary',
                    'rar': 'zip text-secondary'
                };

                return icons[extension] || 'text';
            }

            // Dữ liệu dropdown dùng cho tab Phân nhiệm trong modal
            var dsPhongBan = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DsPhongBanModal));
            var dsChucNang = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DsChucNangModal));

            var currentBudgetId = 0;
            var modalRowIndex = 0;

            var isPhanNhiemUserGlobal = false;

            var originalPhanNhiemList;

            // ── Mở modal khi click nút Xem ──────────────────────────────
            $(document).on('click', '.btn-view-modal', function () {
                currentBudgetId = $(this).data('budget-id');
                isPhanNhiemUserGlobal = $(this).data('is-phan-nhiem') === true;
                modalRowIndex   = 0;

                // Reset về trạng thái loading
                $('#modalLoading').show();
                $('#modalContent').hide();
                //$('#detail-phieu-btn').tab('show');

                var tabEl = document.querySelector('#detail-phieu-btn');
                if (tabEl) {
                    var tab = new bootstrap.Tab(tabEl);
                    tab.show();
                }

                // Modal Bootstrap 5 cũng nên dùng JS API
                var modal = new bootstrap.Modal(document.getElementById('budgetDetailsModal'));
                modal.show();

                //$('#budgetDetailsModal').modal('show');
                loadDetailsModal(currentBudgetId);
            });

            // ── [THÊM MỚI] Khi chuyển sang tab Nhật ký tiến độ ─────────
            $(document).on('shown.bs.tab', '#detail-nhatky-btn', function () {
                NhatKyTienDo.init(currentBudgetId);
            });

            // Reset NhatKyTienDo khi modal đóng
            $('#budgetDetailsModal').on('hidden.bs.modal', function () {
                NhatKyTienDo.reset();
            });

            // ── Gọi API GetDetailsModal ──────────────────────────────────
            function loadDetailsModal(id) {
                currentBudgetId = id;
                modalRowIndex = 0;

                // Reset về trạng thái loading
                $('#modalLoading').show();
                $('#modalContent').hide();
                $('#detail-phieu-btn').tab('show');

                // *** THÊM MỚI: Reset 2 card tổng hợp về 0
                // tránh hiển thị dữ liệu của hồ sơ trước ***
                $('#card_TongDangTrinh').text('0 ₫');
                $('#card_TongDaDuyet').text('0 ₫');

                $('#budgetDetailsModal').modal('show');

                $('#pn_SearchTen').val('');

                // *** THAY ĐỔI: Reset và cập nhật giao diện chosen ***
                $('#pn_FilterPhongBan').val('').trigger("chosen:updated");
                $('#pn_FilterChucNang').val('');

                $.ajax({
                    url: '@Url.Action("GetDetailsModal", "Budget")',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (!res.success) {
                            alert(res.message);
                            $('#budgetDetailsModal').modal('hide');
                            return;
                        }
                        bindModalData(res.data);
                        $('#modalLoading').hide();
                        $('#modalContent').show();
                        NhatKyTienDo.init(currentBudgetId);

                        _currentWorkflowType = res.data.WorkflowType;
                        _currentNgayDuyetBGD = res.data.NganSachGoc
                            ? res.data.NganSachGoc.NgayDuyetBGD
                            : null;
                        _currentIsOwner = res.isOwner;
                        _isEditMode = false;

                        // Gọi _updateModalButtons TRƯỚC khi capture snapshot
                        // để field ở đúng trạng thái trước khi chụp
                        _updateModalButtons(
                            _currentWorkflowType,
                            _currentNgayDuyetBGD,
                            _currentIsOwner
                        );

                        // Capture snapshot SAU khi field đã ở đúng trạng thái
                        _snapshotPhieu = _captureSnapshot();
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi khi tải dữ liệu.');
                        $('#budgetDetailsModal').modal('hide');
                    }
                });
            }

            // Hàm parse tiền tệ
            function parseCurrency(str) {
                if (!str) return 0;
                return parseFloat(str.toString().replace(/[^0-9.-]+/g, "")) || 0;
            }

            // Hàm format ngày cho input date (yyyy-MM-dd)
            function formatDateForInput(jsonDate) {
                if (!jsonDate) return '';

                // Trích xuất miliseconds từ chuỗi JSON Date của C#
                var ms = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'));
                var d = new Date(ms);

                // Tạo định dạng yyyy-MM-dd
                var year = d.getFullYear();
                var month = ('0' + (d.getMonth() + 1)).slice(-2);
                var day = ('0' + d.getDate()).slice(-2);

                var result = year + '-' + month + '-' + day;
                return result;
            }

            var isManagerOrAdminGlobal = false;

            // ── Bind dữ liệu vào các field ──────────────────────────────
            function bindModalData(data) {
                isManagerOrAdminGlobal = data.IsManagerOrAdmin;

                var status = data.TrangThaiHienThi; // Cần đảm bảo ViewModel trả về trường này
                var isOwner = data.UserId === currentUserIdGlobal; // CurrentUserId lấy từ biến toàn cục hệ thống

                //var canEdit = isManagerOrAdminGlobal || (isOwner && [0, 1, 6].includes(status));

                //// Mở/Khóa các trường
                //$('#detail-phieu input, #detail-phieu textarea, #detail-phieu select').not('#modal_TenPhongBan, #modal_MaHangMuc, #modal_TenNguoiDangKy, #modal_LyDoChinhSua').prop('readonly', !canEdit).prop('disabled', !canEdit);

                // Header
                //$('#modalMaHangMuc').text(data.MaHangMuc);
                // *** THAY ĐỔI: Ẩn/hiện MaHangMuc theo giá trị ***
                if (data.MaHangMuc) {
                    $('#modalMaHangMuc').text(data.MaHangMuc).show();
                    $('#modal_MaHangMuc').closest('.col-md-4').show();
                } else {
                    $('#modalMaHangMuc').text('').hide();
                    $('#modal_MaHangMuc').closest('.col-md-4').hide();
                }

                // Tab Phiếu đăng ký
                //$('#modal_AreaName').val(data.ProjectAreaId);
                $('#modal_TenPhongBan').val(data.TenPhongBan);
                $('#modal_MaHangMuc').val(data.MaHangMuc);
                $('#modal_TenNguoiDangKy').val(data.TenNguoiDangKy);

                $('#modal_AreaName').val(data.ProjectAreaId);
                $('#modal_TenHangMuc').val(data.TenHangMuc);
                $('#modal_DuToan').val(formatCurrency(data.DuToan)); // Vẫn hiển thị format đẹp
                $('#modal_SoToTrinh').val(data.SoToTrinh);
                $('#modal_CategoryTypeId').val(data.CategoryTypeId); // Bind theo ID
                $('#modal_PriorityLevelId').val(data.PriorityLevelId); // Bind theo ID
                $('#modal_SoLuong').val(data.SoLuong);
                $('#modal_NgayBatDau').val(formatDateForInput(data.NgayBatDau));
                $('#modal_NgayKetThuc').val(formatDateForInput(data.NgayKetThuc));
                console.log('data.InvestmentReasonId: ' + data.InvestmentReasonId)
                console.log('data.IsManualReason: ' + data.IsManualReason)
                if (data.InvestmentReasonId) {
                    $('#modal_InvestmentReasonId').val(data.InvestmentReasonId);
                } else if (data.IsManualReason) {
                    // Nếu không có ID nhưng là bản ghi nhập tay cũ/mới, trỏ dropdown về option "Điền thủ công"
                    // (Lưu ý: Đảm bảo trị value của option "Điền thủ công" khớp với danh mục trên view của bạn)
                    $("#modal_InvestmentReasonId option").filter(function () {
                        return $(this).text().trim() === "Điền thủ công";
                    }).prop('selected', true);
                } else {
                    $('#modal_InvestmentReasonId').val(''); // Trạng thái chưa chọn
                }
                $('#modal_LyDoDauTu').val(data.LyDoDauTu);
                $('#modal_MoTaKyThuat').val(data.MoTaKyThuat);
                $('#modal_LinkTaiLieu').val(data.LinkTaiLieuLienQuan);

                // Thực hiện ẩn/hiện vùng Textarea dựa trên cờ IsManualReason
                if (data.IsManualReason) {
                    $('#modal_divLyDoNhapTay').show();
                } else {
                    $('#modal_divLyDoNhapTay').hide();
                }

                var statusText = data.TrangThaiHienThiText || "Chưa xác định";
                var badgeClass = "bg-secondary text-white"; // Màu mặc định

                switch (statusText) {
                    case "Đăng ký mới":
                        badgeClass = "bg-light text-primary";
                        break;
                    case "Chưa đủ hồ sơ":
                        badgeClass = "bg-danger text-white";
                        break;
                    case "Theo luồng chi phí sản xuất":
                        badgeClass = "bg-dark text-white";
                        break;
                    case "Đang thực hiện xin ngân sách":
                        badgeClass = "bg-warning text-dark";
                        break;
                    case "Đang bổ sung ngân sách":
                        badgeClass = "bg-info text-dark";
                        break;
                    case "Đã phê duyệt ngân sách":
                        badgeClass = "bg-success text-white";
                        break;
                }

                $('#modalTrangThaiHienThiText')
                    .removeClass()
                    .addClass("badge ms-2 fs-6 " + badgeClass)
                    .text(statusText)
                    .show();

                // Attachments
                renderAttachments(data.Attachments);

                $('#containerBoSung').empty();

                // Workflow dropdown
                if (data.IsManagerOrAdmin) {
                    $('#workflowSection').show();
                    $('#modal_WorkflowType').val(data.WorkflowType || '');
                    applyWorkflowTabs(data.WorkflowType);
                } else {
                    $('#workflowSection').hide();
                    // *** THÊM MỚI: Chủ hồ sơ thấy tab Nhật ký nếu WorkflowType = 1 ***
                    applyWorkflowTabs(data.WorkflowType);
                }

                // Xử lý ẩn hiện dropdown phân nhiệm
                $(document).on('shown.bs.tab', 'button[data-bs-toggle="tab"]', function (e) {
                    var targetId = $(e.target).attr('data-bs-target');

                    if (typeof data !== 'undefined' && data.IsManagerOrAdmin) {

                        if (targetId === '#detail-phieu') {
                            $('#workflowSection').show();
                        } else {
                            $('#workflowSection').hide();
                        }
                    }
                });

                // Tab Phân nhiệm
                renderModalPhanNhiem(data.DanhSachPhanNhiem || []);

                originalPhanNhiemList = data.DanhSachPhanNhiem;

                // *** THÊM MỚI: Init dropdowns filter ***
                initPhanNhiemFilters();

                // *** THÊM MỚI — gọi bind tab Phê duyệt ***
                bindPheDuyetData(data.NganSachGoc, data.IsManagerOrAdmin);
                renderDanhSachBoSung(data.DanhSachBoSung);
                bindTienDoData(data.ThongTinTienDo);

                // *** THÊM MỚI: Xử lý quyền IsPhanNhiemUser ***
                var isPhanNhiem = data.IsPhanNhiemUser;

                // Ẩn DuToan trong tab Phiếu đăng ký
                if (isPhanNhiem) {
                    $('#modal_DuToan').closest('.col-md-4').hide();
                } else {
                    $('#modal_DuToan').closest('.col-md-4').show();
                }

                // Ẩn/hiện tab Phê duyệt
                if (isPhanNhiem) {
                    $('#tabPheDuyetItem').addClass('d-none');
                    // Nếu đang ở tab Phê duyệt thì về tab Phiếu
                    if ($('#detail-pheduyet').hasClass('active')) {
                        $('#detail-phieu-btn').tab('show');
                    }
                }

                // Tab Phân nhiệm — chỉ xem với user phân nhiệm
                $('#btnModalThemDong').toggle(!isPhanNhiem);
                if (isPhanNhiem) {
                    // Ẩn nút xóa dòng trong tab Phân nhiệm
                    $('#modalPhanNhiemBody').find('.btnModalXoaDong').hide();
                }
            }

            // ── Render Attachments ───────────────────────────────────────
            function renderAttachments(attachments) {
                var html = '';
                if (!attachments || attachments.length === 0) {
                    html = '<span class="text-muted small">Không có file đính kèm.</span>';
                } else {
                    $.each(attachments, function (i, a) {
                        // SỬA: dùng action DownloadFile thay vì URL trực tiếp
                        var downloadUrl = '/Budget/DownloadFile?attachmentId=' + a.AttachmentId;
                        html += '<div class="d-flex align-items-center gap-2 py-1 border-bottom">'
                            + '<i class="bi bi-file-earmark text-primary"></i>'
                            + '<a href="' + downloadUrl + '" '
                            + 'class="text-truncate flex-fill">'
                            + a.FileName
                            + '</a>'
                            + '<span class="text-muted small">' + (a.FileSizeFormatted || '') + '</span>'
                            + '<span class="text-muted small">'
                            + '</span>'
                            + '</div>';
                    });
                }
                $('#modal_AttachmentsList').html(html);
            }

            function applyWorkflowTabs(workflowType) {
                if (parseInt(workflowType) === 1) {
                    // *** THAY ĐỔI: Tab Phê duyệt chỉ hiện với Admin/Manager ***
                    if (isManagerOrAdminGlobal) {
                        $('#tabPheDuyetItem').removeClass('d-none');
                    }
                    $('#tabNhatKyItem').removeClass('d-none');
                } else {
                    $('#tabPheDuyetItem').addClass('d-none');
                    $('#tabNhatKyItem').addClass('d-none');
                    if ($('#detail-pheduyet').hasClass('active') ||
                        $('#detail-nhatky').hasClass('active')) {
                        //$('#detail-phieu-btn').tab('show');
                        var tabEl = document.querySelector('#detail-phieu-btn');
                        if (tabEl) {
                            var tab = new bootstrap.Tab(tabEl);
                            tab.show();
                        }
                    }
                }
            }

            // ── Lắng nghe thay đổi WorkflowType ─────────────────────────
            $(document).on('change', '#modal_WorkflowType', function () {
                applyWorkflowTabs($(this).val());
            });

            // ── Render tab Phân nhiệm từ dữ liệu có sẵn ─────────────────
