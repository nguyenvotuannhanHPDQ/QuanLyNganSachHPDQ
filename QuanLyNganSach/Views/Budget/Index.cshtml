                    '    <th class="col-pct">%</th>',
                    '    <th class="col-date">Ngày BD (KH)</th>',
                    '    <th class="col-date">Ngày KT (KH)</th>',
                    '    <th class="col-ghichu">Ghi chú</th>',
                    '    <th class="col-action"></th>',
                    '  </tr></thead>',
                    '  <tbody></tbody>',
                    '</table>'
                ].join(''));

                var $tbody = $table.find('tbody');
                $.each(workItemList, function (_, w) {
                    $tbody.append(_createRow(w.Name));
                });

                // THÊM MỚI: khởi tạo lock ngay sau khi render
                _refreshRowLocks($wrapper);

                var $btnAddRow = $(
                    '<button class="btn-add-row" type="button">'
                    + '<i class="bi bi-plus me-1"></i>Thêm đầu việc</button>'
                );
