                        <!-- Tab 3: Theo dõi tiến độ -->
                        <div class="tab-pane fade"
                             id="modal-progress-tab-pane"
                             role="tabpanel"
                             aria-labelledby="modal-progress-tab"
                             tabindex="0">

                            <div class="card border-0">
                                <div class="card-body">
                                    <div class="alert alert-info" role="alert">
                                        <i class="bi bi-info-circle"></i> Nội dung theo dõi tiến độ đang được phát triển.
                                    </div>
                                </div>
