                                        <div class="d-flex">
                                            <div class="toast-body" id="nk-toast-body"></div>
                                            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                                                    data-bs-dismiss="toast"></button>
                                        </div>
                                    </div>
                                </div>

                            </div>


                        </div>

                    </div><!-- end tab-content -->
                    <!-- ===== DROPDOWN XÁC NHẬN LUỒNG (Admin + Manager) ===== -->
