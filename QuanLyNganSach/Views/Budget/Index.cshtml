                    '    <i class="bi bi-x-lg"></i>',
                    '  </button>',
                    '</div>'
                ].join(''));

                $header.on('click', '.btn-remove-kv', function () {
                    $wrapper.remove();
                    _recalcTotal();
                });

                var $table = $([
                    '<table class="nk-table">',
                    '  <thead><tr>',
                    '    <th class="col-hangmuc">Hạng mục công việc</th>',
                    '    <th class="col-dvt">ĐVT</th>',
                    '    <th class="col-kl">KL Kế hoạch</th>',
