            // ── Validation & Cascade Delete Functions ──────────────────
            // Cấu trúc thứ tự mốc ngày
            var mocNgayOrder = ['pd_NgayDuyetPDA', 'pd_NgayDuyetPKT', 'pd_NgayDuyetERPD', 'pd_NgayDuyetBTC', 'pd_NgayDuyetBGD'];

            function clearMocErrors() {
                $('.moc-error').hide();
            }

            function showMocError(fieldId, message) {
                var $error = $('#error-' + fieldId);
                if ($error.length) {
                    $error.text(message).show();
                }
            }

            function validateMocNgaySequence(fieldId) {
                clearMocErrors();
                var processType = parseInt($('#pd_ProcessType').val()) || 1;
                var visibleMocs = mocNgayOrder.filter(function (id) {
                    if (id === 'pd_NgayDuyetERPD' || id === 'pd_NgayDuyetBTC') {
                        return processType === 1; // Chỉ hiển thị khi ProcessType = 1
                    }
                    return true;
                });

                for (var i = 0; i < visibleMocs.length; i++) {
                    var currentId = visibleMocs[i];
                    var currentVal = $('#' + currentId).val();

                    if (currentVal) {
                        // Kiểm tra mốc trước có trống không
                        if (i > 0) {
                            var prevId = visibleMocs[i - 1];
                            var prevVal = $('#' + prevId).val();
                            if (!prevVal) {
                                var currentMoc = $('#' + currentId).data('moc') || currentId;
                                var prevMoc = $('#' + prevId).data('moc') || prevId;
                                showMocError(currentId, 'Phải nhập ' + prevMoc + ' trước');
                                return false;
                            }
                        }

                        // Kiểm tra giá trị ngày có hợp lệ không (không vượt quá mốc kế tiếp)
                        if (i < visibleMocs.length - 1) {
                            var nextId = visibleMocs[i + 1];
                            var nextVal = $('#' + nextId).val();
                            if (nextVal && currentVal > nextVal) {
                                var currentMoc = $('#' + currentId).data('moc') || currentId;
                                var nextMoc = $('#' + nextId).data('moc') || nextId;
                                showMocError(currentId, currentMoc + ' không được sau ' + nextMoc);
                                return false;
                            }
                        }
                    }
                }
                return true;
            }

            function clearFollowingMocNgay(fieldId) {
                var processType = parseInt($('#pd_ProcessType').val()) || 1;
                var visibleMocs = mocNgayOrder.filter(function (id) {
                    if (id === 'pd_NgayDuyetERPD' || id === 'pd_NgayDuyetBTC') {
                        return processType === 1;
                    }
                    return true;
                });

                var currentIndex = visibleMocs.indexOf(fieldId);
                if (currentIndex !== -1) {
                    // Xóa tất cả mốc sau hiện tại
                    for (var i = currentIndex + 1; i < visibleMocs.length; i++) {
                        $('#' + visibleMocs[i]).val('');
                    }
                }
            }

            // Lắng nghe thay đổi trên tất cả mốc ngày
            $(document).on('change', '.moc-ngay', function () {
                var fieldId = $(this).attr('id');
                var newVal = $(this).val();

                if (newVal === '') {
                    // User xóa giá trị → Xóa cascade các mốc sau
                    clearFollowingMocNgay(fieldId);
                    clearMocErrors();
                } else {
                    // User nhập giá trị → Validate thứ tự
                    if (!validateMocNgaySequence(fieldId)) {
                        // Nếu validation fail → revert lại giá trị cũ
                        $(this).val('');
                    }
                }

                updateMocNgayState();
            });

