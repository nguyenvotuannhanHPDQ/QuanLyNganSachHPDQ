                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light" id="modalFooter" style="display: none;">
                <div class="d-flex justify-content-between w-100">
                    <div>
                        <a href="#" id="modal-viewFullDetails" class="btn btn-outline-primary" target="_blank">
                            <i class="bi bi-box-arrow-up-right"></i> Xem đầy đủ
                        </a>
                    </div>
                    <div>
                        <a href="#" id="modal-editBtn" class="btn btn-warning" style="display: none;">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </a>
                        <button type="button" id="modal-deleteBtn" class="btn btn-danger" style="display: none;">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg"></i> Đóng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Search on input with debounce
            var searchTimeout;
            $('#searchInput').on('keyup', function (e) {
                // Don't submit on Enter key here (handled separately)
                if (e.which === 13) {
                    return;
                }

                clearTimeout(searchTimeout);
                var searchValue = $(this).val(); // Capture value

                searchTimeout = setTimeout(function () {
                    // Ensure value is set before submit
                    $('#searchInput').val(searchValue);
                    $('#searchForm').submit();
                }, 500); // Wait 500ms after user stops typing
            });

            // Filter by status - submit form immediately
            $('input[name="status"]').on('change', function () {
                $('#searchForm').submit();
            });

            // Auto-submit when department filter changes (for Manager/Admin)
            $('#phongBanId').on('change', function () {
                $('#searchForm').submit();
            });

            // Clear search button
            $('#clearSearch').on('click', function () {
                $('#searchInput').val('');
                $('#searchForm').submit();
            });

            // Handle Enter key explicitly
            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    clearTimeout(searchTimeout); // Cancel debounce
                    $('#searchForm').submit();
                }
            });

            // Auto-submit when sort order changes
            $('#sortOrder').on('change', function () {
                var sortValue = $(this).val();
                var currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('sortOrder', sortValue);
                currentUrl.searchParams.delete('page'); // Reset về trang 1
                window.location.href = currentUrl.toString();
            });

            var currentBudgetId = null;
            var currentWorkflowType = 0;

            // Handle view button click
            $(document).on('click', '.btn-view-modal', function() {
                var budgetId = $(this).data('budget-id');
                currentBudgetId = budgetId;
                loadBudgetDetails(budgetId);
            });

            // Load budget details via AJAX
            function loadBudgetDetails(budgetId) {
                // Show modal
                var modal = new bootstrap.Modal(document.getElementById('budgetDetailModal'));
                modal.show();

                // Show loading, hide content
                $('#modalLoading').show();
                $('#modalContentContainer').hide();
                $('#modalFooter').hide();

                // AJAX call
                $.ajax({
                    url: '@Url.Action("GetDetailsModal", "Budget")',
                    type: 'GET',
                    data: { id: budgetId },
                    success: function(response) {
                        if (response.success) {
                            populateModalData(response.data);
                            $('#modalLoading').hide();
                            $('#modalContentContainer').show();
                            $('#modalFooter').show();
                        } else {
                            showError(response.message || 'Không thể tải thông tin chi tiết.');
                        }
                    },
                    error: function(xhr, status, error) {
                        showError('Đã xảy ra lỗi khi tải dữ liệu. Vui lòng thử lại.');
                    }
                });
            }

            // Populate modal with data
            function populateModalData(data) {
                // Basic information
                $('#modal-tenPhongBan').val(data.TenPhongBan || '');
                $('#modal-maHangMuc').val(data.MaHangMuc || '');
                $('#modal-nguoiDangKy').val(data.NguoiDangKy || '');

                if (data.EmailNguoiDangKy) {
                    $('#modal-emailNguoiDangKy').html('<i class="bi bi-envelope"></i> ' + data.EmailNguoiDangKy);
                }

                $('#modal-tenHangMuc').val(data.TenHangMuc || '');
                $('#modal-duToan').val(formatCurrency(data.DuToan) + ' VNĐ');
                $('#modal-soToTrinh').val(data.SoToTrinh || '');

                $('#modal-categoryTypeName').val(data.CategoryTypeName || '');
                $('#modal-priorityLevelName').val(data.PriorityLevelName || '');
                $('#modal-soLuong').val(data.SoLuong || '');

                $('#modal-lyDoDauTu').val(data.LyDoDauTu || '');
                $('#modal-moTaKyThuat').val(data.MoTaKyThuat || '');

                // Dates
                $('#modal-ngayBatDau').val(formatDate(data.NgayBatDau));
                $('#modal-ngayKetThuc').val(formatDate(data.NgayKetThuc));
                $('#modal-ngayTao').val(formatDateTime(data.NgayTao));

                // Attachments
                renderAttachments(data.Attachments);

                // Link tài liệu
                renderLinkTaiLieu(data.LinkTaiLieuLienQuan);

                // Workflow Type - Show/Hide based on role
                currentWorkflowType = data.WorkflowType || 0;

                if (data.IsManagerOrAdmin) {
                    $('#modal-workflow-container').show();
                    $('#modal-workflowType').val(currentWorkflowType).prop('disabled', false);
                } else {
                    $('#modal-workflow-container').hide();
                }

                // Update tabs visibility based on workflow type
                updateTabsVisibility(currentWorkflowType);

                // Action buttons
                $('#modal-viewFullDetails').attr('href', '@Url.Action("Details", "Budget")/' + data.BudgetRegistrationId);

                if (data.CanEdit) {
                    $('#modal-editBtn').show().attr('href', '@Url.Action("Edit", "Budget")/' + data.BudgetRegistrationId);
                } else {
                    $('#modal-editBtn').hide();
                }

                if (data.CanDelete) {
                    $('#modal-deleteBtn').show().data('budget-id', data.BudgetRegistrationId).data('budget-name', data.TenHangMuc);
                } else {
                    $('#modal-deleteBtn').hide();
                }
            }

            // Update tabs visibility based on workflow type
            function updateTabsVisibility(workflowType) {
                // Reset: Hide all tabs except info tab
                $('#modal-approval-tab-li').hide();
                $('#modal-progress-tab-li').hide();

                // Show tabs based on workflow type
                switch(parseInt(workflowType)) {
                    case 1: // Ngân sách đầu tư
                        $('#modal-approval-tab-li').show();
                        $('#modal-progress-tab-li').hide();
                        break;

                    case 2: // Chi phí sản xuất
                        $('#modal-approval-tab-li').show();
                        $('#modal-progress-tab-li').show();
                        break;

                    case 0: // Chưa xác định
                    default:
                        $('#modal-approval-tab-li').hide();
                        $('#modal-progress-tab-li').hide();
                        break;
                }

                // Reset to info tab if current tab is hidden
                var activeTab = $('#budgetDetailModalTabs .nav-link.active').attr('id');
                if ((activeTab === 'modal-approval-tab' && !$('#modal-approval-tab-li').is(':visible')) ||
                    (activeTab === 'modal-progress-tab' && !$('#modal-progress-tab-li').is(':visible'))) {
                    var infoTab = new bootstrap.Tab(document.querySelector('#modal-info-tab'));
                    infoTab.show();
                }
            }

            // Handle workflow type change
            $(document).on('change', '#modal-workflowType', function() {
                var newWorkflowType = parseInt($(this).val());

                if (newWorkflowType === currentWorkflowType) {
                    return; // No change
                }

                // Confirm change
                if (!confirm('Bạn có chắc chắn muốn thay đổi luồng quy trình không?\n\nThao tác này sẽ ảnh hưởng đến quy trình phê duyệt và các tab hiển thị.')) {
                    $(this).val(currentWorkflowType); // Revert
                    return;
                }

                // Show loading
                var $dropdown = $(this);
                var originalHtml = $dropdown.html();
                $dropdown.prop('disabled', true);

                // AJAX call to update workflow type
                $.ajax({
                    url: '@Url.Action("UpdateWorkflowType", "Budget")',
                    type: 'POST',
                    data: {
                        budgetId: currentBudgetId,
                        workflowType: newWorkflowType
                    },
                    success: function(response) {
                        if (response.success) {
                            currentWorkflowType = newWorkflowType;
                            updateTabsVisibility(newWorkflowType);
                            showNotification('success', 'Cập nhật luồng quy trình thành công!');
                        } else {
                            showNotification('error', response.message || 'Không thể cập nhật luồng quy trình.');
                            $dropdown.val(currentWorkflowType); // Revert
                        }
                    },
                    error: function() {
                        showNotification('error', 'Đã xảy ra lỗi khi cập nhật. Vui lòng thử lại.');
                        $dropdown.val(currentWorkflowType); // Revert
                    },
                    complete: function() {
                        $dropdown.prop('disabled', false);
                    }
                });
            });

            // Show notification
            function showNotification(type, message) {
                var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                var icon = type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill';

                var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999;">' +
                    '<i class="bi bi-' + icon + '"></i> ' + message +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                    '</div>';

                $('body').append(alertHtml);

                // Auto dismiss after 3 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 3000);
            }

            // Reset modal when closed
            $('#budgetDetailModal').on('hidden.bs.modal', function () {
                $('#modalLoading').show();
                $('#modalContentContainer').hide();
                $('#modalFooter').hide();

                // Reset workflow
                currentBudgetId = null;
                currentWorkflowType = 0;

                // Hide all tabs except info
                $('#modal-approval-tab-li').hide();
                $('#modal-progress-tab-li').hide();

                // Reset to first tab
                var firstTab = new bootstrap.Tab(document.querySelector('#modal-info-tab'));
                firstTab.show();
            });

            // Existing helper functions...
            // formatCurrency, formatDate, formatDateTime, renderAttachments, renderLinkTaiLieu, etc.

            // Render attachments
            function renderAttachments(attachments) {
                var container = $('#modal-attachments');
                container.empty();

                if (attachments && attachments.length > 0) {
                    var html = '<div class="list-group">';
                    attachments.forEach(function(file) {
                        html += '<div class="list-group-item">';
                        html += '  <div class="d-flex justify-content-between align-items-center">';
                        html += '    <div class="flex-grow-1">';
                        html += '      <div class="d-flex align-items-center mb-1">';
                        html += '        <i class="bi bi-file-earmark-' + getFileIcon(file.FileExtension) + ' me-2"></i>';
                        html += '        <strong>' + file.FileName + '</strong>';
                        html += '      </div>';
                        html += '      <small class="text-muted">' + file.FileSizeFormatted + '</small>';
                        html += '    </div>';
                        html += '    <div class="btn-group" role="group">';
                        html += '      <a href="@Url.Action("DownloadFile", "Budget")/' + file.AttachmentId + '" class="btn btn-sm btn-outline-primary" target="_blank" title="Tải xuống">';
                        html += '        <i class="bi bi-download"></i>';
                        html += '      </a>';
                        html += '    </div>';
                        html += '  </div>';
                        html += '</div>';
                    });
                    html += '</div>';
                    container.html(html);
                } else {
                    container.html('<input type="text" class="form-control" value="" readonly />');
                }
            }

            // Render link tài liệu
            function renderLinkTaiLieu(link) {
                var container = $('#modal-linkTaiLieu');
                container.empty();

                if (link) {
                    var html = '<div class="input-group">';
                    html += '  <input type="text" class="form-control" value="' + link + '" readonly />';
                    html += '  <a href="' + link + '" class="btn btn-primary" target="_blank">';
                    html += '    <i class="bi bi-link-45deg"></i> Mở';
                    html += '  </a>';
                    html += '</div>';
                    container.html(html);
                } else {
                    container.html('<input type="text" class="form-control" value="" readonly />');
                }
            }

            // Helper functions
            function formatCurrency(value) {
                return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            // Format date từ C# DateTime sang dd/MM/yyyy
            function formatDate(dateString) {
                if (!dateString) return '';

                try {
                    // Parse ISO string hoặc .NET JSON date format
                    var date;

                    // Check if it's .NET JSON date format: /Date(1234567890000)/
                    if (typeof dateString === 'string' && dateString.indexOf('/Date(') === 0) {
                        var timestamp = parseInt(dateString.replace(/\/Date\((\d+)\)\//, '$1'));
                        date = new Date(timestamp);
                    } else {
                        // ISO format hoặc normal date string
                        date = new Date(dateString);
                    }

                    // Validate date
                    if (isNaN(date.getTime())) {
                        console.warn('Invalid date:', dateString);
                        return dateString; // Return original if can't parse
                    }

                    var day = String(date.getDate()).padStart(2, '0');
                    var month = String(date.getMonth() + 1).padStart(2, '0');
                    var year = date.getFullYear();

                    return day + '/' + month + '/' + year;
                } catch (e) {
                    console.error('Error formatting date:', e);
                    return dateString;
                }
            }

            // Format datetime từ C# DateTime sang dd/MM/yyyy HH:mm
            function formatDateTime(dateString) {
                if (!dateString) return '';

                try {
                    // Parse ISO string hoặc .NET JSON date format
                    var date;

                    // Check if it's .NET JSON date format: /Date(1234567890000)/
                    if (typeof dateString === 'string' && dateString.indexOf('/Date(') === 0) {
                        var timestamp = parseInt(dateString.replace(/\/Date\((\d+)\)\//, '$1'));
                        date = new Date(timestamp);
                    } else {
                        // ISO format hoặc normal date string
                        date = new Date(dateString);
                    }

                    // Validate date
                    if (isNaN(date.getTime())) {
                        console.warn('Invalid datetime:', dateString);
                        return dateString; // Return original if can't parse
                    }

                    var day = String(date.getDate()).padStart(2, '0');
                    var month = String(date.getMonth() + 1).padStart(2, '0');
                    var year = date.getFullYear();
                    var hours = String(date.getHours()).padStart(2, '0');
                    var minutes = String(date.getMinutes()).padStart(2, '0');

                    return day + '/' + month + '/' + year + ' ' + hours + ':' + minutes;
                } catch (e) {
                    console.error('Error formatting datetime:', e);
                    return dateString;
                }
            }

            function getFileIcon(extension) {
                if (!extension) return 'text';
                extension = extension.toLowerCase().replace('.', '');

                var icons = {
                    'pdf': 'pdf text-danger',
                    'doc': 'word text-primary',
                    'docx': 'word text-primary',
                    'xls': 'excel text-success',
                    'xlsx': 'excel text-success',
                    'ppt': 'ppt text-warning',
                    'pptx': 'ppt text-warning',
                    'jpg': 'image text-info',
                    'jpeg': 'image text-info',
                    'png': 'image text-info',
                    'gif': 'image text-info',
                    'zip': 'zip text-secondary',
                    'rar': 'zip text-secondary'
                };

                return icons[extension] || 'text';
            }

            function showError(message) {
                $('#modalLoading').hide();
                $('#modalContentContainer').hide();
                $('#modalBodyContent').html(
                    '<div class="alert alert-danger text-center" role="alert">' +
                    '  <i class="bi bi-exclamation-triangle-fill"></i> ' +
                    '  <p class="mb-0">' + message + '</p>' +
                    '</div>'
                );
            }

            // Handle delete button in modal
            $(document).on('click', '#modal-deleteBtn', function() {
                var budgetId = $(this).data('budget-id');
                var budgetName = $(this).data('budget-name');

                if (confirm('Bạn có chắc chắn muốn xóa đăng ký "' + budgetName + '" không?\n\nHành động này không thể hoàn tác!')) {
                    // Close modal first
                    bootstrap.Modal.getInstance(document.getElementById('budgetDetailModal')).hide();

                    // Trigger delete action
                    window.location.href = '@Url.Action("Delete", "Budget")/' + budgetId;
                }
            });

            // Reset modal when closed
            $('#budgetDetailModal').on('hidden.bs.modal', function () {
                $('#modalLoading').show();
                $('#modalContentContainer').hide();
                $('#modalFooter').hide();

                // Reset to first tab
                var firstTab = new bootstrap.Tab(document.querySelector('#modal-info-tab'));
                firstTab.show();
            });
        });
    </script>
