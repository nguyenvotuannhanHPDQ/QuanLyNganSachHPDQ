            function applyTrangThaiPheDuyet(trangThai, isManagerOrAdmin) {
                var $badge = $('#badgeTrangThaiPheDuyet');
                var $duToanInput = $('#pd_DuToanPheDuyet');

                switch (trangThai) {
                    case 0: // Chờ trình — chưa có ngày PDA
                        $badge.text('Chờ trình')
                            .removeClass('bg-success bg-warning text-dark')
                            .addClass('bg-secondary');

                        // *** THAY ĐỔI: readonly, xóa giá trị ***
                        $duToanInput.val('')
                            .prop('readonly', true)
                            .attr('placeholder', 'Chưa có ngày duyệt PDA');

                        // *** THÊM MỚI: Readonly + ẩn dấu * ***
                        $('#pd_SoThongBao, #pd_SoFM, #pd_SoIO')
                            .val('').prop('readonly', true);
                        $('#star_SoThongBao, #star_SoFM, #star_SoIO').hide();
                        break;

                    case 1: // Đang trình — có ngày PDA, chưa có ngày BGĐ
                        var rawTrinh = $duToanInput.val().replace(/,/g, '').replace(/\./g, '');
                        var numTrinh = parseFloat(rawTrinh) || 0;
                        if (numTrinh > 0) {
                            $duToanInput.val(numTrinh.toLocaleString('en-US'));
                        }

                        // Bỏ readonly để cho phép chỉnh sửa
                        $duToanInput.prop('readonly', false)
                            .attr('placeholder', 'Nhập ngân sách phê duyệt');

                        // *** THAY ĐỔI: Badge hiển thị động số tiền ***
                        var badgeTrinh = numTrinh > 0
                            ? 'Đang trình: ' + formatCurrencyPD(numTrinh)
                            : 'Đang trình';
                        $badge.text(badgeTrinh)
                            .removeClass('bg-success bg-secondary')
                            .addClass('bg-warning text-dark');

                        // *** THÊM MỚI: Readonly + ẩn dấu * ***
                        $('#pd_SoThongBao, #pd_SoFM, #pd_SoIO')
                            .prop('readonly', true);
                        $('#star_SoThongBao, #star_SoFM, #star_SoIO').hide();
                        break;

                    case 2: // Đã phê duyệt — có ngày BGĐ
                        $badge.text('Đã phê duyệt')
                            .removeClass('bg-warning bg-secondary text-dark')
                            .addClass('bg-success');

                        // Giữ nguyên giá trị đang có, chỉ đảm bảo không readonly
                        $duToanInput.prop('readonly', false)
                            .attr('placeholder', 'Nhập ngân sách phê duyệt');

                        // *** THÊM MỚI: Bỏ readonly + hiện dấu * bắt buộc ***
                        $('#pd_SoThongBao, #pd_SoFM, #pd_SoIO')
                            .prop('readonly', !isManagerOrAdmin);
                        if (isManagerOrAdmin) {
                            $('#star_SoThongBao, #star_SoFM, #star_SoIO').show();
                        }
                        break;
                }
            }

