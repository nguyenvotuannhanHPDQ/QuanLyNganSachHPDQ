@using PagedList.Mvc
@model PagedList.IPagedList<QuanLyNganSach.Models.ViewModels.BudgetRegistrationListViewModel>
@{
    ViewBag.Title = "Danh sách đăng ký ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house-door"></i> Trang chủ - Index
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Danh sách hồ sơ đăng ký ngân sách - Index
                    </li>
                </ol>
            </nav>

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0 fw-semibold">
                        <i class="bi bi-card-list text-primary me-2"></i>
                        Danh sách hồ sơ đăng ký ngân sách
                    </h4>
                    <small class="text-muted">
                        Tổng số: <span>@Model.TotalItemCount</span> đăng ký
                    </small>
                </div>
                <a href="@Url.Action("Create", "Budget")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Đăng ký mới
                </a>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Html.Raw(TempData["Success"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Card chứa bảng -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    @using (Html.BeginForm("Index", "Budget", FormMethod.Get, new { id = "searchForm" }))
                    {
                        <div class="row align-items-center g-2">
                            <!-- SEARCH -->
                            <div class="col-12 col-md-5 col-lg-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           id="searchInput"
                                           name="search"
                                           value="@ViewBag.CurrentSearch"
                                           class="form-control"
                                           placeholder="Tìm kiếm theo mã, tên hạng mục...">
                                    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch))
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                id="clearSearch"
                                                title="Xóa tìm kiếm">
                                            <i class="bi bi-x-lg"></i>Clear
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- PHÒNG BAN (Manager/Admin) -->
                            @if (ViewBag.IsManagerOrAdmin == true)
                            {
                                <div class="col-12 col-md-4 col-lg-3">
                                    <select id="phongBanId"
                                            name="phongBanId"
                                            class="form-select form-select-sm">
                                        @foreach (var item in ViewBag.PhongBanList as List<SelectListItem>)
                                        {
                                            <option value="@item.Value" @(item.Selected ? "selected" : "")>
                                                @item.Text
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- SORT -->
                            <div class="col-12 col-md-3 col-lg-2">
                                <select id="sortOrder"
                                        name="sortOrder"
                                        class="form-select form-select-sm">
                                    <option value="newest" @(ViewBag.CurrentSort == "newest" ? "selected" : "")>
                                        Ngày tạo mới nhất
                                    </option>
                                    <option value="oldest" @(ViewBag.CurrentSort == "oldest" ? "selected" : "")>
                                        Ngày tạo cũ nhất
                                    </option>
                                    <option value="budget-high" @(ViewBag.CurrentSort == "budget-high" ? "selected" : "")>
                                        Dự toán cao - thấp
                                    </option>
                                    <option value="budget-low" @(ViewBag.CurrentSort == "budget-low" ? "selected" : "")>
                                        Dự toán thấp - cao
                                    </option>
                                </select>
                            </div>
                        </div>
                        <!-- HÀNG 2: FILTER TIẾN ĐỘ + TRẠNG THÁI HỒ SƠ -->
                        <div class="row align-items-center g-2 mt-1">

                            <!-- Filter Tiến độ -->
                            <div class="col-12 col-md-4 col-lg-3">
                                <select id="filterTienDo"
                                        name="filterTienDo"
                                        class="form-select form-select-sm">
                                    <option value="">-- Tất cả tiến độ --</option>
                                    <option value="-1"
                                            @(ViewBag.CurrentFilterTienDo != null && (int)ViewBag.CurrentFilterTienDo == -1 ? "selected" : "")>
                                        Chưa xác định
                                    </option>
                                    <option value="0"
                                            @(ViewBag.CurrentFilterTienDo != null && (int)ViewBag.CurrentFilterTienDo == 0 ? "selected" : "")>
                                        Tạm dừng
                                    </option>
                                    <option value="1"
                                            @(ViewBag.CurrentFilterTienDo != null && (int)ViewBag.CurrentFilterTienDo == 1 ? "selected" : "")>
                                        Đạt tiến độ
                                    </option>
                                    <option value="2"
                                            @(ViewBag.CurrentFilterTienDo != null && (int)ViewBag.CurrentFilterTienDo == 2 ? "selected" : "")>
                                        Chậm tiến độ
                                    </option>
                                    <option value="3"
                                            @(ViewBag.CurrentFilterTienDo != null && (int)ViewBag.CurrentFilterTienDo == 3 ? "selected" : "")>
                                        Vượt tiến độ
                                    </option>
                                </select>
                            </div>

                            <!-- Filter Trạng thái hồ sơ -->
                            <div class="col-12 col-md-5 col-lg-4">
                                <select id="filterTrangThai"
                                        name="filterTrangThai"
                                        class="form-select form-select-sm">
                                    <option value="">-- Tất cả trạng thái --</option>
                                    <option value="0"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 0 ? "selected" : "")>
                                        Chưa có chủ trương phê duyệt
                                    </option>
                                    <option value="1"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 1 ? "selected" : "")>
                                        Đăng ký mới
                                    </option>
                                    <option value="2"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 2 ? "selected" : "")>
                                        Đang thực hiện xin ngân sách
                                    </option>
                                    <option value="3"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 3 ? "selected" : "")>
                                        Đã phê duyệt ngân sách
                                    </option>
                                    <option value="4"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 4 ? "selected" : "")>
                                        Đang bổ sung ngân sách
                                    </option>
                                    <option value="5"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 5 ? "selected" : "")>
                                        Theo luồng chi phí sản xuất
                                    </option>
                                    <option value="6"
                                            @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 6 ? "selected" : "")>
                                        Chưa đủ hồ sơ
                                    </option>
                                </select>
                            </div>

                            <!-- Nút xóa filter (chỉ hiện khi có filter) -->
                            @if (ViewBag.CurrentFilterTienDo != null
                              || ViewBag.CurrentFilterTrangThai != null)
                            {
                                <div class="col-auto">
                                    <a href="@Url.Action("Index", "Budget", new {
                                        search    = ViewBag.CurrentSearch,
                                        sortOrder = ViewBag.CurrentSort,
                                        phongBanId = ViewBag.CurrentPhongBanId
                                     })"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                                    </a>
                                </div>
                            }

                        </div>
                    }

                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <!-- Budget Cards - One card per row -->
                        <div class="budget-cards-container">
                            @{ int cardIndex = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
                            @foreach (var item in Model)
                            {
                                <div class="card mb-3 shadow-sm border-0 budget-card-horizontal">
                                    <div class="card-body">
                                        <div class="row align-items-center g-3">
                                            <div class="badge bg-light text-dark border mb-2" style="width: 50px; height: 50px; line-height: 50px; font-size: 1.2rem; border-radius: 10px;">
                                                #@cardIndex
                                            </div>
                                            <!-- Column 2: Mã hạng mục & Ngày tạo -->
                                            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                                                <div class="mb-2">
                                                    @if (!string.IsNullOrEmpty(item.MaHangMuc))
                                                    {
                                                        <span class="badge bg-secondary">@item.MaHangMuc</span>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar-plus"></i>
                                                    @item.NgayTao.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>

                                            <!-- Column 3: Tên hạng mục & Phòng ban -->
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                                <h6 class="mb-1 fw-bold">
                                                    <a href="#"
                                                       class="text-decoration-none text-dark"
                                                       title="@item.TenHangMuc">
                                                        @item.TenHangMuc
                                                    </a>
                                                </h6>
                                                <div class="text-muted small">
                                                    <i class="bi bi-building text-primary"></i>
                                                    @item.TenPhongBan
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.NguoiDangKy))
                                                {
                                                    <div class="text-muted small mt-1">
                                                        <i class="bi bi-journal-text"></i>
                                                        @item.NguoiDangKy
                                                    </div>
                                                }
                                            </div>

                                            <!-- Column 4: Dự toán - Highlighted -->
                                            @* Thay đoạn hiển thị cột dự toán cũ *@
                                            @if (!item.IsPhanNhiemUser)
                                            {
                                                <div class="col-6 col-sm-6 col-md-3 col-lg-2">
                                                    @if (item.CoThongTinPheDuyet)
                                                    {
                                                        <div class="p-2 bg-primary bg-opacity-10 rounded text-center">
                                                            <small class="text-muted d-block">
                                                                <i class="bi bi-check-circle"></i> Đã phê duyệt
                                                            </small>
                                                            <div class="fw-bold text-primary fs-5">
                                                                @item.TongTienDaDuyet.ToString("N0")
                                                            </div>
                                                            <small class="text-muted">VNĐ</small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="p-2 bg-success bg-opacity-10 rounded text-center">
                                                            <small class="text-muted d-block">
                                                                <i class="bi bi-currency-dollar"></i> Dự toán
                                                            </small>
                                                            <div class="fw-bold text-success fs-5">
                                                                @item.DuToan.ToString("N0")
                                                            </div>
                                                            <small class="text-muted">VNĐ</small>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            <!-- Column 1: STT & Status Badge -->
                                            <div class="col-auto">
                                                <div class="text-center">

                                                    @{
                                                        string badgeClass = "";
                                                        string badgeIcon = "bi-info-circle";
                                                        string badgeText = "";

                                                        switch (item.TrangThaiHienThi)
                                                        {
                                                            case 0:
                                                                badgeClass = "bg-secondary";
                                                                badgeIcon = "bi-slash-circle";
                                                                badgeText = "Chưa có chủ trương phê duyệt";
                                                                break;
                                                            case 1:
                                                                badgeClass = "bg-primary";
                                                                badgeIcon = "bi-file-earmark-plus";
                                                                badgeText = "Đăng ký mới";
                                                                break;
                                                            case 2:
                                                                badgeClass = "bg-warning text-dark";
                                                                badgeIcon = "bi-hourglass-split";
                                                                badgeText = "Đang thực hiện xin ngân sách";
                                                                break;
                                                            case 3:
                                                                badgeClass = "bg-success";
                                                                badgeIcon = "bi-check-circle";
                                                                badgeText = "Đã phê duyệt ngân sách";
                                                                break;
                                                            case 4:
                                                                badgeClass = "bg-info text-dark";
                                                                badgeIcon = "bi-arrow-repeat";
                                                                badgeText = "Đang bổ sung ngân sách";
                                                                break;
                                                            case 5:
                                                                badgeClass = "bg-danger";
                                                                badgeIcon = "bi-arrow-left-right";
                                                                badgeText = "Theo luồng chi phí sản xuất";
                                                                break;
                                                            case 6:
                                                                badgeClass = "bg-danger";
                                                                badgeIcon = "bi-exclamation-triangle";
                                                                badgeText = "Hồ sơ thiếu thông tin";
                                                                break;
                                                        }
                                                    }
                                                    <span class="badge @badgeClass">
                                                        <i class="bi @badgeIcon"></i> @badgeText
                                                    </span>
                                                </div>
                                            </div>
                                            <!-- Column 5: Thời gian -->
                                            <div class="col-6 col-sm-6 col-md-2 col-lg-2">
                                                @{
                                                    bool coTienDo = item.TongTienDo.HasValue;
                                                    bool coDanhGia = item.DanhGiaChung.HasValue;
                                                }
                                                @if (coTienDo || coDanhGia)
                                                {
                                                    <div class="small">
                                                        @if (coTienDo)
                                                        {
                                                            <div class="mb-1">
                                                                <i class="bi bi-bar-chart-line text-primary"></i>
                                                                <span class="text-muted">
                                                                    Tiến độ:
                                                                    <strong class="text-primary">
                                                                        @item.TongTienDo.Value.ToString("0.#")%
                                                                    </strong>
                                                                </span>
                                                            </div>
                                                        }
                                                        @if (coDanhGia)
                                                        {
                                                            string danhGiaText = "";
                                                            string danhGiaClass = "";
                                                            switch (item.DanhGiaChung)
                                                            {
                                                                case 0:
                                                                    danhGiaText = "Tạm dừng";
                                                                    danhGiaClass = "bg-secondary";
                                                                    break;
                                                                case 1:
                                                                    danhGiaText = "Đạt tiến độ";
                                                                    danhGiaClass = "bg-success";
                                                                    break;
                                                                case 2:
                                                                    danhGiaText = "Chậm tiến độ";
                                                                    danhGiaClass = "bg-danger";
                                                                    break;
                                                                case 3:
                                                                    danhGiaText = "Vượt tiến độ";
                                                                    danhGiaClass = "bg-info text-dark";
                                                                    break;
                                                            }
                                                            <div>
                                                                <span class="badge @danhGiaClass">
                                                                    @danhGiaText
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <!-- Column 6: Actions -->
                                            <div class="col-12 col-sm-6 col-md-12 col-lg-3">
                                                <div class="d-flex gap-2 justify-content-lg-end justify-content-start">

                                                    <!-- Nút Xem (giữ nguyên) -->
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm flex-fill flex-lg-grow-0 btn-view-modal"
                                                            data-budget-id="@item.BudgetRegistrationId"
                                                            data-is-phan-nhiem="@item.IsPhanNhiemUser.ToString().ToLower()"
                                                            title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i> Xem chi tiết
                                                    </button>

                                                    <!-- *** THÊM MỚI: Nút Xóa ***
             Hiển thị nếu: Admin/Manager (mọi trạng thái)
             HOẶC user thường là chủ hồ sơ + chưa xác nhận luồng
            -->
                                                    @{
                                                        var currentUser = ViewBag.CurrentUser
                                                            as QuanLyNganSach.Models.Auth.LoggedInUser;
                                                        bool isManagerOrAdmin =
                                                            ViewBag.IsManagerOrAdmin == true;
                                                        bool canDelete = isManagerOrAdmin
                                                            || (item.UserId == currentUser?.UserId
                                                             && item.WorkflowType == null);
                                                    }
                                                    @if (canDelete)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-danger btn-sm flex-fill flex-lg-grow-0 btn-delete"
                                                                data-budget-id="@item.BudgetRegistrationId"
                                                                data-ten-hang-muc="@item.TenHangMuc"
                                                                title="Xóa hồ sơ">
                                                            <i class="bi bi-trash"></i> Xóa
                                                        </button>
                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card left border indicator -->
                                    <div class="position-absolute top-0 start-0 h-100 bg-primary" style="width: 4px;"></div>
                                </div>
                                cardIndex++;
                            }
                        </div>
                    }
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="card-footer bg-light py-3">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Hiển thị @Model.Count / @Model.TotalItemCount đăng ký
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-clock-history"></i>
                                    Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-6">
                                <div class="pagination-wrapper">
                                    @if (Model.PageCount > 1)
                                    {
                                        @* Khai báo routeValues dùng chung cho toàn bộ các link *@
                                        {
                                            var pgRoute = new
                                            {
                                                search = ViewBag.CurrentSearch,
                                                sortOrder = ViewBag.CurrentSort,
                                                phongBanId = ViewBag.CurrentPhongBanId,
                                                filterTienDo = ViewBag.CurrentFilterTienDo,
                                                filterTrangThai = ViewBag.CurrentFilterTrangThai
                                            };
                                        }

                                        <nav aria-label="Phân trang">
                                            <ul class="pagination pagination-sm mb-0
                           justify-content-center justify-content-md-end">

                                                <!-- First page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                           page             = 1,
                                                           search           = ViewBag.CurrentSearch,
                                                           sortOrder        = ViewBag.CurrentSort,
                                                           phongBanId       = ViewBag.CurrentPhongBanId,
                                                           filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                           filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                        })">Đầu
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Đầu</span>
                                                    }
                                                </li>

                                                <!-- Previous page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                           page             = Model.PageNumber - 1,
                                                           search           = ViewBag.CurrentSearch,
                                                           sortOrder        = ViewBag.CurrentSort,
                                                           phongBanId       = ViewBag.CurrentPhongBanId,
                                                           filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                           filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                        })">Trước
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Trước</span>
                                                    }
                                                </li>

                                                <!-- Page numbers -->
                                                @{
                                                    int startPage = Math.Max(1, Model.PageNumber - 2);
                                                    int endPage = Math.Min(Model.PageCount, Model.PageNumber + 2);
                                                    if (Model.PageNumber <= 3)
                                                    {
                                                        endPage = Math.Min(5, Model.PageCount);
                                                    }
                                                    if (Model.PageNumber >= Model.PageCount - 2)
                                                    {
                                                        startPage = Math.Max(1, Model.PageCount - 4);
                                                    }
                                                }
                                                @for (int i = startPage; i <= endPage; i++)
                                                {
                                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                        @if (i == Model.PageNumber)
                                                        {
                                                            <span class="page-link">@i</span>
                                                        }
                                                        else
                                                        {
                                                            <a class="page-link"
                                                               href="@Url.Action("Index", new {
                                                                   page             = i,
                                                                   search           = ViewBag.CurrentSearch,
                                                                   sortOrder        = ViewBag.CurrentSort,
                                                                   phongBanId       = ViewBag.CurrentPhongBanId,
                                                                   filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                                   filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                               })">@i
                                                            </a>
                                                        }
                                                    </li>
                                                }

                                                <!-- Next page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                           page             = Model.PageNumber + 1,
                                                           search           = ViewBag.CurrentSearch,
                                                           sortOrder        = ViewBag.CurrentSort,
                                                           phongBanId       = ViewBag.CurrentPhongBanId,
                                                           filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                           filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                        })">Sau
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Sau</span>
                                                    }
                                                </li>

                                                <!-- Last page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                           page             = Model.PageCount,
                                                           search           = ViewBag.CurrentSearch,
                                                           sortOrder        = ViewBag.CurrentSort,
                                                           phongBanId       = ViewBag.CurrentPhongBanId,
                                                           filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                           filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                        })">Cuối
                                                    </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Cuối</span>
                                                    }
                                                </li>

                                            </ul>
                                        </nav>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- ===== MODAL CHI TIẾT HỒ SƠ ===== -->
<div class="modal fade" id="budgetDetailsModal" tabindex="-1"
     aria-labelledby="budgetDetailsModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header text-bg-primary">
                <h5 class="modal-title" id="budgetDetailsModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Chi tiết hồ sơ ngân sách
                    @*<span class="badge bg-light text-primary ms-2 fs-6"
                        id="modalMaHangMuc"></span>*@
                    <span class="badge bg-light text-primary ms-2 fs-6"
                          id="modalMaHangMuc"
                          style="display:none;">
                    </span>
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                <!-- Loading spinner -->
                <div id="modalLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Đang tải dữ liệu...</p>
                </div>

                <!-- Nội dung modal (ẩn khi đang load) -->
                <div id="modalContent" style="display:none;">

                    <!-- TAB NAVIGATION -->
                    <ul class="nav nav-tabs mb-4" id="detailTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="detail-phieu-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-phieu"
                                    type="button" role="tab">
                                <i class="bi bi-file-earmark-text me-1"></i>Phiếu đăng ký
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="detail-phannhiem-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-phannhiem"
                                    type="button" role="tab">
                                <i class="bi bi-people me-1"></i>Phân nhiệm
                                <span id="modalPhanNhiemCount"
                                      class="badge bg-secondary ms-1">0</span>
                            </button>
                        </li>
                        <li class="nav-item d-none" id="tabPheDuyetItem" role="presentation">
                            <button class="nav-link" id="detail-pheduyet-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-pheduyet"
                                    type="button" role="tab">
                                <i class="bi bi-check2-circle me-1"></i>Phê duyệt
                            </button>
                        </li>
                        <li class="nav-item d-none" id="tabNhatKyItem" role="presentation">
                            <button class="nav-link" id="detail-nhatky-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-nhatky"
                                    type="button" role="tab">
                                <i class="bi bi-journal-text me-1"></i>Nhật ký tiến độ
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="detailTabsContent">

                        <!-- ===== TAB 1: PHIẾU ĐĂNG KÝ (READONLY) ===== -->
                        <div class="tab-pane fade show active"
                             id="detail-phieu" role="tabpanel">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Khu vực dự án
                                    </label>
                                    <select class="form-select" id="modal_AreaName" disabled>
                                        <option value="">-- Chưa chọn --</option>
                                        @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.DsKhuVucModal)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Bộ phận
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenPhongBan" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Mã hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_MaHangMuc" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Tên hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenHangMuc" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Dự toán
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_DuToan" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Số tờ trình
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_SoToTrinh" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Loại hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_CategoryTypeName" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Mức ưu tiên
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_PriorityLevelName" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Số lượng
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_SoLuong" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Ngày bắt đầu
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_NgayBatDau" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Ngày kết thúc
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_NgayKetThuc" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Người đăng ký
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenNguoiDangKy" readonly />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Lý do đầu tư
                                </label>
                                <textarea class="form-control" id="modal_LyDoDauTu"
                                          rows="3" readonly></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Mô tả kỹ thuật
                                </label>
                                <textarea class="form-control" id="modal_MoTaKyThuat"
                                          rows="3" readonly></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Link tài liệu liên quan
                                </label>
                                <input type="text" class="form-control"
                                       id="modal_LinkTaiLieu" readonly />
                            </div>

                            <!-- Attachments -->
                            <div id="modal_AttachmentsSection">
                                <label class="form-label fw-semibold text-muted small">
                                    <i class="bi bi-paperclip me-1"></i>Hồ sơ đính kèm
                                </label>
                                <div id="modal_AttachmentsList"
                                     class="border rounded p-2 bg-light"></div>
                            </div>
                        </div>

                        <!-- ===== TAB 2: PHÂN NHIỆM (EDITABLE) ===== -->
                        <div class="tab-pane fade"
                             id="detail-phannhiem" role="tabpanel">
                            <div class="d-flex justify-content-between
                                        align-items-center mb-3">
                                <h6 class="fw-semibold mb-0">
                                    <i class="bi bi-people-fill me-1"></i>
                                    Danh sách phân nhiệm
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            id="btnModalThemDong">
                                        <i class="bi bi-plus-circle me-1"></i>Thêm dòng
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            id="btnHuySearchPhanNhiem"
                                            style="display:none;">
                                        <i class="bi bi-x-circle"></i> Hủy tìm kiếm
                                    </button>
                                </div>
                            </div>
                            <!-- *** THÊM MỚI: Search + Filter Phân nhiệm *** -->
                            <div class="row g-2 mb-3" id="phanNhiemFilterRow">

                                <!-- Search tên nhân viên -->
                                <div class="col-md-4">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">
                                            <i class="bi bi-search"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control"
                                               id="pn_SearchTen"
                                               placeholder="Tìm theo tên nhân viên..." />
                                    </div>
                                </div>

                                <!-- Filter Bộ phận -->
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm"
                                            id="pn_FilterPhongBan">
                                        <option value="">-- Tất cả bộ phận --</option>
                                        @foreach (SelectListItem item in
                                            (IEnumerable<SelectListItem>)ViewBag.DsKhuVucModal)
                                        {
                                            <!-- Dùng DsPhongBanModal thay vì DsKhuVucModal -->
                                        }
                                    </select>
                                </div>

                                <!-- Filter Chức năng/Nhiệm vụ -->
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm"
                                            id="pn_FilterChucNang">
                                        <option value="">-- Tất cả chức năng --</option>
                                    </select>
                                </div>

                                <!-- Nút reset -->
                                <div class="col-md-2">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm w-100"
                                            id="btnResetPhanNhiemFilter">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                                    </button>
                                </div>

                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover
                                              align-middle" id="tblModalPhanNhiem">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:5%">#</th>
                                            <th style="width:22%">
                                                Tên Bộ phận
                                                <span class="text-danger">*</span>
                                            </th>
                                            <th style="width:22%">Nhân viên <span class="text-danger">*</span></th>
                                            <th style="width:25%">
                                                Chức năng / Nhiệm vụ
                                                <span class="text-danger">*</span>
                                            </th>
                                            <th style="width:20%">Email liên hệ <span class="text-danger">*</span></th>
                                            <th style="width:22%">Ghi chú</th>
                                            <th style="width:6%"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="modalPhanNhiemBody"></tbody>
                                </table>
                            </div>
                            <p class="text-muted small mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Chọn chức năng từ danh sách hoặc nhập trực tiếp
                                vào ô bên dưới nếu không có trong danh sách.
                            </p>
                        </div>

                        <!-- ===== TAB 3: PHÊ DUYỆT (PLACEHOLDER) ===== -->
                        <div class="tab-pane fade"
                             id="detail-pheduyet" role="tabpanel">
                            <!-- 2 CARD TỔNG HỢP -->
                            <div class="row g-3 mb-3">

                                <!-- Card Đang trình -->
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
                                        <div class="card-body py-3">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="text-muted small mb-1">
                                                        <i class="bi bi-hourglass-split me-1"></i>
                                                        Tổng ngân sách đang trình
                                                    </p>
                                                    <h5 class="fw-bold text-warning mb-0"
                                                        id="card_TongDangTrinh">
                                                        0 ₫
                                                    </h5>
                                                </div>
                                                <div class="bg-warning bg-opacity-10 rounded p-2">
                                                    <i class="bi bi-clock text-warning fs-5"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Đã duyệt -->
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                                        <div class="card-body py-3">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="text-muted small mb-1">
                                                        <i class="bi bi-check-circle me-1"></i>
                                                        Tổng ngân sách đã duyệt
                                                    </p>
                                                    <h5 class="fw-bold text-success mb-0"
                                                        id="card_TongDaDuyet">
                                                        0 ₫
                                                    </h5>
                                                </div>
                                                <div class="bg-success bg-opacity-10 rounded p-2">
                                                    <i class="bi bi-check2-circle text-success fs-5"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <!-- CARD NGÂN SÁCH GỐC -->
                            <div class="card border-primary mb-3" id="cardNganSachGoc">
                                <div class="card-header bg-primary text-white d-flex
                    justify-content-between align-items-center py-2">
                                    <span class="fw-semibold">
                                        <i class="bi bi-wallet2 me-1"></i>Ngân sách gốc
                                    </span>
                                    <!-- Dropdown Khởi tạo quy trình — chỉ Admin/Manager -->
                                    <div id="processTypeSection" style="display:none;">
                                        <select class="form-select form-select-sm w-auto"
                                                id="pd_ProcessType" style="min-width:200px;">
                                            <option value="1">Theo QT Tập đoàn</option>
                                            <option value="2">Theo QT Công ty</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="card-body">

                                    <!-- TIẾN ĐỘ DUYỆT -->
                                    <h6 class="fw-semibold text-muted mb-3">
                                        <i class="bi bi-calendar-check me-1"></i>Tiến độ duyệt
                                    </h6>
                                    <div class="row g-3 mb-4" id="tienDoDuyetRow">

                                        <!-- PDA -->
                                        <div class="col-md-2 col-sm-4">
                                            <label class="form-label small fw-semibold">PDA</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetPDA" data-moc="PDA" />
                                        </div>

                                        <!-- PKT -->
                                        <div class="col-md-2 col-sm-4">
                                            <label class="form-label small fw-semibold">PKT</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetPKT" data-moc="PKT"
                                                   data-requires="pd_NgayDuyetPDA" disabled />
                                        </div>

                                        <!-- ERPD — chỉ hiện khi ProcessType = 1 -->
                                        <div class="col-md-2 col-sm-4 moc-tapDoan" style="display:none;">
                                            <label class="form-label small fw-semibold">ERPD</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetERPD" data-moc="ERPD"
                                                   data-requires="pd_NgayDuyetPKT" disabled />
                                        </div>

                                        <!-- BTC — chỉ hiện khi ProcessType = 1 -->
                                        <div class="col-md-2 col-sm-4 moc-tapDoan" style="display:none;">
                                            <label class="form-label small fw-semibold">BTC</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetBTC" data-moc="BTC"
                                                   data-requires="pd_NgayDuyetERPD" disabled />
                                        </div>

                                        <!-- BGĐ -->
                                        <div class="col-md-2 col-sm-4" id="colBGD">
                                            <label class="form-label small fw-semibold">BGĐ</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetBGD" data-moc="BGD"
                                                   data-requires-congty="pd_NgayDuyetPKT"
                                                   data-requires-tapDoan="pd_NgayDuyetBTC" disabled />
                                        </div>

                                    </div>

                                    <!-- NGÂN SÁCH PHÊ DUYỆT -->
                                    <h6 class="fw-semibold text-muted mb-3">
                                        <i class="bi bi-currency-exchange me-1"></i>Ngân sách phê duyệt
                                    </h6>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Dự toán gốc (VND)
                                            </label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_DuToanGoc" readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Ngân sách phê duyệt (VND)
                                            </label>
                                            <!-- *** THAY ĐỔI: bỏ input-group, bỏ button, thêm disabled mặc định *** -->
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_DuToanPheDuyet"
                                                   placeholder="Chưa có ngày duyệt BGĐ"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end">
                                            <span class="badge fs-6 p-2" id="badgeTrangThaiPheDuyet"></span>
                                        </div>
                                    </div>

                                    <!-- SỐ THÔNG BÁO + SỐ FM/IO -->
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Số thông báo</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoThongBao" placeholder="Nhập số thông báo" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Số FM/IO</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoFMIO" placeholder="Nhập số FM/IO" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- CONTAINER CÁC CARD BỔ SUNG (render động) -->
                            <div id="containerBoSung"></div>

                            <!-- BUTTON THÊM BỔ SUNG -->
                            <div class="d-flex justify-content-start mb-3">
                                <button type="button" class="btn btn-outline-success btn-sm"
                                        id="btnThemBoSung">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm bổ sung ngân sách
                                </button>
                            </div>
                        </div>

                        <!-- ===== TAB 4: NHẬT KÝ TIẾN ĐỘ (PLACEHOLDER) ===== -->
                        <div class="tab-pane fade" id="detail-nhatky" role="tabpanel">

                            <!-- VÙNG 1: THÔNG TIN TỔNG QUAN TIẾN ĐỘ -->
                            <div class="row g-3 mb-4" id="tongQuanTienDo">
                                <div class="col">
                                    <div class="card text-center border-primary h-100">
                                        <div class="card-header bg-primary text-white small fw-semibold py-1">
                                            TỔNG TIẾN ĐỘ
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="fs-4 fw-bold text-primary" id="td_TongTienDo">0%</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-success h-100">
                                        <div class="card-header bg-success text-white small fw-semibold py-1">
                                            XÂY DỰNG <br />
                                            <span class="badge bg-white text-success ms-1"
                                                  id="badge_TiTrong_XayDung">0%</span>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="fs-4 fw-bold text-success" id="td_XayDung">0%</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-warning h-100">
                                        <div class="card-header bg-warning text-dark small fw-semibold py-1">
                                            KẾT CẤU THÉP <br />
                                            <span class="badge bg-white text-warning ms-1"
                                                  id="badge_TiTrong_KetCauThep">0%</span>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="fs-4 fw-bold text-warning" id="td_KetCauThep">0%</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-info h-100">
                                        <div class="card-header bg-info text-dark small fw-semibold py-1">
                                            LẮP ĐẶT THIẾT BỊ <br />
                                            <span class="badge bg-white text-info ms-1"
                                                  id="badge_TiTrong_LapDatThietBi">0%</span>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="fs-4 fw-bold text-info" id="td_LapDatThietBi">0%</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-secondary h-100">
                                        <div class="card-header bg-secondary text-white small fw-semibold py-1">
                                            HẠNG MỤC KHÁC <br />
                                            <span class="badge bg-white text-secondary ms-1"
                                                  id="badge_TiTrong_HangMucKhac">0%</span>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="fs-4 fw-bold text-secondary" id="td_HangMucKhac">0%</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- VÙNG 2: CẤU HÌNH TỈ TRỌNG -->
                            <div class="card border-0 bg-light mb-4">
                                <div class="card-body py-3">
                                    <h6 class="fw-semibold mb-3">
                                        <i class="bi bi-sliders me-1"></i>Cấu hình tỉ trọng (%)
                                    </h6>
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold text-success">Xây dựng</label>
                                            <input type="number" class="form-control form-control-sm ti-trong"
                                                   id="cfg_XayDung" min="0" max="100" step="0.01"
                                                   placeholder="0" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold text-warning">Kết cấu thép</label>
                                            <input type="number" class="form-control form-control-sm ti-trong"
                                                   id="cfg_KetCauThep" min="0" max="100" step="0.01"
                                                   placeholder="0" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold text-info">Lắp đặt thiết bị</label>
                                            <input type="number" class="form-control form-control-sm ti-trong"
                                                   id="cfg_LapDatThietBi" min="0" max="100" step="0.01"
                                                   placeholder="0" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold text-secondary">Hạng mục khác</label>
                                            <input type="number" class="form-control form-control-sm ti-trong"
                                                   id="cfg_HangMucKhac" min="0" max="100" step="0.01"
                                                   placeholder="0" />
                                        </div>
                                        <div class="col-md-2 d-flex align-items-end">
                                            <div>
                                                <label class="form-label small fw-semibold text-primary">Tổng</label>
                                                <div class="fw-bold fs-5" id="cfg_TongTiTrong">
                                                    <span class="text-secondary">0%</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">Đánh giá chung</label>
                                            <select class="form-select form-select-sm" id="cfg_DanhGiaChung">
                                                <option value="">-- Chọn đánh giá --</option>
                                                <option value="0">Tạm dừng</option>
                                                <option value="1">Đạt tiến độ</option>
                                                <option value="2">Chậm tiến độ</option>
