            function _showToast(success, message) {
                var $toast = $('#nk-toast');
                $toast.removeClass('bg-success bg-danger')
                    .addClass(success ? 'bg-success' : 'bg-danger');
                $('#nk-toast-body').text(message);
                new bootstrap.Toast($toast[0], { delay: 3000 }).show();
            }

            // Thêm hàm reset
            function reset() {
                _initializedId = null;
            }

            // Thêm vào trước phần return { init, reset } ở cuối file

            function collectProgressLog() {
                var areas = [];

                $('#nk-vung2 .nk-kv-wrapper').each(function () {
                    var $kv = $(this);
                    var items = [];

                    $kv.find('tbody tr').each(function (idx) {
                        var $tr = $(this);
                        var $select = $tr.find('.inp-hangmuc-select');
                        var $manual = $tr.find('.inp-hangmuc-manual');
                        var $inpTxt = $tr.find('.inp-hangmuc:not(.inp-hangmuc-manual)');
                        var tenHangMuc = '';
                        var workItemId = null;

                        if ($select.length && $select.is(':visible')) {
                            // THÊM MỚI: bỏ qua nếu dropdown chưa chọn
                            if (!$select.val() || $select.val() === '') return;
                            workItemId = parseInt($select.val()) || null;
                            tenHangMuc = $select.find('option:selected').text();
                        } else if ($manual.length && $manual.is(':visible')) {
                            tenHangMuc = $manual.val();
                        } else {
                            tenHangMuc = $inpTxt.val();
                        }

                        items.push({
                            WorkItemId: workItemId,
                            TenHangMuc: tenHangMuc,
                            DonViTinh: $tr.find('.inp-dvt').val(),
                            KLKeHoach: parseFloat($tr.find('.inp-klkh').val()) || 0,
                            KLThucTe: parseFloat($tr.find('.inp-kltt').val()) || 0,
                            PhanTram: parseFloat($tr.find('.row-pct').text()) || 0,
                            NgayBatDauKH: $tr.find('.inp-date-bd').val() || null,
                            NgayKetThucKH: $tr.find('.inp-date-kt').val() || null,
                            GhiChu: $tr.find('.inp-ghichu').val(),
                            SortOrder: idx
                        });
                    });

                    areas.push({
                        TenKhuVuc: $kv.find('.kv-name-input').val(),
                        TienDo: parseFloat($kv.find('.kv-pct-badge').text()) || 0,
                        Items: items
                    });
                });

                return {
                    BudgetRegistrationId: currentBudgetId,
                    DanhGiaChung: $('#nk-danhgia').val(),
                    LuuY: $('#nk-luuy').val(),
                    TongTienDo: parseFloat($('#nk-total-pct').text()) || 0,
                    Areas: areas
                };
            }

            // Cập nhật _saveProgress() để dùng lại collectProgressLog()
            function _saveProgress() {
                var payload = collectProgressLog();

                $('#btn-save-progress').prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i>Đang lưu...');

                $.ajax({
                    url: '/Budget/SaveProgressLog',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) { _showToast(res.success, res.message); },
                    error: function () { _showToast(false, 'Lỗi kết nối, vui lòng thử lại.'); },
                    complete: function () {
                        $('#btn-save-progress').prop('disabled', false)
                            .html('<i class="bi bi-save me-1"></i>Lưu tiến độ');
                    }
                });
            }

            function _applyRowLock($tr, locked) {
                $tr.find(
                    '.inp-dvt, .inp-klkh, .inp-kltt, .inp-date-bd, .inp-date-kt, .inp-ghichu, ' +
                    '.inp-hangmuc, .inp-hangmuc-select, .inp-hangmuc-manual, .btn-remove-row'
                ).prop('disabled', locked);
                $tr.toggleClass('nk-row-locked', locked);
            }

            function _refreshRowLocks($kv) {
                var $rows = $kv.find('tbody tr');
                var prevComplete = true; // dòng đầu tiên luôn được nhập

                $rows.each(function (idx) {
                    var $tr = $(this);

                    if (idx === 0) {
                        // Dòng đầu luôn unlock
                        _applyRowLock($tr, false);
                        // Kiểm tra dòng đầu có đạt 100% chưa để quyết định dòng tiếp theo
                        var pct = parseFloat($tr.find('.row-pct').text()) || 0;
                        prevComplete = (pct >= 100);
                    } else {
                        _applyRowLock($tr, !prevComplete);
                        if (prevComplete) {
                            var pct = parseFloat($tr.find('.row-pct').text()) || 0;
                            prevComplete = (pct >= 100);
                        }
                        // Nếu dòng trước chưa 100% thì tất cả dòng sau đều locked
                    }
                });
            }

            // Cập nhật public API
            return {
                init: init,
                reset: reset,
                collectProgressLog: collectProgressLog  // THÊM MỚI: expose ra ngoài
            };
        })(jQuery);
    </script>
