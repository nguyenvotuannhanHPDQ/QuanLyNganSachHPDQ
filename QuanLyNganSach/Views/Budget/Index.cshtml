                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Ngày kết thúc
                                    </label>
                                    @*<input type="text" class="form-control"
                                        id="modal_NgayKetThuc" />*@
                                    <input type="date" class="form-control" id="modal_NgayKetThuc" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Người đăng ký
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenNguoiDangKy" disabled />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Lý do đầu tư
                                </label>
                                <select class="form-select" id="modal_InvestmentReasonId">
                                    <option value="">-- Chọn lý do đầu tư --</option>
                                    @if (ViewBag.DsInvestmentReasons != null)
                                    {
                                        foreach (var item in (IEnumerable<SelectListItem>)ViewBag.DsInvestmentReasons)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3" id="modal_divLyDoNhapTay" style="display: none;">
                                <label class="form-label fw-semibold text-primary small">
                                    <i class="bi bi-pencil-square me-1"></i>Lý do đầu tư (điền thủ công)
                                </label>
                                <textarea class="form-control" id="modal_LyDoDauTu" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Mô tả kỹ thuật
                                </label>
                                <textarea class="form-control" id="modal_MoTaKyThuat"
                                          rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Link tài liệu liên quan
                                </label>
                                <input type="text" class="form-control"
                                       id="modal_LinkTaiLieu" />
                            </div>

                            <!-- Attachments -->
                            <div id="modal_AttachmentsSection">
                                <label class="form-label fw-semibold text-muted small">
                                    <i class="bi bi-paperclip me-1"></i>Hồ sơ đính kèm
                                </label>
                                <div id="modal_AttachmentsList"
                                     class="border rounded p-2 bg-light"></div>
                                <!-- Chỉ hiện khi hồ sơ ở trạng thái Trả hồ sơ -->
                                <div id="revisionFileSection" class="mt-2" style="display:none;">
                                    <label class="form-label fw-semibold text-muted small">
                                        <i class="bi bi-upload me-1"></i>Upload hồ sơ mới
                                    </label>
                                    <div class="text-danger small fst-italic mb-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Lưu ý: Các file cũ sẽ bị xóa khi upload file mới.
                                    </div>
                                    <!-- SỬA: thêm multiple -->
                                    <input type="file" class="form-control" id="revisionFileInput"
                                           multiple
                                           accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.png" />
                                    <div class="form-text text-muted small">
                                        Cho phép chọn nhiều file.
                                    </div>
                                </div>
                            </div>
                            <!-- Textarea lý do chỉnh sửa — thêm vào tab Phiếu đăng ký -->
