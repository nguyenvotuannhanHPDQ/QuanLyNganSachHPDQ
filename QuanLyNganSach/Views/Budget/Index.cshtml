            <!-- FOOTER -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
                <button type="button" class="btn btn-primary" id="btnSaveDetailsModal">
                    <i class="bi bi-save me-1"></i>Lưu thông tin
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Khai báo ở đầu section Scripts
            var currentUserIdGlobal = @(ViewBag.CurrentUserId ?? 0);

            var isPhanNhiemSearchMode = false;

            // Search on input with debounce
            var searchTimeout;
            $('#searchInput').on('keyup', function (e) {
                // Don't submit on Enter key here (handled separately)
                if (e.which === 13) {
                    return;
                }

                clearTimeout(searchTimeout);
                var searchValue = $(this).val(); // Capture value

                searchTimeout = setTimeout(function () {
                    // Ensure value is set before submit
                    $('#searchInput').val(searchValue);
                    $('#searchForm').submit();
                }, 500); // Wait 500ms after user stops typing
            });

            // Filter by status - submit form immediately
            $('input[name="status"]').on('change', function () {
                $('#searchForm').submit();
            });

            // Auto-submit when department filter changes (for Manager/Admin)
            $('#phongBanId, #filterTienDo, #filterTrangThai').on('change', function () {
                $('#searchForm').submit();
            });

            // Clear search button
            $('#clearSearch').on('click', function () {
                $('#searchInput').val('');
                $('#searchForm').submit();
            });

            // Handle Enter key explicitly
            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    clearTimeout(searchTimeout); // Cancel debounce
                    $('#searchForm').submit();
                }
            });

            // Auto-submit when sort order changes
            $('#sortOrder').on('change', function () {
                var sortValue = $(this).val();
                var currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('sortOrder', sortValue);
                currentUrl.searchParams.delete('page'); // Reset về trang 1
                window.location.href = currentUrl.toString();
            });

            function getFileIcon(extension) {
                if (!extension) return 'text';
                extension = extension.toLowerCase().replace('.', '');

                var icons = {
                    'pdf': 'pdf text-danger',
                    'doc': 'word text-primary',
                    'docx': 'word text-primary',
                    'xls': 'excel text-success',
                    'xlsx': 'excel text-success',
                    'ppt': 'ppt text-warning',
                    'pptx': 'ppt text-warning',
                    'jpg': 'image text-info',
                    'jpeg': 'image text-info',
                    'png': 'image text-info',
                    'gif': 'image text-info',
                    'zip': 'zip text-secondary',
                    'rar': 'zip text-secondary'
                };

                return icons[extension] || 'text';
            }

            // Dữ liệu dropdown dùng cho tab Phân nhiệm trong modal
            var dsPhongBan = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DsPhongBanModal));
            var dsChucNang = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DsChucNangModal));

            var currentBudgetId = 0;
            var modalRowIndex = 0;

            var isPhanNhiemUserGlobal = false;

            var originalPhanNhiemList;

            // ── Mở modal khi click nút Xem ──────────────────────────────
            $(document).on('click', '.btn-view-modal', function () {
                currentBudgetId = $(this).data('budget-id');
                isPhanNhiemUserGlobal = $(this).data('is-phan-nhiem') === true;
                modalRowIndex   = 0;

                // Reset về trạng thái loading
                $('#modalLoading').show();
                $('#modalContent').hide();
                //$('#detail-phieu-btn').tab('show');

                var tabEl = document.querySelector('#detail-phieu-btn');
                if (tabEl) {
                    var tab = new bootstrap.Tab(tabEl);
                    tab.show();
                }

                // Modal Bootstrap 5 cũng nên dùng JS API
                var modal = new bootstrap.Modal(document.getElementById('budgetDetailsModal'));
                modal.show();

                //$('#budgetDetailsModal').modal('show');
                loadDetailsModal(currentBudgetId);
            });

            // ── Gọi API GetDetailsModal ──────────────────────────────────
            function loadDetailsModal(id) {
                currentBudgetId = id;
                modalRowIndex = 0;

                // Reset về trạng thái loading
                $('#modalLoading').show();
                $('#modalContent').hide();
                $('#detail-phieu-btn').tab('show');

                // *** THÊM MỚI: Reset 2 card tổng hợp về 0
                // tránh hiển thị dữ liệu của hồ sơ trước ***
                $('#card_TongDangTrinh').text('0 ₫');
                $('#card_TongDaDuyet').text('0 ₫');

                $('#budgetDetailsModal').modal('show');

                $('#pn_SearchTen').val('');
                $('#pn_FilterPhongBan').val('');
                $('#pn_FilterChucNang').val('');

                $.ajax({
                    url: '@Url.Action("GetDetailsModal", "Budget")',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (!res.success) {
                            alert(res.message);
                            $('#budgetDetailsModal').modal('hide');
                            return;
                        }
                        bindModalData(res.data);
                        $('#modalLoading').hide();
                        $('#modalContent').show();
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi khi tải dữ liệu.');
                        $('#budgetDetailsModal').modal('hide');
                    }
                });
            }

            var isManagerOrAdminGlobal = false;

            // ── Bind dữ liệu vào các field ──────────────────────────────
            function bindModalData(data) {

                isManagerOrAdminGlobal = data.IsManagerOrAdmin;

                // Header
                //$('#modalMaHangMuc').text(data.MaHangMuc);
                // *** THAY ĐỔI: Ẩn/hiện MaHangMuc theo giá trị ***
                if (data.MaHangMuc) {
                    $('#modalMaHangMuc').text(data.MaHangMuc).show();
                    $('#modal_MaHangMuc').closest('.col-md-4').show();
                } else {
                    $('#modalMaHangMuc').text('').hide();
                    $('#modal_MaHangMuc').closest('.col-md-4').hide();
                }

                // Tab Phiếu đăng ký
                $('#modal_AreaName').val(data.ProjectAreaId);
                $('#modal_TenPhongBan').val(data.TenPhongBan);
                $('#modal_MaHangMuc').val(data.MaHangMuc);
                $('#modal_TenHangMuc').val(data.TenHangMuc);
                $('#modal_DuToan').val(formatCurrency(data.DuToan));
                $('#modal_SoToTrinh').val(data.SoToTrinh);
                $('#modal_CategoryTypeName').val(data.CategoryTypeName);
                $('#modal_PriorityLevelName').val(data.PriorityLevelName);
                $('#modal_SoLuong').val(data.SoLuong);
                $('#modal_NgayBatDau').val(formatDate(data.NgayBatDau));
                $('#modal_NgayKetThuc').val(formatDate(data.NgayKetThuc));
                $('#modal_TenNguoiDangKy').val(data.TenNguoiDangKy);
                $('#modal_LyDoDauTu').val(data.LyDoDauTu);
                $('#modal_MoTaKyThuat').val(data.MoTaKyThuat);
                $('#modal_LinkTaiLieu').val(data.LinkTaiLieuLienQuan);

                // Attachments
                renderAttachments(data.Attachments);

                $('#containerBoSung').empty();

                // Workflow dropdown
                if (data.IsManagerOrAdmin) {
                    $('#workflowSection').show();
                    $('#modal_WorkflowType').val(data.WorkflowType || '');
                    applyWorkflowTabs(data.WorkflowType);
                } else {
                    $('#workflowSection').hide();
                    // *** THÊM MỚI: Chủ hồ sơ thấy tab Nhật ký nếu WorkflowType = 1 ***
                    applyWorkflowTabs(data.WorkflowType);
                }

                // Tab Phân nhiệm
                renderModalPhanNhiem(data.DanhSachPhanNhiem || []);

                originalPhanNhiemList = data.DanhSachPhanNhiem;

                // *** THÊM MỚI: Init dropdowns filter ***
                initPhanNhiemFilters();

                // *** THÊM MỚI — gọi bind tab Phê duyệt ***
                bindPheDuyetData(data.NganSachGoc, data.IsManagerOrAdmin);
                renderDanhSachBoSung(data.DanhSachBoSung);
                bindTienDoData(data.ThongTinTienDo);

                // *** THÊM MỚI: Xử lý quyền IsPhanNhiemUser ***
                var isPhanNhiem = data.IsPhanNhiemUser;

                // Ẩn DuToan trong tab Phiếu đăng ký
                if (isPhanNhiem) {
                    $('#modal_DuToan').closest('.col-md-4').hide();
                } else {
                    $('#modal_DuToan').closest('.col-md-4').show();
                }

                // Ẩn/hiện tab Phê duyệt
                if (isPhanNhiem) {
                    $('#tabPheDuyetItem').addClass('d-none');
                    // Nếu đang ở tab Phê duyệt thì về tab Phiếu
                    if ($('#detail-pheduyet').hasClass('active')) {
                        $('#detail-phieu-btn').tab('show');
                    }
                }

                // Tab Phân nhiệm — chỉ xem với user phân nhiệm
                $('#btnModalThemDong').toggle(!isPhanNhiem);
                if (isPhanNhiem) {
                    // Ẩn nút xóa dòng trong tab Phân nhiệm
                    $('#modalPhanNhiemBody').find('.btnModalXoaDong').hide();
                }
            }

            // ── Render Attachments ───────────────────────────────────────
            function renderAttachments(attachments) {
                var html = '';
                if (!attachments || attachments.length === 0) {
                    html = '<span class="text-muted small">Không có file đính kèm.</span>';
                } else {
                    $.each(attachments, function (i, a) {
                        html += '<div class="d-flex align-items-center gap-2 py-1 border-bottom">'
                            + '<i class="bi bi-file-earmark text-primary"></i>'
                            + '<a href="/' + a.FilePath + '" '
                            + 'download="' + a.FileName + '" '   // *** THÊM download ***
                            + 'class="text-truncate flex-fill">'
                            + a.FileName
                            + '</a>'
                            + '<span class="text-muted small">' + a.FileSizeFormatted + '</span>'
                            + '<span class="text-muted small">'
                            + formatDate(a.UploadedDate) + ' — ' + a.UploadedBy
                            + '</span>'
                            + '</div>';
                    });
                }
                $('#modal_AttachmentsList').html(html);
            }

            function applyWorkflowTabs(workflowType) {
                if (parseInt(workflowType) === 1) {
                    // *** THAY ĐỔI: Tab Phê duyệt chỉ hiện với Admin/Manager ***
                    if (isManagerOrAdminGlobal) {
                        $('#tabPheDuyetItem').removeClass('d-none');
                    }
                    $('#tabNhatKyItem').removeClass('d-none');
                } else {
                    $('#tabPheDuyetItem').addClass('d-none');
                    $('#tabNhatKyItem').addClass('d-none');
                    if ($('#detail-pheduyet').hasClass('active') ||
                        $('#detail-nhatky').hasClass('active')) {
                        //$('#detail-phieu-btn').tab('show');
                        var tabEl = document.querySelector('#detail-phieu-btn');
                        if (tabEl) {
                            var tab = new bootstrap.Tab(tabEl);
                            tab.show();
                        }
                    }
                }
            }

            // ── Lắng nghe thay đổi WorkflowType ─────────────────────────
            $(document).on('change', '#modal_WorkflowType', function () {
                applyWorkflowTabs($(this).val());
            });

            // ── Render tab Phân nhiệm từ dữ liệu có sẵn ─────────────────
            function renderModalPhanNhiem(list) {
                isPhanNhiemSearchMode = false; // *** THÊM ***
                $('#modalPhanNhiemBody').empty();
                modalRowIndex = 0;
                $.each(list, function (i, pn) {
                    var row = taoHtmlDongModal(modalRowIndex++);
                    var $row = $(row);

                    // Set giá trị dropdown Phòng ban
                    //$row.find('select[name*=PhongBanId]').val(pn.PhongBanId);
                    // Thay đoạn set giá trị trong renderModalPhanNhiem
                    // Sau khi set PhongBanId, load User tương ứng
                    var phongBanId = pn.PhongBanId;
                    var userId = pn.UserId;

                    $row.find('select[name*=PhongBanId]').val(phongBanId);

                    // Load user theo phòng ban và set selected
                    var $ddUser = $row.find('.dd-modal-user');
                    if (phongBanId) {
                        loadUsersByPhongBan(phongBanId, $ddUser, userId, pn.TenUser);
                    }

                    // Set dropdown Chức năng (nếu có Id)
                    if (pn.ChucNangNhiemVuId) {
                        $row.find('.ddModalChucNang').val(pn.ChucNangNhiemVuId);
                    }
                    // Set textbox nhập tay
                    $row.find('.txtModalChucNangTay').val(pn.TenChucNangNhapTay || '');

                    $row.find('input[name*=Email]').val(pn.Email || '');
                    $row.find('input[name*=GhiChu]').val(pn.GhiChu || '');

                    $('#modalPhanNhiemBody').append($row);

                    // Kích hoạt chosen cho select Phòng ban (vì nó đã có data sẵn)
                    $row.find('select[name*=PhongBanId]').chosen({ width: "100%" });
                    // select User sẽ được chosen kích hoạt bên trong hàm loadUsersByPhongBan
                });
                capNhatSTTModal();
            }

            // ── Tạo HTML 1 dòng Phân nhiệm trong modal ──────────────────
            function taoHtmlDongModal(idx) {
                var optionsPhongBan = '<option value="">-- Chọn --</option>';
                $.each(dsPhongBan, function (i, pb) {
                    optionsPhongBan += '<option value="' + pb.value + '">'
                                     + pb.text + '</option>';
                });

                var optionsChucNang = '<option value="">-- Chọn hoặc nhập tay --</option>';
                $.each(dsChucNang, function (i, cn) {
                    optionsChucNang += '<option value="' + cn.value + '">'
                                     + cn.text + '</option>';
                });

                return '<tr data-index="' + idx + '">'
                    + '<td class="text-center stt-modal"></td>'
                    + '<td>'
                    + '<select name="DanhSachPhanNhiem[' + idx + '].PhongBanId" '
                    +         'class="form-select form-select-sm" required>'
                    + optionsPhongBan + '</select>'
                    + '</td>'
                    // Thêm sau cột Phòng ban trong taoHtmlDongModal
                    + '<td>'
                    + '<select name="DanhSachPhanNhiem[' + idx + '].UserId" '
                    + 'class="form-select form-select-sm dd-modal-user" required>'
                    + '<option value="">-- Chọn nhân viên --</option>'
                    + '</select>'
                    + '</td>'
                    + '<td>'
                    + '<select name="DanhSachPhanNhiem[' + idx + '].ChucNangNhiemVuId" '
                    +         'class="form-select form-select-sm mb-1 ddModalChucNang">'
                    + optionsChucNang + '</select>'
                    + '<input type="text" '
                    +        'name="DanhSachPhanNhiem[' + idx + '].TenChucNangNhapTay" '
                    +        'class="form-control form-control-sm txtModalChucNangTay" '
                    +        'placeholder="Hoặc nhập tay tại đây..." />'
                    + '</td>'
                    + '<td>'
                    + '<input type="email" '
                    +        'name="DanhSachPhanNhiem[' + idx + '].Email" '
                    +        'class="form-control form-control-sm" '
                    +        'placeholder="email@example.com" />'
                    + '</td>'
                    + '<td>'
                    + '<input type="text" '
                    +        'name="DanhSachPhanNhiem[' + idx + '].GhiChu" '
                    +        'class="form-control form-control-sm" '
                    +        'placeholder="Ghi chú..." />'
                    + '</td>'
                    + '<td class="text-center">'
                    + '<button type="button" class="btn btn-danger btn-sm btnModalXoaDong">'
                    + '<i class="bi bi-trash"></i></button>'
                    + '</td>'
                    + '</tr>';
            }

            // ── Hàm load User theo PhongBanId (dùng chung cho cả 2 context) ──
            @*function loadUsersByPhongBan(phongBanId, $ddUser,
                                          selectedUserId, selectedText) {
                $ddUser.html('<option value="">Đang tải...</option>')
                       .prop('disabled', true);

                if (!phongBanId) {
                    $ddUser.html('<option value="">-- Chọn nhân viên --</option>')
                           .prop('disabled', false);
                    return;
                }

                $.ajax({
                    url:  '@Url.Action("GetUsersByPhongBan", "Budget")',
                    type: 'GET',
                    data: { phongBanId: phongBanId },
                    success: function (res) {
                        var options =
                            '<option value="">-- Chọn nhân viên --</option>';
                        if (res.success && res.data.length > 0) {
                            $.each(res.data, function (i, u) {
                                var selected = selectedUserId
                                    && u.value == selectedUserId
                                    ? 'selected' : '';
                                options += '<option value="' + u.value + '" '
                                         + selected + '>'
                                         + u.text + '</option>';
                            });
                        }
                        $ddUser.html(options).prop('disabled', false);
                    },
                    error: function () {
                        $ddUser.html('<option value="">-- Lỗi tải dữ liệu --</option>')
                               .prop('disabled', false);
                    }
                });
            }*@

            function loadUsersByPhongBan(phongBanId, $ddUser, selectedUserId, selectedText) {
                $ddUser.html('<option value="">Đang tải...</option>')
                       .prop('disabled', true)
                       .trigger("chosen:updated"); // Cập nhật trạng thái đang tải

                if (!phongBanId) {
                    $ddUser.html('<option value="">-- Chọn nhân viên --</option>')
                           .prop('disabled', false)
                           .trigger("chosen:updated");
                    return;
                }

                $.ajax({
                    url:  '@Url.Action("GetUsersByPhongBan", "Budget")',
                    type: 'GET',
                    data: { phongBanId: phongBanId },
                    success: function (res) {
                        var options = '<option value="">-- Chọn nhân viên --</option>';
                        if (res.success && res.data.length > 0) {
                            $.each(res.data, function (i, u) {
                                var selected = selectedUserId && u.value == selectedUserId ? 'selected' : '';
                                options += '<option value="' + u.value + '" ' + selected + '>' + u.text + '</option>';
                            });
                        }
                        // Sau khi đổ dữ liệu, kích hoạt hoặc cập nhật chosen
                        $ddUser.html(options).prop('disabled', false);

                        // Kích hoạt chosen nếu chưa có, hoặc cập nhật nếu đã có
                        if ($ddUser.next('.chosen-container').length > 0) {
                            $ddUser.trigger("chosen:updated");
                        } else {
                            $ddUser.chosen({ width: "100%" });
                        }
                    },
                    error: function () {
                        $ddUser.html('<option value="">-- Lỗi tải dữ liệu --</option>')
                               .prop('disabled', false)
                               .trigger("chosen:updated");
                    }
                });
            }

            // ── Modal: Load User khi đổi Phòng ban ───────────────────────
            $(document).on('change', '#modalPhanNhiemBody select[name*=PhongBanId]', function () {
                var phongBanId = $(this).val();
                var $ddUser = $(this).closest('tr').find('.dd-modal-user');
                loadUsersByPhongBan(phongBanId, $ddUser, null, null);
            });

            // ── Cập nhật STT + badge đếm dòng modal ─────────────────────
            function capNhatSTTModal() {
                var rows = $('#modalPhanNhiemBody tr');
                rows.each(function (i) {
                    $(this).find('.stt-modal').text(i + 1);
                });
                var count = rows.length;
                $('#modalPhanNhiemCount').text(count)
                    .toggleClass('bg-secondary', count === 0)
                    .toggleClass('bg-primary',   count > 0);
            }

            // ── Thêm dòng Phân nhiệm trong modal ────────────────────────
            $(document).on('click', '#btnModalThemDong', function () {
                if (isPhanNhiemSearchMode) {
                    alert("Bạn đang ở chế độ tìm kiếm. Vui lòng nhấn 'Hủy tìm kiếm' để có thể thêm mới hoặc chỉnh sửa dữ liệu.");
                    return;
                }
                var row = taoHtmlDongModal(modalRowIndex++);
                var $row = $(row);

                $('#modalPhanNhiemBody').append($row);

                // Kích hoạt chosen cho select Phòng ban của dòng vừa thêm
                $row.find('select[name*=PhongBanId]').chosen({ width: "100%" });

                capNhatSTTModal();
            });

            // ── Xóa dòng Phân nhiệm trong modal ─────────────────────────
            $(document).on('click', '.btnModalXoaDong', function () {
                $(this).closest('tr').remove();
                capNhatSTTModal();
            });

            // ── Validate tab Phân nhiệm trước khi lưu ────────────────────
            function validatePhanNhiem() {
                // *** THÊM MỚI: Bỏ qua validate khi đang ở search mode ***
                if (isPhanNhiemSearchMode) return true;

                var $rows = $('#modalPhanNhiemBody tr');

                // Chưa có dòng nào
                if ($rows.length === 0) {
                    showModalAlert('danger',
                        'Vui lòng thêm ít nhất một dòng phân nhiệm trước khi lưu.');
                    return false;
                }

                var isValid = true;
                var dongLoi = [];

                $rows.each(function (i) {
                    var $row = $(this);
                    var stt = i + 1;
                    var phongBan = $row.find('select[name*=PhongBanId]').val();
                    var userId = $row.find('.dd-modal-user').val();
                    var chucNang = $row.find('.ddModalChucNang').val();
                    var nhapTay = $row.find('.txtModalChucNangTay').val().trim();
                    var email = $row.find('input[name*=Email]').val().trim();

                    var loi = [];

                    if (!phongBan)
                        loi.push('Bộ phận');

                    if (!userId)
                        loi.push('Nhân viên');

                    if (!chucNang && !nhapTay)
                        loi.push('Chức năng / Nhiệm vụ');

                    if (!email)
                        loi.push('Email liên hệ');

                    if (loi.length > 0) {
                        dongLoi.push('Dòng ' + stt + ': thiếu ' + loi.join(', '));
                        isValid = false;
                    }
                });

                if (!isValid) {
                    showModalAlert('danger',
                        'Vui lòng điền đầy đủ thông tin bắt buộc ở tab Phân nhiệm:<br>'
                        + dongLoi.join('<br>'));
                }

                return isValid;
            }

            // ── Load dropdown filter khi modal mở ───────────────────────
            function initPhanNhiemFilters() {
                // Render dropdown Bộ phận từ dsPhongBan đã có
                var optionsPB = '<option value="">-- Tất cả bộ phận --</option>';
                $.each(dsPhongBan, function (i, pb) {
                    optionsPB += '<option value="' + pb.value + '">'
                               + pb.text + '</option>';
                });
                $('#pn_FilterPhongBan').html(optionsPB);

                // Render dropdown Chức năng từ dsChucNang đã có
                var optionsCN =
                    '<option value="">-- Tất cả chức năng --</option>';
                $.each(dsChucNang, function (i, cn) {
                    optionsCN += '<option value="' + cn.value + '">'
                               + cn.text + '</option>';
                });
                $('#pn_FilterChucNang').html(optionsCN);
            }

            // ── Gọi API SearchPhanNhiem ──────────────────────────────────
            function searchPhanNhiem() {
                if (!currentBudgetId) return;

                $.ajax({
                    url:  '@Url.Action("SearchPhanNhiem", "Budget")',
                    type: 'GET',
                    data: {
                        budgetRegistrationId: currentBudgetId,
                        search:      $('#pn_SearchTen').val().trim(),
                        phongBanId:  $('#pn_FilterPhongBan').val()  || null,
                        chucNangId:  $('#pn_FilterChucNang').val()  || null
                    },
                    success: function (res) {
                        if (!res.success) return;
                        isPhanNhiemSearchMode = true; // *** THÊM ***
                        $('#btnHuySearchPhanNhiem').show();
                        renderPhanNhiemReadonly(res.data);
                    }
                });
            }

            // ── Render bảng Phân nhiệm từ kết quả search ────────────────
            function renderPhanNhiemReadonly(data) {
                var $tbody = $('#modalPhanNhiemBody');
                $tbody.empty();

                if (!data || data.length === 0) {
                    $tbody.append(
                        '<tr><td colspan="7" class="text-center text-muted">'
                        + 'Không tìm thấy dữ liệu.</td></tr>');
                    // Cập nhật badge đếm
                    $('#modalPhanNhiemCount').text(0)
                        .removeClass('bg-primary').addClass('bg-secondary');
                    return;
                }

                $.each(data, function (i, pn) {
                    var chucNang = pn.TenChucNang || pn.TenChucNangNhapTay || '--';
                    var $tr = $(
                        '<tr>'
                        + '<td class="text-center stt-modal">' + (i + 1) + '</td>'
                        + '<td>' + (pn.TenPhongBan || '--') + '</td>'
                        + '<td>' + (pn.TenUser     || '--') + '</td>'
                        + '<td>' + chucNang + '</td>'
                        + '<td>' + (pn.Email  || '--') + '</td>'
                        + '<td>' + (pn.GhiChu || '--') + '</td>'
                        + '<td></td>'
                        + '</tr>');
                    $tbody.append($tr);
                });

                // Cập nhật badge đếm
                $('#modalPhanNhiemCount').text(data.length)
                    .removeClass('bg-secondary').addClass('bg-primary');
            }

            // ── Lắng nghe thay đổi filter ────────────────────────────────
            var searchTimer = null;
            $(document).on('input', '#pn_SearchTen', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(searchPhanNhiem, 400); // debounce
            });

            $(document).on('change',
                '#pn_FilterPhongBan, #pn_FilterChucNang',
                function () { searchPhanNhiem(); });

            // ── Nút đặt lại ──────────────────────────────────────────────
            $(document).on('click', '#btnResetPhanNhiemFilter', function () {
                $('#pn_SearchTen').val('');
                $('#pn_FilterPhongBan').val('');
                $('#pn_FilterChucNang').val('');
                searchPhanNhiem();
            });

            // ── Expose hàm init để gọi khi modal mở ─────────────────────
            window.initPhanNhiemFilters = initPhanNhiemFilters;
            window.searchPhanNhiem      = searchPhanNhiem;

            // ── Nút Lưu thông tin ────────────────────────────────────────
            $(document).on('click', '#btnSaveDetailsModal', function () {
                var $btn = $(this);

                if (!validatePhanNhiem()) return;

                var tongTiTrong = (parseFloat($('#cfg_XayDung').val()) || 0)
                    + (parseFloat($('#cfg_KetCauThep').val()) || 0)
                    + (parseFloat($('#cfg_LapDatThietBi').val()) || 0)
                    + (parseFloat($('#cfg_HangMucKhac').val()) || 0);

                if (Math.abs(tongTiTrong - 100) > 0.01 && tongTiTrong > 0) {
                    showModalAlert('danger',
                        'Tổng tỉ trọng đang là ' + tongTiTrong.toFixed(2)
                        + '%. Vui lòng điều chỉnh để tổng = 100% trước khi lưu.');
                    return;
                }

                // Thu thập dữ liệu Phân nhiệm từ các dòng trong bảng
                var danhSachPhanNhiem = [];
                if (!isPhanNhiemSearchMode) {
                    // *** Chỉ collect khi không ở search mode ***
                    $('#modalPhanNhiemBody tr').each(function () {
                        var $row = $(this);
                        var idx = $row.data('index');
                        var phongBanId = $row.find('select[name*=PhongBanId]').val();
                        if (!phongBanId) return; // bỏ dòng chưa chọn phòng ban

                        danhSachPhanNhiem.push({
                            PhongBanId: phongBanId,
                            UserId: $row.find('.dd-modal-user').val() || null,
                            ChucNangNhiemVuId: $row.find('.ddModalChucNang').val() || null,
                            TenChucNangNhapTay: $row.find('.txtModalChucNangTay').val() || null,
                            Email: $row.find('input[name*=Email]').val() || null,
                            GhiChu: $row.find('input[name*=GhiChu]').val() || null
                        });
                    });
                }

                var payload = {
                    BudgetRegistrationId: currentBudgetId,
                    WorkflowType:         $('#modal_WorkflowType').val() || null,
                    DanhSachPhanNhiem: danhSachPhanNhiem,
                    IsPhanNhiemSearchMode: isPhanNhiemSearchMode,

                    // Ngân sách gốc
                    NganSachGoc: {
                        BudgetRegistrationId: currentBudgetId,
                        ProcessType: parseInt($('#pd_ProcessType').val()) || 1,
                        NgayDuyetPDA: $('#pd_NgayDuyetPDA').val() || null,
                        NgayDuyetPKT: $('#pd_NgayDuyetPKT').val() || null,
                        NgayDuyetERPD: $('#pd_NgayDuyetERPD').val() || null,
                        NgayDuyetBTC: $('#pd_NgayDuyetBTC').val() || null,
                        NgayDuyetBGD: $('#pd_NgayDuyetBGD').val() || null,
                        DuToanPheDuyet: (function () {
                            var raw = $('#pd_DuToanPheDuyet').val()
                                .replace(/,/g, '').replace(/\./g, '');
                            return raw ? parseFloat(raw) : null;
                        })(),
                        SoThongBao: $('#pd_SoThongBao').val() || null,
                        SoFMIO: $('#pd_SoFMIO').val() || null,
                        IsSupplementary: false,
                        SupplementaryOrder: 0
                    },

                    // Thông tin tiến độ
                    ThongTinTienDo: collectTienDoData(),

                    // Danh sách đợt bổ sung
                    DanhSachBoSung: (function () {
                        var list = [];
                        $('#containerBoSung .card-bo-sung').each(function () {
                            var $card = $(this);
                            var idx = $card.data('index');
                            var rawNS = $('#bs_NganSach_' + idx).val()
                                .replace(/,/g, '').replace(/\./g, '');
                            list.push({
                                BudgetRegistrationId: currentBudgetId,
                                ProcessType: parseInt($card.find('.bs-ProcessType').val()) || 1,
                                NgayDuyetPDA: $('#bs_PDA_' + idx).val() || null,
                                NgayDuyetPKT: $('#bs_PKT_' + idx).val() || null,
                                NgayDuyetERPD: $('#bs_ERPD_' + idx).val() || null,
                                NgayDuyetBTC: $('#bs_BTC_' + idx).val() || null,
                                NgayDuyetBGD: $('#bs_BGD_' + idx).val() || null,
                                LyDoBoSung: $('#bs_LyDo_' + idx).val() || null,
                                NganSachBoSung: rawNS ? parseFloat(rawNS) : 0,
                                IsSupplementary: true
                            });
                        });
                        return list;
                    })()
                };

                $btn.prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i> Đang lưu...');

                $.ajax({
                    url:         '@Url.Action("SaveDetailsModal", "Budget")',
                    type:        'POST',
                    contentType: 'application/json',
                    data:        JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            // Hiện thông báo thành công ngay trong modal
                            showModalAlert('success', res.message);
                        } else {
                            showModalAlert('danger', res.message);
                        }
                    },
                    error: function () {
                        showModalAlert('danger', 'Đã xảy ra lỗi khi lưu thông tin - client.');
                    },
                    complete: function () {
                        $btn.prop('disabled', false)
                            .html('<i class="bi bi-save me-1"></i> Lưu thông tin');
                    }
                });
            });

            // ── Helper: hiện alert trong modal ──────────────────────────
            function showModalAlert(type, message) {
                var html = '<div class="alert alert-' + type + ' alert-dismissible '
                         + 'fade show mt-3" role="alert">'
                         + '<i class="bi bi-' + (type === 'success'
                             ? 'check-circle-fill' : 'exclamation-triangle-fill')
                         + ' me-2"></i>' + message
                         + '<button type="button" class="btn-close" '
                         +          'data-bs-dismiss="alert"></button>'
                         + '</div>';
                // Chèn alert vào đầu modal-body
                $('#modalContent').prepend(html);
                setTimeout(function () {
                    $('#modalContent .alert').fadeOut('slow', function () {
                        $(this).remove();
                    });
                }, 4000);
            }

            // ── Helper: format ngày từ JSON date .NET ───────────────────
            function formatDate(jsonDate) {
                if (!jsonDate) return '';
                var ms = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'));
                var d  = new Date(ms);
                return ('0' + d.getDate()).slice(-2) + '/'
                     + ('0' + (d.getMonth() + 1)).slice(-2) + '/'
                     + d.getFullYear();
            }

            // ── Helper: format số tiền ───────────────────────────────────
            function formatCurrency(value) {
                if (!value) return '0';
                return Number(value).toLocaleString('en-US');
            }

            $(document).on('click', '#btnHuySearchPhanNhiem', function () {
                $('#btnHuySearchPhanNhiem').hide();
                // Clear các ô input search
                $('#pn_SearchTen').val('');
                $('#pn_FilterPhongBan').val('');
                $('#pn_FilterChucNang').val('');

                // Gọi lại hàm render gốc để trả bảng về trạng thái có thể edit
                // Biến originalPhanNhiemList là danh sách dữ liệu gốc bạn đã nạp lúc mở modal
                renderModalPhanNhiem(originalPhanNhiemList);
            });

            window.bindPheDuyetData = function (pd, isManagerOrAdmin) {
                if (!pd) pd = { ProcessType: 1, TrangThaiPheDuyet: 0 };

                // Dropdown Khởi tạo quy trình
                if (isManagerOrAdmin) {
                    $('#processTypeSection').show();
                } else {
                    $('#processTypeSection').hide();
                }
                $('#pd_ProcessType').val(pd.ProcessType || 1);
                applyProcessType(pd.ProcessType || 1);

                // Mốc ngày
                $('#pd_NgayDuyetPDA').val(toDateInputValue(pd.NgayDuyetPDA));
                $('#pd_NgayDuyetPKT').val(toDateInputValue(pd.NgayDuyetPKT));
                $('#pd_NgayDuyetERPD').val(toDateInputValue(pd.NgayDuyetERPD));
                $('#pd_NgayDuyetBTC').val(toDateInputValue(pd.NgayDuyetBTC));
                $('#pd_NgayDuyetBGD').val(toDateInputValue(pd.NgayDuyetBGD));

                // Dự toán
                $('#pd_DuToanGoc').val(pd.DuToanGoc
                    ? Number(pd.DuToanGoc).toLocaleString('en-US') : '');
                $('#pd_DuToanPheDuyet').val(pd.DuToanPheDuyet || '');

                // Textbox
                $('#pd_SoThongBao').val(pd.SoThongBao || '');
                $('#pd_SoFMIO').val(pd.SoFMIO || '');

                // Trạng thái
                applyTrangThaiPheDuyet(pd.TrangThaiPheDuyet || 0, isManagerOrAdmin);

                // Cập nhật disable/enable mốc ngày
                updateMocNgayState();

                capNhatCardTongHop(); // *** THÊM MỚI ***
            };

            // ── Hiển thị/ẩn ERPD, BTC theo ProcessType ──────────────────
            function applyProcessType(processType) {
                if (parseInt(processType) === 1) {
                    $('.moc-tapDoan').show();
                } else {
                    $('.moc-tapDoan').hide();
                    $('#pd_NgayDuyetERPD').val('');
                    $('#pd_NgayDuyetBTC').val('');
                }
                updateMocNgayState();
            }

            $(document).on('change', '#pd_ProcessType', function () {
                applyProcessType($(this).val());
            });

            // ── Enable/disable mốc ngày theo tuần tự ────────────────────
            function updateMocNgayState() {
                var processType = parseInt($('#pd_ProcessType').val()) || 1;

                var pdaVal = $('#pd_NgayDuyetPDA').val();
                var pktVal = $('#pd_NgayDuyetPKT').val();
                var erpdVal = $('#pd_NgayDuyetERPD').val();
                var btcVal = $('#pd_NgayDuyetBTC').val();
                var bgdVal = $('#pd_NgayDuyetBGD').val();

                // Enable/disable theo tuần tự
                toggleMocNgay('#pd_NgayDuyetPKT', !!pdaVal);

                if (processType === 1) {
                    toggleMocNgay('#pd_NgayDuyetERPD', !!pktVal);
                    toggleMocNgay('#pd_NgayDuyetBTC', !!erpdVal);
                    toggleMocNgay('#pd_NgayDuyetBGD', !!btcVal);
                } else {
                    toggleMocNgay('#pd_NgayDuyetBGD', !!pktVal);
                }

                // *** THÊM MỚI: Tính trạng thái realtime theo logic mới ***
                var isManagerOrAdmin = !!$('#processTypeSection').is(':visible');
                var trangThai;
                if (!!bgdVal) {
                    trangThai = 2;
                } else if (!!pdaVal || !!pktVal || !!erpdVal || !!btcVal) {
                    trangThai = 1;
                } else {
                    trangThai = 0;
                }
                applyTrangThaiPheDuyet(trangThai, isManagerOrAdmin);

                capNhatCardTongHop(); // *** THÊM MỚI ***
            }

            $(document).on('input', '#pd_DuToanPheDuyet', function () {
                capNhatCardTongHop(); // *** THÊM MỚI ***
            });

            function toggleMocNgay(selector, enabled) {
                var $el = $(selector);
                if (enabled) {
                    $el.prop('disabled', false).removeClass('bg-light');
                } else {
                    $el.prop('disabled', true).addClass('bg-light').val('');
                }
            }

            // Lắng nghe thay đổi trên tất cả mốc ngày
            $(document).on('change', '.moc-ngay', function () {
                updateMocNgayState();
            });

            // ── Hiển thị badge trạng thái + disable button ───────────────
            function applyTrangThaiPheDuyet(trangThai, isManagerOrAdmin) {
                var $badge = $('#badgeTrangThaiPheDuyet');
                var $duToanInput = $('#pd_DuToanPheDuyet');

                switch (trangThai) {
                    case 0: // Chờ trình
                        $badge.text('Chờ trình')
                            .removeClass('bg-success bg-warning text-dark')
                            .addClass('bg-secondary');
                        $duToanInput.val('')
                            .prop('readonly', true)
                            .attr('placeholder', 'Chưa có duyệt từ BGĐ');
                        break;

                    case 1: // Đang trình
                        var duToanGoc = $('#pd_DuToanGoc').val();

                        // Format số (nếu cần)
                        var formatted = duToanGoc
                            ? Number(duToanGoc.replace(/[^\d]/g, '')).toLocaleString('en-US') + ' VND'
                            : '';
                        $badge.text('Đang trình' + (formatted ? ' ' + formatted : ''))
                            .removeClass('bg-success bg-secondary')
                            .addClass('bg-warning text-dark');
                        $duToanInput.val('')
                            .prop('readonly', true)
                            .attr('placeholder', 'Chưa có duyệt từ BGĐ');
                        break;

                    case 2: // Đã phê duyệt
                        $badge.text('Đã phê duyệt')
                            .removeClass('bg-warning bg-secondary text-dark')
                            .addClass('bg-success');

                        // Đọc DuToanGoc (đang format vi-VN dấu chấm), strip về số thuần
                        var duToanGocRaw = $('#pd_DuToanGoc').val()
                            .replace(/\./g, '')   // bỏ dấu chấm vi-VN
                            .replace(/,/g, '');   // bỏ dấu phẩy (nếu có)
                        var duToanGocNum = parseFloat(duToanGocRaw) || 0;

                        // Hiển thị format dấu phẩy (en-US: 12,000,000,000)
                        $('#pd_DuToanPheDuyet')
                            .val(duToanGocNum.toLocaleString('en-US'))
                            .prop('readonly', !isManagerOrAdmin)
                            .attr('placeholder', 'Nhập dự toán phê duyệt');
                        break;
                }
            }

            // ── Tính và cập nhật 2 card tổng hợp ────────────────────────
            function capNhatCardTongHop() {
                var tongDangTrinh = 0;
                var tongDaDuyet = 0;

                // ── Xử lý Ngân sách gốc ──────────────────────────────────
                var bgdGoc = $('#pd_NgayDuyetBGD').val();
                var pdaGoc = $('#pd_NgayDuyetPDA').val();
                var pktGoc = $('#pd_NgayDuyetPKT').val();
                var erpdGoc = $('#pd_NgayDuyetERPD').val();
                var btcGoc = $('#pd_NgayDuyetBTC').val();

                var coItNhat1NgayGoc = !!pdaGoc || !!pktGoc
                    || !!erpdGoc || !!btcGoc || !!bgdGoc;

                if (!!bgdGoc) {
                    // Đã duyệt đủ → lấy DuToanPheDuyet
                    var rawGoc = $('#pd_DuToanPheDuyet').val()
                        .replace(/,/g, '').replace(/\./g, '');
                    tongDaDuyet += parseFloat(rawGoc) || 0;
                } else if (coItNhat1NgayGoc) {
                    // Đang trình → lấy DuToanGoc
                    var rawGocTrinh = $('#pd_DuToanGoc').val()
                        .replace(/\./g, '').replace(/,/g, '');
                    tongDangTrinh += parseFloat(rawGocTrinh) || 0;
                }

                // ── Xử lý các card Bổ sung ───────────────────────────────
                $('#containerBoSung .card-bo-sung').each(function () {
                    var $card = $(this);
                    var idx = $card.data('index');

                    var bgdBS = $('#bs_BGD_' + idx).val();
                    var pdaBS = $('#bs_PDA_' + idx).val();
                    var pktBS = $('#bs_PKT_' + idx).val();
                    var erpdBS = $('#bs_ERPD_' + idx).val();
                    var btcBS = $('#bs_BTC_' + idx).val();

                    var coItNhat1NgayBS = !!pdaBS || !!pktBS
                        || !!erpdBS || !!btcBS || !!bgdBS;

                    var rawBS = $('#bs_NganSach_' + idx).val()
                        .replace(/,/g, '').replace(/\./g, '');
                    var soBS = parseFloat(rawBS) || 0;

                    if (!!bgdBS) {
                        // Đã duyệt đủ
                        tongDaDuyet += soBS;
                    } else if (coItNhat1NgayBS) {
                        // Đang trình
                        tongDangTrinh += soBS;
                    }
                });

                // ── Cập nhật UI ──────────────────────────────────────────
                $('#card_TongDangTrinh').text(formatCurrencyPD(tongDangTrinh));
                $('#card_TongDaDuyet').text(formatCurrencyPD(tongDaDuyet));
            }

            // ── Helper format tiền tệ cho tab Phê duyệt ─────────────────
            function formatCurrencyPD(value) {
                if (!value || value === 0) return '0 ₫';
                if (value >= 1000000000)
                    return (value / 1000000000).toFixed(2) + ' tỷ ₫';
                if (value >= 1000000)
                    return (value / 1000000).toFixed(1) + ' triệu ₫';
                return Number(value).toLocaleString('en-US') + ' ₫';
            }

            // ── Helper: convert JSON Date sang yyyy-MM-dd cho input date ─
            function toDateInputValue(jsonDate) {
                if (!jsonDate) return '';
                var ms = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'));
                if (isNaN(ms)) return '';
                var d = new Date(ms);
                return d.getFullYear() + '-'
                     + ('0' + (d.getMonth() + 1)).slice(-2) + '-'
                     + ('0' + d.getDate()).slice(-2);
            }

            var boSungIndex = 0; // index cho name binding

            // ── Template HTML cho 1 card bổ sung ────────────────────────
            function taoCardBoSung(idx, order, data) {
                data = data || {};
                var processType = data.ProcessType || 1;

                return '<div class="card border-success mb-3 card-bo-sung" '
                    + 'data-index="' + idx + '">'

                    // Header card
                    + '<div class="card-header bg-success text-white d-flex '
