                        <!-- Tab 2: Theo dõi phê duyệt -->
                        <div class="tab-pane fade"
                             id="modal-approval-tab-pane"
                             role="tabpanel"
                             aria-labelledby="modal-approval-tab"
                             tabindex="0">

