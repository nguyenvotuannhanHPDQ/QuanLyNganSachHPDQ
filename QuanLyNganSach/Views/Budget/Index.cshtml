@using PagedList.Mvc
@model PagedList.IPagedList<QuanLyNganSach.Models.ViewModels.BudgetRegistrationListViewModel>
@{
    ViewBag.Title = "Danh sách đăng ký ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Danh sách đăng ký ngân sách
                    </li>
                </ol>
            </nav>

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0 fw-semibold">
                        <i class="bi bi-card-list text-primary me-2"></i>
                        Danh sách đăng ký ngân sách
                    </h4>
                    <small class="text-muted">
                        Tổng số: <span>@Model.TotalItemCount</span> đăng ký
                    </small>
                </div>
                <a href="@Url.Action("Create", "Budget")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Đăng ký mới
                </a>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Html.Raw(TempData["Success"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Card chứa bảng -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    @using (Html.BeginForm("Index", "Budget", FormMethod.Get, new { id = "searchForm" }))
                    {
                        <div class="row align-items-center g-2">
                            <!-- SEARCH -->
                            <div class="col-12 col-md-5 col-lg-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           id="searchInput"
                                           name="search"
                                           value="@ViewBag.CurrentSearch"
                                           class="form-control"
                                           placeholder="Tìm kiếm theo mã, tên hạng mục...">
                                    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch))
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                id="clearSearch"
                                                title="Xóa tìm kiếm">
                                            <i class="bi bi-x-lg"></i>Clear
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- PHÒNG BAN (Manager/Admin) -->
                            @if (ViewBag.IsManagerOrAdmin == true)
                            {
                                <div class="col-12 col-md-4 col-lg-3">
                                    <select id="phongBanId"
                                            name="phongBanId"
                                            class="form-select form-select-sm">
                                        @foreach (var item in ViewBag.PhongBanList as List<SelectListItem>)
                                        {
                                            <option value="@item.Value" @(item.Selected ? "selected" : "")>
                                                @item.Text
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- SORT -->
                            <div class="col-12 col-md-3 col-lg-2">
                                <select id="sortOrder"
                                        name="sortOrder"
                                        class="form-select form-select-sm">
                                    <option value="newest" @(ViewBag.CurrentSort == "newest" ? "selected" : "")>
                                        Ngày tạo mới nhất
                                    </option>
                                    <option value="oldest" @(ViewBag.CurrentSort == "oldest" ? "selected" : "")>
                                        Ngày tạo cũ nhất
                                    </option>
                                    <option value="budget-high" @(ViewBag.CurrentSort == "budget-high" ? "selected" : "")>
                                        Dự toán cao - thấp
                                    </option>
                                    <option value="budget-low" @(ViewBag.CurrentSort == "budget-low" ? "selected" : "")>
                                        Dự toán thấp - cao
                                    </option>
                                </select>
                            </div>
                        </div>
                    }

                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <!-- Budget Cards - One card per row -->
                        <div class="budget-cards-container">
                            @{ int cardIndex = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
                            @foreach (var item in Model)
                            {
                                <div class="card mb-3 shadow-sm border-0 budget-card-horizontal">
                                    <div class="card-body">
                                        <div class="row align-items-center g-3">
                                            <!-- Column 1: STT & Status Badge -->
                                            <div class="col-auto">
                                                <div class="text-center">
                                                    <div class="badge bg-light text-dark border mb-2" style="width: 50px; height: 50px; line-height: 50px; font-size: 1.2rem; border-radius: 10px;">
                                                        #@cardIndex
                                                    </div>
                                                    @if (item.TrangThai == 1)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-info-circle"></i> Hồ sơ đủ thông tin
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="bi bi-info-circle"></i> Chưa đủ thông tin
                                                        </span>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Column 2: Mã hạng mục & Ngày tạo -->
                                            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                                                <div class="mb-2">
                                                    <span class="badge bg-secondary bg-gradient px-3 py-2 w-100">
                                                        <i class="bi bi-tag-fill"></i> @item.MaHangMuc
                                                    </span>
                                                </div>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar-plus"></i>
                                                    @item.NgayTao.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>

                                            <!-- Column 3: Tên hạng mục & Phòng ban -->
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                                <h6 class="mb-1 fw-bold">
                                                    <a href="@Url.Action("Details", "Budget", new { id = item.BudgetRegistrationId })"
                                                       class="text-decoration-none text-dark"
                                                       title="@item.TenHangMuc">
                                                        @item.TenHangMuc
                                                    </a>
                                                </h6>
                                                <div class="text-muted small">
                                                    <i class="bi bi-building text-primary"></i>
                                                    @item.TenPhongBan
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.NguoiDangKy))
                                                {
                                                    <div class="text-muted small mt-1">
                                                        <i class="bi bi-journal-text"></i>
                                                        @item.NguoiDangKy
                                                    </div>
                                                }
                                            </div>

                                            <!-- Column 4: Dự toán - Highlighted -->
                                            <div class="col-6 col-sm-6 col-md-3 col-lg-2">
                                                <div class="p-2 bg-success bg-opacity-10 rounded text-center">
                                                    <small class="text-muted d-block">
                                                        <i class="bi bi-currency-dollar"></i> Dự toán
                                                    </small>
                                                    <div class="fw-bold text-success fs-5">
                                                        @item.DuToan.ToString("N0")
                                                    </div>
                                                    <small class="text-muted">VNĐ</small>
                                                </div>
                                            </div>

                                            <!-- Column 5: Thời gian -->
                                            <div class="col-6 col-sm-6 col-md-2 col-lg-2">
                                                <div class="small">
                                                    <div class="mb-1">
                                                        <i class="bi bi-calendar-event text-primary"></i>
                                                        @if (item.NgayBatDau.HasValue)
                                                        {
                                                            <span class="text-muted">@item.NgayBatDau.Value.ToString("dd/MM/yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">--</span>
                                                        }
                                                    </div>
                                                    <div>
                                                        <i class="bi bi-calendar-check text-success"></i>
                                                        @if (item.NgayBatDau.HasValue)
                                                        {
                                                            <span class="text-muted">@item.NgayKetThuc.Value.ToString("dd/MM/yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">--</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Column 6: Actions -->
                                            <div class="col-12 col-sm-6 col-md-12 col-lg-3">
                                                <div class="d-flex gap-2 justify-content-lg-end justify-content-start">
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm flex-fill flex-lg-grow-0 btn-view-modal"
                                                            data-budget-id="@item.BudgetRegistrationId"
                                                            title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i> Xem
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card left border indicator -->
                                    <div class="position-absolute top-0 start-0 h-100 bg-primary" style="width: 4px;"></div>
                                </div>
                                cardIndex++;
                            }
                        </div>
                    }
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="card-footer bg-light py-3">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Hiển thị @Model.Count / @Model.TotalItemCount đăng ký
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-clock-history"></i>
                                    Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-6">
                                <div class="pagination-wrapper">
                                    @if (Model.PageCount > 1)
                                    {
                                        <nav aria-label="Phân trang">
                                            <ul class="pagination pagination-sm mb-0 justify-content-center justify-content-md-end">
                                                <!-- First page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Đầu</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Đầu</span>
                                                    }
                                                </li>

                                                <!-- Previous page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Trước</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Trước</span>
                                                    }
                                                </li>

                                                <!-- Page numbers -->
                                                @{
                                                    int startPage = Math.Max(1, Model.PageNumber - 2);
                                                    int endPage = Math.Min(Model.PageCount, Model.PageNumber + 2);

                                                    if (Model.PageNumber <= 3)
                                                    {
                                                        endPage = Math.Min(5, Model.PageCount);
                                                    }

                                                    if (Model.PageNumber >= Model.PageCount - 2)
                                                    {
                                                        startPage = Math.Max(1, Model.PageCount - 4);
                                                    }
                                                }

                                                @for (int i = startPage; i <= endPage; i++)
                                                {
                                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                        @if (i == Model.PageNumber)
                                                        {
                                                            <span class="page-link">@i</span>
                                                        }
                                                        else
                                                        {
                                                            <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">@i</a>
                                                        }
                                                    </li>
                                                }

                                                <!-- Next page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Sau</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Sau</span>
                                                    }
                                                </li>

                                                <!-- Last page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageCount, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Cuối</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Cuối</span>
                                                    }
                                                </li>
                                            </ul>
                                        </nav>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- ===== MODAL CHI TIẾT HỒ SƠ ===== -->
<div class="modal fade" id="budgetDetailsModal" tabindex="-1"
     aria-labelledby="budgetDetailsModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header text-bg-primary">
                <h5 class="modal-title" id="budgetDetailsModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Chi tiết hồ sơ ngân sách
                    <span class="badge bg-light text-primary ms-2 fs-6"
                          id="modalMaHangMuc"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                <!-- Loading spinner -->
                <div id="modalLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Đang tải dữ liệu...</p>
                </div>

                <!-- Nội dung modal (ẩn khi đang load) -->
                <div id="modalContent" style="display:none;">

                    <!-- TAB NAVIGATION -->
                    <ul class="nav nav-tabs mb-4" id="detailTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="detail-phieu-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-phieu"
                                    type="button" role="tab">
                                <i class="bi bi-file-earmark-text me-1"></i>Phiếu đăng ký
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="detail-phannhiem-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-phannhiem"
                                    type="button" role="tab">
                                <i class="bi bi-people me-1"></i>Phân nhiệm
                                <span id="modalPhanNhiemCount"
                                      class="badge bg-secondary ms-1">0</span>
                            </button>
                        </li>
                        <!-- Tab Phê duyệt — chỉ hiện khi WorkflowType = 1 -->
                        <li class="nav-item d-none" id="tabPheDuyetItem" role="presentation">
                            <button class="nav-link" id="detail-pheduyet-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-pheduyet"
                                    type="button" role="tab">
                                <i class="bi bi-check2-circle me-1"></i>Phê duyệt
                            </button>
                        </li>
                        <!-- Tab Nhật ký tiến độ — chỉ hiện khi WorkflowType = 1 -->
                        <li class="nav-item d-none" id="tabNhatKyItem" role="presentation">
                            <button class="nav-link" id="detail-nhatky-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-nhatky"
                                    type="button" role="tab">
                                <i class="bi bi-journal-text me-1"></i>Nhật ký tiến độ
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="detailTabsContent">

                        <!-- ===== TAB 1: PHIẾU ĐĂNG KÝ (READONLY) ===== -->
                        <div class="tab-pane fade show active"
                             id="detail-phieu" role="tabpanel">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Khu vực dự án
                                    </label>
                                    <select class="form-select" id="modal_AreaName" disabled>
                                        <option value="">-- Chưa chọn --</option>
                                        @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.DsKhuVucModal)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Bộ phận
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenPhongBan" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Mã hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_MaHangMuc" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Tên hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenHangMuc" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Dự toán
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_DuToan" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Số tờ trình
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_SoToTrinh" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Loại hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_CategoryTypeName" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Mức ưu tiên
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_PriorityLevelName" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Số lượng
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_SoLuong" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Ngày bắt đầu
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_NgayBatDau" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Ngày kết thúc
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_NgayKetThuc" readonly />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Người đăng ký
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenNguoiDangKy" readonly />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Lý do đầu tư
                                </label>
                                <textarea class="form-control" id="modal_LyDoDauTu"
                                          rows="3" readonly></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Mô tả kỹ thuật
                                </label>
                                <textarea class="form-control" id="modal_MoTaKyThuat"
                                          rows="3" readonly></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">
                                    Link tài liệu liên quan
                                </label>
                                <input type="text" class="form-control"
                                       id="modal_LinkTaiLieu" readonly />
                            </div>

                            <!-- Attachments -->
                            <div id="modal_AttachmentsSection">
                                <label class="form-label fw-semibold text-muted small">
                                    <i class="bi bi-paperclip me-1"></i>Hồ sơ đính kèm
                                </label>
                                <div id="modal_AttachmentsList"
                                     class="border rounded p-2 bg-light"></div>
                            </div>
                        </div>

                        <!-- ===== TAB 2: PHÂN NHIỆM (EDITABLE) ===== -->
                        <div class="tab-pane fade"
                             id="detail-phannhiem" role="tabpanel">
                            <div class="d-flex justify-content-between
                                        align-items-center mb-3">
                                <h6 class="fw-semibold mb-0">
                                    <i class="bi bi-people-fill me-1"></i>
                                    Danh sách phân nhiệm
                                </h6>
                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        id="btnModalThemDong">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm dòng
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover
                                              align-middle" id="tblModalPhanNhiem">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:5%">#</th>
                                            <th style="width:22%">
                                                Tên Bộ phận
                                                <span class="text-danger">*</span>
                                            </th>
                                            <th style="width:25%">
                                                Chức năng / Nhiệm vụ
                                            </th>
                                            <th style="width:20%">Email liên hệ</th>
                                            <th style="width:22%">Ghi chú</th>
                                            <th style="width:6%"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="modalPhanNhiemBody"></tbody>
                                </table>
                            </div>
                            <p class="text-muted small mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Chọn chức năng từ danh sách hoặc nhập trực tiếp
                                vào ô bên dưới nếu không có trong danh sách.
                            </p>
                        </div>

                        <!-- ===== TAB 3: PHÊ DUYỆT (PLACEHOLDER) ===== -->
                        <div class="tab-pane fade"
                             id="detail-pheduyet" role="tabpanel">
                            <!-- CARD NGÂN SÁCH GỐC -->
                            <div class="card border-primary mb-3" id="cardNganSachGoc">
                                <div class="card-header bg-primary text-white d-flex
                    justify-content-between align-items-center py-2">
                                    <span class="fw-semibold">
                                        <i class="bi bi-wallet2 me-1"></i>Ngân sách gốc
                                    </span>
                                    <!-- Dropdown Khởi tạo quy trình — chỉ Admin/Manager -->
                                    <div id="processTypeSection" style="display:none;">
                                        <select class="form-select form-select-sm w-auto"
                                                id="pd_ProcessType" style="min-width:200px;">
                                            <option value="1">Theo QT Tập đoàn</option>
                                            <option value="2">Theo QT Công ty</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="card-body">

                                    <!-- TIẾN ĐỘ DUYỆT -->
                                    <h6 class="fw-semibold text-muted mb-3">
                                        <i class="bi bi-calendar-check me-1"></i>Tiến độ duyệt
                                    </h6>
                                    <div class="row g-3 mb-4" id="tienDoDuyetRow">

                                        <!-- PDA -->
                                        <div class="col-md-2 col-sm-4">
                                            <label class="form-label small fw-semibold">PDA</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetPDA" data-moc="PDA" />
                                        </div>

                                        <!-- PKT -->
                                        <div class="col-md-2 col-sm-4">
                                            <label class="form-label small fw-semibold">PKT</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetPKT" data-moc="PKT"
                                                   data-requires="pd_NgayDuyetPDA" disabled />
                                        </div>

                                        <!-- ERPD — chỉ hiện khi ProcessType = 1 -->
                                        <div class="col-md-2 col-sm-4 moc-tapDoan" style="display:none;">
                                            <label class="form-label small fw-semibold">ERPD</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetERPD" data-moc="ERPD"
                                                   data-requires="pd_NgayDuyetPKT" disabled />
                                        </div>

                                        <!-- BTC — chỉ hiện khi ProcessType = 1 -->
                                        <div class="col-md-2 col-sm-4 moc-tapDoan" style="display:none;">
                                            <label class="form-label small fw-semibold">BTC</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetBTC" data-moc="BTC"
                                                   data-requires="pd_NgayDuyetERPD" disabled />
                                        </div>

                                        <!-- BGĐ -->
                                        <div class="col-md-2 col-sm-4" id="colBGD">
                                            <label class="form-label small fw-semibold">BGĐ</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetBGD" data-moc="BGD"
                                                   data-requires-congty="pd_NgayDuyetPKT"
                                                   data-requires-tapDoan="pd_NgayDuyetBTC" disabled />
                                        </div>

                                    </div>

                                    <!-- NGÂN SÁCH PHÊ DUYỆT -->
                                    <!-- NGÂN SÁCH PHÊ DUYỆT -->
                                    <h6 class="fw-semibold text-muted mb-3">
                                        <i class="bi bi-currency-exchange me-1"></i>Ngân sách phê duyệt
                                    </h6>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Dự toán gốc
                                            </label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_DuToanGoc" readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Dự toán phê duyệt
                                            </label>
                                            <!-- *** THAY ĐỔI: bỏ input-group, bỏ button, thêm disabled mặc định *** -->
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_DuToanPheDuyet"
                                                   placeholder="Chưa có ngày duyệt BGĐ"
                                                   disabled />
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end">
                                            <span class="badge fs-6 p-2" id="badgeTrangThaiPheDuyet"></span>
                                        </div>
                                    </div>

                                    <!-- SỐ THÔNG BÁO + SỐ FM/IO -->
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Số thông báo</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoThongBao" placeholder="Nhập số thông báo" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Số FM/IO</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoFMIO" placeholder="Nhập số FM/IO" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <!-- BUTTON THÊM BỔ SUNG -->
                            <div class="d-flex justify-content-start mb-3">
                                <button type="button" class="btn btn-outline-success btn-sm"
                                        id="btnThemBoSung">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm bổ sung ngân sách
                                </button>
                            </div>

                            <!-- CONTAINER CÁC CARD BỔ SUNG (render động) -->
                            <div id="containerBoSung"></div>
                        </div>

                        <!-- ===== TAB 4: NHẬT KÝ TIẾN ĐỘ (PLACEHOLDER) ===== -->
                        <div class="tab-pane fade"
                             id="detail-nhatky" role="tabpanel">
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-journal-text fs-1"></i>
                                <p class="mt-2">
                                    Chức năng Nhật ký tiến độ đang được phát triển.
                                </p>
                            </div>
                        </div>

                    </div><!-- end tab-content -->
                    <!-- ===== DROPDOWN XÁC NHẬN LUỒNG (Admin + Manager) ===== -->
                    <div id="workflowSection" style="display:none;">
                        <hr />
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-diagram-3 me-1"></i>
                                    Xác nhận luồng
                                </label>
                                <select class="form-select" id="modal_WorkflowType">
                                    <option value="">-- Chưa xác nhận --</option>
                                    <option value="1">
                                        Theo luồng ngân sách đầu tư
                                    </option>
                                    <option value="2">
                                        Theo luồng chi phí sản xuất
                                    </option>
                                    <option value="3">
                                        Hồ sơ thiếu thông tin
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div><!-- end modalContent -->
            </div><!-- end modal-body -->
            <!-- FOOTER -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
                <button type="button" class="btn btn-primary" id="btnSaveDetailsModal">
                    <i class="bi bi-save me-1"></i>Lưu thông tin
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Search on input with debounce
            var searchTimeout;
            $('#searchInput').on('keyup', function (e) {
                // Don't submit on Enter key here (handled separately)
                if (e.which === 13) {
                    return;
                }

                clearTimeout(searchTimeout);
                var searchValue = $(this).val(); // Capture value

                searchTimeout = setTimeout(function () {
                    // Ensure value is set before submit
                    $('#searchInput').val(searchValue);
                    $('#searchForm').submit();
                }, 500); // Wait 500ms after user stops typing
            });

            // Filter by status - submit form immediately
            $('input[name="status"]').on('change', function () {
                $('#searchForm').submit();
            });

            // Auto-submit when department filter changes (for Manager/Admin)
            $('#phongBanId').on('change', function () {
                $('#searchForm').submit();
            });

            // Clear search button
            $('#clearSearch').on('click', function () {
                $('#searchInput').val('');
                $('#searchForm').submit();
            });

            // Handle Enter key explicitly
            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    clearTimeout(searchTimeout); // Cancel debounce
                    $('#searchForm').submit();
                }
            });

            // Auto-submit when sort order changes
            $('#sortOrder').on('change', function () {
                var sortValue = $(this).val();
                var currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('sortOrder', sortValue);
                currentUrl.searchParams.delete('page'); // Reset về trang 1
                window.location.href = currentUrl.toString();
            });

