                            <div id="containerKhuVuc"></div>

                        </div>

                    </div><!-- end tab-content -->
                    <!-- ===== DROPDOWN XÁC NHẬN LUỒNG (Admin + Manager) ===== -->
                    <div id="workflowSection" style="display:none;">
                        <hr />
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-diagram-3 me-1"></i>
                                    Xác nhận luồng
                                </label>
                                <select class="form-select" id="modal_WorkflowType">
                                    <option value="">-- Chưa xác nhận --</option>
                                    <option value="1">
                                        Theo luồng ngân sách đầu tư
                                    </option>
                                    <option value="2">
                                        Theo luồng chi phí sản xuất
                                    </option>
                                    <option value="3">
                                        Hồ sơ thiếu thông tin
