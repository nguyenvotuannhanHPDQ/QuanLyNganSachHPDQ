@using PagedList.Mvc
@model PagedList.IPagedList<QuanLyNganSach.Models.ViewModels.BudgetRegistrationListViewModel>
@{
    ViewBag.Title = "Danh sách đăng ký ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid mt-2 mb-5 px-1">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")" class="text-decoration-none">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Danh sách hồ sơ đăng ký ngân sách
                    </li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                <div>
                    <h4 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-card-list text-primary me-2"></i>
                        Danh sách hồ sơ đăng ký ngân sách
                    </h4>
                    <small class="text-muted">
                        Tổng số: <span class="fw-semibold text-primary">@Model.TotalItemCount</span> đăng ký
                    </small>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a href="@Url.Action("Create", "Budget")" class="btn btn-primary shadow-sm fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Đăng ký mới
                    </a>
                    @if (ViewBag.IsManagerOrAdmin == true)
                    {
                        <button type="button" class="btn btn-success shadow-sm fw-semibold" id="btnOpenExportModal">
                            <i class="bi bi-file-earmark-excel me-1"></i> Xuất dữ liệu Excel
                        </button>
                    }
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Html.Raw(TempData["Success"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 border-bottom border-light-subtle">
                    @using (Html.BeginForm("Index", "Budget", FormMethod.Get, new { id = "searchForm" }))
                    {
                        <div class="row align-items-center g-2">
                            <div class="col-12 col-md-4 col-lg-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           id="searchInput"
                                           name="search"
                                           value="@ViewBag.CurrentSearch"
                                           class="form-control border-start-0 ps-1"
                                           placeholder="Tìm kiếm theo mã, tên hạng mục...">
                                    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch))
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSearch" title="Xóa tìm kiếm">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (ViewBag.IsManagerOrAdmin == true)
                            {
                                <div class="col-12 col-md-3 col-lg-3">
                                    <select id="phongBanId" name="phongBanId" class="form-select form-select-sm">
                                        @foreach (var item in ViewBag.PhongBanList as List<SelectListItem>)
                                        {
                                            <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-12 col-md-3 col-lg-3">
                                <select id="filterTrangThai" name="filterTrangThai" class="form-select form-select-sm">
                                    <option value="">-- Tất cả trạng thái --</option>
                                    <option value="0" @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 0 ? "selected" : "")>Đăng ký mới</option>
                                    <option value="1" @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 1 ? "selected" : "")>Chưa đủ hồ sơ</option>
                                    <option value="2" @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 2 ? "selected" : "")>Theo luồng chi phí sản xuất</option>
                                    <option value="3" @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 3 ? "selected" : "")>Đang thực hiện xin ngân sách</option>
                                    <option value="4" @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 4 ? "selected" : "")>Đang bổ sung ngân sách</option>
                                    <option value="5" @(ViewBag.CurrentFilterTrangThai != null && (int)ViewBag.CurrentFilterTrangThai == 5 ? "selected" : "")>Đã phê duyệt ngân sách</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-2 col-lg-2">
                                <select id="sortOrder" name="sortOrder" class="form-select form-select-sm">
                                    <option value="newest" @(ViewBag.CurrentSort == "newest" ? "selected" : "")>Ngày tạo mới nhất</option>
                                    <option value="oldest" @(ViewBag.CurrentSort == "oldest" ? "selected" : "")>Ngày tạo cũ nhất</option>
                                    <option value="budget-high" @(ViewBag.CurrentSort == "budget-high" ? "selected" : "")>Dự toán cao - thấp</option>
                                    <option value="budget-low" @(ViewBag.CurrentSort == "budget-low" ? "selected" : "")>Dự toán thấp - cao</option>
                                </select>
                            </div>

                            @if (ViewBag.CurrentFilterTrangThai != null)
                            {
                                <div class="col-auto ms-auto">
                                    <a href="@Url.Action("Index", "Budget", new { search = ViewBag.CurrentSearch, sortOrder = ViewBag.CurrentSort, phongBanId = ViewBag.CurrentPhongBanId })"
                                       class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                                        <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        int cardIndex = ((Model.PageNumber - 1) * Model.PageSize) + 1;

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0 text-nowrap">
                                <thead class="table-light border-bottom">
                                    <tr>
                                        <th class="text-center" style="width: 5%">STT</th>
                                        <th style="width: 12%">Mã hạng mục</th>
                                        <th style="width: 33%">Tên hạng mục</th>
                                        <th class="text-end" style="width: 15%">Dự toán</th>
                                        <th class="text-center" style="width: 10%">Ngày tạo</th>
                                        <th class="text-center" style="width: 15%">Trạng thái</th>
                                        <th class="text-center" style="width: 10%">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        string badgeClass = "bg-secondary";
                                        string badgeIcon = "bi-info-circle";
                                        string currentText = item.TrangThaiHienThiText;

                                        switch (currentText)
                                        {
                                            case "Đăng ký mới":
                                                badgeClass = "bg-primary";
                                                badgeIcon = "bi-file-earmark-plus";
                                                break;
                                            case "Chưa đủ hồ sơ":
                                                badgeClass = "bg-danger";
                                                badgeIcon = "bi-exclamation-triangle";
                                                break;
                                            case "Theo luồng chi phí sản xuất":
                                                badgeClass = "bg-dark text-light";
                                                badgeIcon = "bi-arrow-left-right";
                                                break;
                                            case "Đang thực hiện xin ngân sách":
                                                badgeClass = "bg-warning text-dark";
                                                badgeIcon = "bi-hourglass-split";
                                                break;
                                            case "Đang bổ sung ngân sách":
                                                badgeClass = "bg-info text-dark";
                                                badgeIcon = "bi-arrow-repeat";
                                                break;
                                            case "Đã phê duyệt ngân sách":
                                                badgeClass = "bg-success";
                                                badgeIcon = "bi-check-circle";
                                                break;
                                        }

                                        <tr id="budget-row-@item.BudgetRegistrationId">
                                            <td class="text-center fw-semibold text-muted">#@cardIndex</td>

                                            <td>
                                                @if (!string.IsNullOrEmpty(item.MaHangMuc))
                                                {
                                                    <span class="badge bg-dark-subtle text-dark border border-dark-subtle px-2.5 py-1.5 fw-bold font-monospace">
                                                        @item.MaHangMuc
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">---</span>
                                                }
                                            </td>

                                            <td class="text-wrap" style="min-width: 280px;">
                                                <h6 class="mb-1 fw-bold text-dark">@item.TenHangMuc</h6>
                                                <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
                                                    <span class="text-muted small">
                                                        <i class="bi bi-building text-primary me-1"></i>@item.TenPhongBan
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(item.NguoiDangKy))
                                                    {
                                                        <span class="text-muted small-separator">|</span>
                                                        <span class="text-muted small">
                                                            <i class="bi bi-journal-text me-1"></i>@item.NguoiDangKy
                                                        </span>
                                                    }
                                                </div>
                                            </td>

                                            <td class="text-end">
                                                @if (!item.IsPhanNhiemUser)
                                                {
                                                    if (item.CoThongTinPheDuyet)
                                                    {
                                                        <div class="fw-bold text-primary" title="Đã phê duyệt">
                                                            @item.TongTienDaDuyet.ToString("N0") <small class="fw-normal text-muted">đ</small>
                                                        </div>
                                                        <small class="text-muted d-block" style="font-size: 0.75rem;">
                                                            <i class="bi bi-check-circle text-success"></i> Đã duyệt
                                                        </small>
                                                    }
                                                    else
                                                    {
                                                        <div class="fw-bold text-success" title="Dự toán gốc">
                                                            @item.DuToan.ToString("N0") <small class="fw-normal text-muted">đ</small>
                                                        </div>
                                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Dự toán</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted fw-semibold">---</span>
                                                }
                                            </td>

                                            <td class="text-center text-muted small">
                                                <i class="bi bi-calendar-plus me-1"></i>@item.NgayTao.ToString("dd/MM/yyyy")
                                            </td>

                                            <td class="text-center">
                                                <span class="badge @badgeClass py-1.5 px-2.5 fw-medium border-0 shadow-none">
                                                    <i class="bi @badgeIcon me-1"></i> @currentText
                                                </span>
                                            </td>

                                            <td class="text-center">
                                                <div class="d-inline-flex gap-1">
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm px-2 py-0.5 btn-view-modal"
                                                            data-budget-id="@item.BudgetRegistrationId"
                                                            data-is-phan-nhiem="@item.IsPhanNhiemUser.ToString().ToLower()"
                                                            title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i> Xem
                                                    </button>

                                                    @{
                                                        var currentUser = ViewBag.CurrentUser as QuanLyNganSach.Models.Auth.LoggedInUser;
                                                        bool isManagerOrAdmin = ViewBag.IsManagerOrAdmin == true;
                                                        bool canDelete = isManagerOrAdmin || (item.UserId == currentUser?.UserId && item.WorkflowType == null);
                                                    }
                                                    @if (canDelete)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-danger btn-sm px-2 py-0.5 btn-delete"
                                                                data-budget-id="@item.BudgetRegistrationId"
                                                                data-ten-hang-muc="@item.TenHangMuc"
                                                                title="Xóa hồ sơ">
                                                            <i class="bi bi-trash"></i> Xóa
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        cardIndex++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                            Không có dữ liệu.
                        </div>
                    }
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="card-footer bg-light py-3 border-top border-light-subtle">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Hiển thị <span class="fw-semibold text-dark">@Model.Count</span> / <span class="fw-semibold text-dark">@Model.TotalItemCount</span> đăng ký
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-clock-history"></i>
                                     @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-6">
                                <div class="pagination-wrapper d-flex justify-content-center justify-content-md-end">
                                    @if (Model.PageCount > 1)
                                    {
                                        @* Khai báo routeValues dùng chung cho toàn bộ các link *@
                                        {
                                            var pgRoute = new
                                            {
                                                search = ViewBag.CurrentSearch,
                                                sortOrder = ViewBag.CurrentSort,
                                                phongBanId = ViewBag.CurrentPhongBanId,
                                                filterTienDo = ViewBag.CurrentFilterTienDo,
                                                filterTrangThai = ViewBag.CurrentFilterTrangThai
                                            };
                                        }

                                        <nav aria-label="Phân trang">
                                            <ul class="pagination pagination-sm mb-0
                        justify-content-center justify-content-md-end">

                                                <!-- First page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                        page             = 1,
                                                        search           = ViewBag.CurrentSearch,
                                                        sortOrder        = ViewBag.CurrentSort,
                                                        phongBanId       = ViewBag.CurrentPhongBanId,
                                                        filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                        filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                    })">
                                                            Đầu
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Đầu</span>
                                                    }
                                                </li>

                                                <!-- Previous page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                        page             = Model.PageNumber - 1,
                                                        search           = ViewBag.CurrentSearch,
                                                        sortOrder        = ViewBag.CurrentSort,
                                                        phongBanId       = ViewBag.CurrentPhongBanId,
                                                        filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                        filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                    })">
                                                            Trước
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Trước</span>
                                                    }
                                                </li>

                                                <!-- Page numbers -->
                                                @{
                                                    int startPage = Math.Max(1, Model.PageNumber - 2);
                                                    int endPage = Math.Min(Model.PageCount, Model.PageNumber + 2);
                                                    if (Model.PageNumber <= 3)
                                                    {
                                                        endPage = Math.Min(5, Model.PageCount);
                                                    }
                                                    if (Model.PageNumber >= Model.PageCount - 2)
                                                    {
                                                        startPage = Math.Max(1, Model.PageCount - 4);
                                                    }
                                                }
                                                @for (int i = startPage; i <= endPage; i++)
                                                {
                                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                        @if (i == Model.PageNumber)
                                                        {
                                                            <span class="page-link">@i</span>
                                                        }
                                                        else
                                                        {
                                                            <a class="page-link"
                                                               href="@Url.Action("Index", new {
                                                                page             = i,
                                                                search           = ViewBag.CurrentSearch,
                                                                sortOrder        = ViewBag.CurrentSort,
                                                                phongBanId       = ViewBag.CurrentPhongBanId,
                                                                filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                                filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                            })">
                                                                @i
                                                            </a>
                                                        }
                                                    </li>
                                                }

                                                <!-- Next page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                        page             = Model.PageNumber + 1,
                                                        search           = ViewBag.CurrentSearch,
                                                        sortOrder        = ViewBag.CurrentSort,
                                                        phongBanId       = ViewBag.CurrentPhongBanId,
                                                        filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                        filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                    })">
                                                            Sau
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Sau</span>
                                                    }
                                                </li>

                                                <!-- Last page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link"
                                                           href="@Url.Action("Index", new {
                                                        page             = Model.PageCount,
                                                        search           = ViewBag.CurrentSearch,
                                                        sortOrder        = ViewBag.CurrentSort,
                                                        phongBanId       = ViewBag.CurrentPhongBanId,
                                                        filterTienDo     = ViewBag.CurrentFilterTienDo,
                                                        filterTrangThai  = ViewBag.CurrentFilterTrangThai
                                                    })">
                                                            Cuối
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Cuối</span>
                                                    }
                                                </li>

                                            </ul>
                                        </nav>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="budgetDetailsModal" tabindex="-1"
     aria-labelledby="budgetDetailsModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header text-bg-primary">
                <h5 class="modal-title" id="budgetDetailsModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Chi tiết hồ sơ ngân sách
                    <span class="badge bg-light text-primary ms-2 fs-6"
                          id="modalMaHangMuc"
                          style="display:none;">
                    </span>
                    <span class="badge ms-2 fs-6 border border-white"
                          id="modalTrangThaiHienThiText">
                    </span>
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                <!-- Loading spinner -->
                <div id="modalLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Đang tải dữ liệu...</p>
                </div>

                <!-- Nội dung modal (ẩn khi đang load) -->
                <div id="modalContent" style="display:none;">

                    <!-- TAB NAVIGATION -->
                    <ul class="nav nav-tabs mb-4" id="detailTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="detail-phieu-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-phieu"
                                    type="button" role="tab">
                                <i class="bi bi-file-earmark-text me-1"></i>Phiếu đăng ký
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="detail-phannhiem-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-phannhiem"
                                    type="button" role="tab">
                                <i class="bi bi-people me-1"></i>Phân nhiệm
                                <span id="modalPhanNhiemCount"
                                      class="badge bg-secondary ms-1">0</span>
                            </button>
                        </li>
                        <li class="nav-item d-none" id="tabPheDuyetItem" role="presentation">
                            <button class="nav-link" id="detail-pheduyet-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-pheduyet"
                                    type="button" role="tab">
                                <i class="bi bi-check2-circle me-1"></i>Phê duyệt
                            </button>
                        </li>
                        <li class="nav-item d-none" id="tabNhatKyItem" role="presentation">
                            <button class="nav-link" id="detail-nhatky-btn"
                                    data-bs-toggle="tab" data-bs-target="#detail-nhatky"
                                    type="button" role="tab">
                                <i class="bi bi-journal-text me-1"></i>Tiến độ thực hiện
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="detailTabsContent">

                        <!-- ===== TAB 1: PHIẾU ĐĂNG KÝ (READONLY) ===== -->
                        <div class="tab-pane fade show active"
                             id="detail-phieu" role="tabpanel">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Khu vực dự án
                                    </label>
                                    <select class="form-select" id="modal_AreaName">
                                        @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.DsKhuVucModal)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Bộ phận
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenPhongBan" disabled />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Mã hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_MaHangMuc" disabled />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-muted small">
                                        Tên hạng mục
                                    </label>
                                    <input type="text" class="form-control"
                                           id="modal_TenHangMuc" />
                                </div>
