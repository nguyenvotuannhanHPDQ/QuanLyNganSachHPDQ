@using PagedList.Mvc
@model PagedList.IPagedList<QuanLyNganSach.Models.ViewModels.BudgetRegistrationListViewModel>
@{
    ViewBag.Title = "Danh sách đăng ký ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Danh sách đăng ký ngân sách
                    </li>
                </ol>
            </nav>

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0 fw-semibold">
                        <i class="bi bi-card-list text-primary me-2"></i>
                        Danh sách đăng ký ngân sách
                    </h4>
                    <small class="text-muted">
                        Tổng số: <span>@Model.TotalItemCount</span> đăng ký
                    </small>
                </div>
                <a href="@Url.Action("Create", "Budget")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Đăng ký mới
                </a>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Html.Raw(TempData["Success"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Card chứa bảng -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    @using (Html.BeginForm("Index", "Budget", FormMethod.Get, new { id = "searchForm" }))
                    {
                        <div class="row align-items-center g-2">
                            <!-- SEARCH -->
                            <div class="col-12 col-md-5 col-lg-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           id="searchInput"
                                           name="search"
                                           value="@ViewBag.CurrentSearch"
                                           class="form-control"
                                           placeholder="Tìm kiếm theo mã, tên hạng mục...">
                                    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch))
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                id="clearSearch"
                                                title="Xóa tìm kiếm">
                                            <i class="bi bi-x-lg"></i>Clear
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- PHÒNG BAN (Manager/Admin) -->
                            @if (ViewBag.IsManagerOrAdmin == true)
                            {
                                <div class="col-12 col-md-4 col-lg-3">
                                    <select id="phongBanId"
                                            name="phongBanId"
                                            class="form-select form-select-sm">
                                        @foreach (var item in ViewBag.PhongBanList as List<SelectListItem>)
                                        {
                                            <option value="@item.Value" @(item.Selected ? "selected" : "")>
                                                @item.Text
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- SORT -->
                            <div class="col-12 col-md-3 col-lg-2">
                                <select id="sortOrder"
                                        name="sortOrder"
                                        class="form-select form-select-sm">
                                    <option value="newest" @(ViewBag.CurrentSort == "newest" ? "selected" : "")>
                                        Ngày tạo mới nhất
                                    </option>
                                    <option value="oldest" @(ViewBag.CurrentSort == "oldest" ? "selected" : "")>
                                        Ngày tạo cũ nhất
                                    </option>
                                    <option value="budget-high" @(ViewBag.CurrentSort == "budget-high" ? "selected" : "")>
                                        Dự toán cao - thấp
                                    </option>
                                    <option value="budget-low" @(ViewBag.CurrentSort == "budget-low" ? "selected" : "")>
                                        Dự toán thấp - cao
                                    </option>
                                </select>
                            </div>
                        </div>
                    }

                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <!-- Budget Cards - One card per row -->
                        <div class="budget-cards-container">
                            @{ int cardIndex = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
                            @foreach (var item in Model)
                            {
                                <div class="card mb-3 shadow-sm border-0 budget-card-horizontal">
                                    <div class="card-body">
                                        <div class="row align-items-center g-3">
                                            <!-- Column 1: STT & Status Badge -->
                                            <div class="col-auto">
                                                <div class="text-center">
                                                    <div class="badge bg-light text-dark border mb-2" style="width: 50px; height: 50px; line-height: 50px; font-size: 1.2rem; border-radius: 10px;">
                                                        #@cardIndex
                                                    </div>
                                                    @if (item.TrangThai == 1)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-info-circle"></i> Hồ sơ đủ thông tin
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="bi bi-info-circle"></i> Chưa đủ thông tin
                                                        </span>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Column 2: Mã hạng mục & Ngày tạo -->
                                            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                                                <div class="mb-2">
                                                    <span class="badge bg-secondary bg-gradient px-3 py-2 w-100">
                                                        <i class="bi bi-tag-fill"></i> @item.MaHangMuc
                                                    </span>
                                                </div>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar-plus"></i>
                                                    @item.NgayTao.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>

                                            <!-- Column 3: Tên hạng mục & Phòng ban -->
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                                <h6 class="mb-1 fw-bold">
                                                    <a href="@Url.Action("Details", "Budget", new { id = item.BudgetRegistrationId })"
                                                       class="text-decoration-none text-dark"
                                                       title="@item.TenHangMuc">
                                                        @item.TenHangMuc
                                                    </a>
                                                </h6>
                                                <div class="text-muted small">
                                                    <i class="bi bi-building text-primary"></i>
                                                    @item.TenPhongBan
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.NguoiDangKy))
                                                {
                                                    <div class="text-muted small mt-1">
                                                        <i class="bi bi-journal-text"></i>
                                                        @item.NguoiDangKy
                                                    </div>
                                                }
                                            </div>

                                            <!-- Column 4: Dự toán - Highlighted -->
                                            <div class="col-6 col-sm-6 col-md-3 col-lg-2">
                                                <div class="p-2 bg-success bg-opacity-10 rounded text-center">
                                                    <small class="text-muted d-block">
                                                        <i class="bi bi-currency-dollar"></i> Dự toán
                                                    </small>
                                                    <div class="fw-bold text-success fs-5">
                                                        @item.DuToan.ToString("N0")
                                                    </div>
                                                    <small class="text-muted">VNĐ</small>
                                                </div>
                                            </div>

                                            <!-- Column 5: Thời gian -->
                                            <div class="col-6 col-sm-6 col-md-2 col-lg-2">
                                                <div class="small">
                                                    <div class="mb-1">
                                                        <i class="bi bi-calendar-event text-primary"></i>
                                                        @if (item.NgayBatDau.HasValue)
                                                        {
                                                            <span class="text-muted">@item.NgayBatDau.Value.ToString("dd/MM/yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">--</span>
                                                        }
                                                    </div>
                                                    <div>
                                                        <i class="bi bi-calendar-check text-success"></i>
                                                        @if (item.NgayBatDau.HasValue)
                                                        {
                                                            <span class="text-muted">@item.NgayKetThuc.Value.ToString("dd/MM/yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">--</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Column 6: Actions -->
                                            <div class="col-12 col-sm-6 col-md-12 col-lg-3">
                                                <div class="d-flex gap-2 justify-content-lg-end justify-content-start">
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm flex-fill flex-lg-grow-0 btn-view-modal"
                                                            data-budget-id="@item.BudgetRegistrationId"
                                                            title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i> Xem
                                                    </button>
                                                    @*@if (item.TrangThai == "Chờ duyệt")
                                                    {
                                                        <a href="@Url.Action("Edit", "Budget", new { id = item.BudgetRegistrationId })"
                                                           class="btn btn-outline-warning btn-sm flex-fill flex-lg-grow-0"
                                                           title="Chỉnh sửa">
                                                            <i class="bi bi-pencil"></i> Sửa
                                                        </a>
                                                        <button type="button"
                                                                class="btn btn-outline-danger btn-sm flex-fill flex-lg-grow-0 btn-delete"
                                                                data-budget-id="@item.BudgetRegistrationId"
                                                                data-budget-name="@item.TenHangMuc"
                                                                title="Xóa">
                                                            <i class="bi bi-trash"></i> Xóa
                                                        </button>
                                                    }*@
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card left border indicator -->
                                    <div class="position-absolute top-0 start-0 h-100 bg-primary" style="width: 4px;"></div>
                                </div>
                                cardIndex++;
                            }
                        </div>
                    }
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="card-footer bg-light py-3">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Hiển thị @Model.Count / @Model.TotalItemCount đăng ký
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-clock-history"></i>
                                    Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-6">
                                <div class="pagination-wrapper">
                                    @if (Model.PageCount > 1)
                                    {
                                        <nav aria-label="Phân trang">
                                            <ul class="pagination pagination-sm mb-0 justify-content-center justify-content-md-end">
                                                <!-- First page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Đầu</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Đầu</span>
                                                    }
                                                </li>

                                                <!-- Previous page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Trước</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Trước</span>
                                                    }
                                                </li>

                                                <!-- Page numbers -->
                                                @{
                                                    int startPage = Math.Max(1, Model.PageNumber - 2);
                                                    int endPage = Math.Min(Model.PageCount, Model.PageNumber + 2);

                                                    if (Model.PageNumber <= 3)
                                                    {
                                                        endPage = Math.Min(5, Model.PageCount);
                                                    }

                                                    if (Model.PageNumber >= Model.PageCount - 2)
                                                    {
                                                        startPage = Math.Max(1, Model.PageCount - 4);
                                                    }
                                                }

                                                @for (int i = startPage; i <= endPage; i++)
                                                {
                                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                        @if (i == Model.PageNumber)
                                                        {
                                                            <span class="page-link">@i</span>
                                                        }
                                                        else
                                                        {
                                                            <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">@i</a>
                                                        }
                                                    </li>
                                                }

                                                <!-- Next page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Sau</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Sau</span>
                                                    }
                                                </li>

                                                <!-- Last page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageCount, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Cuối</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Cuối</span>
                                                    }
                                                </li>
                                            </ul>
                                        </nav>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Modal Chi tiết đăng ký ngân sách -->
<div class="modal fade" id="budgetDetailModal" tabindex="-1" aria-labelledby="budgetDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="budgetDetailModalLabel">
                    <i class="bi bi-file-earmark-text"></i> Chi tiết đăng ký ngân sách
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body" id="modalBodyContent">
                <!-- Loading State -->
                <div class="text-center py-5" id="modalLoading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-3 text-muted">Đang tải thông tin...</p>
                </div>

                <!-- Content will be loaded here -->
                <div id="modalContentContainer" style="display: none;">
                    <!-- Tabs Navigation -->
                    <ul class="nav nav-tabs mb-3" id="budgetDetailModalTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="modal-info-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#modal-info-tab-pane"
                                    type="button"
                                    role="tab"
                                    aria-controls="modal-info-tab-pane"
                                    aria-selected="true">
                                <i class="bi bi-info-circle"></i> Thông tin đăng ký
                            </button>
                        </li>
                        <li class="nav-item" role="presentation" id="modal-approval-tab-li" style="display: none;">
                            <button class="nav-link"
                                    id="modal-approval-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#modal-approval-tab-pane"
                                    type="button"
                                    role="tab"
                                    aria-controls="modal-approval-tab-pane"
                                    aria-selected="false">
                                <i class="bi bi-clipboard-check"></i> Theo dõi phê duyệt
                            </button>
                        </li>
                        <li class="nav-item" role="presentation" id="modal-progress-tab-li" style="display: none;">
                            <button class="nav-link"
                                    id="modal-progress-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#modal-progress-tab-pane"
                                    type="button"
                                    role="tab"
                                    aria-controls="modal-progress-tab-pane"
                                    aria-selected="false">
                                <i class="bi bi-bar-chart-line"></i> Theo dõi tiến độ
                            </button>
                        </li>
                    </ul>

                    <!-- Tabs Content -->
                    <div class="tab-content" id="budgetDetailModalTabsContent">
                        <!-- Tab 1: Thông tin đăng ký -->
                        <div class="tab-pane fade show active"
                             id="modal-info-tab-pane"
                             role="tabpanel"
                             aria-labelledby="modal-info-tab"
                             tabindex="0">

                            <div class="card border-0">
                                <div class="card-body">
                                    <!-- Row 1: Bộ phận, Mã hạng mục -->
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Bộ phận</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-tenPhongBan"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Mã hạng mục</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-maHangMuc"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Người đăng ký</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-nguoiDangKy"
                                                   readonly />
                                            <small class="text-muted" id="modal-emailNguoiDangKy"></small>
                                        </div>
                                    </div>

                                    <!-- Row 2: Tên hạng mục, Dự toán -->
                                    <div class="row">
                                        <div class="col-md-8 mb-3">
                                            <label class="form-label fw-semibold">Tên hạng mục</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-tenHangMuc"
                                                   readonly />
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Dự toán</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-duToan"
                                                   readonly />
                                        </div>
                                    </div>

                                    <!-- Row 3: Số tờ trình -->
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Số tờ trình</label>
                                        <input type="text"
                                               class="form-control"
                                               id="modal-soToTrinh"
                                               readonly />
                                    </div>

                                    <!-- Row 4: Loại hạng mục, Mức ưu tiên, Số lượng -->
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Loại hạng mục</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-categoryTypeName"
                                                   readonly />
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Mức ưu tiên</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-priorityLevelName"
                                                   readonly />
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Số lượng</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-soLuong"
                                                   readonly />
                                        </div>
                                    </div>

                                    <!-- Row 5: Lý do đầu tư -->
                                    <div class="row">
                                        <div class="col-12 mb-3">
                                            <label class="form-label fw-semibold">Lý do đầu tư</label>
                                            <textarea class="form-control"
                                                      rows="4"
                                                      id="modal-lyDoDauTu"
                                                      readonly></textarea>
                                        </div>
                                    </div>

                                    <!-- Row 6: Mô tả kỹ thuật -->
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Mô tả kỹ thuật</label>
                                        <textarea class="form-control"
                                                  rows="4"
                                                  id="modal-moTaKyThuat"
                                                  readonly></textarea>
                                    </div>

                                    <!-- Row 7: Ngày bắt đầu, Ngày kết thúc, Ngày tạo -->
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Ngày bắt đầu</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-ngayBatDau"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Ngày kết thúc</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-ngayKetThuc"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label fw-semibold">Ngày tạo</label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="modal-ngayTao"
                                                   readonly />
                                        </div>
                                    </div>

                                    <!-- Row 8: Hồ sơ căn cứ -->
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-semibold">Hồ sơ căn cứ</label>
                                            <div id="modal-attachments"></div>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-semibold">Link tài liệu liên quan</label>
                                            <div id="modal-linkTaiLieu"></div>
                                        </div>
                                    </div>

                                    <!-- Row 9: Xác nhận luồng quy trình - CHỈ ADMIN/MANAGER -->
                                    <div class="row" id="modal-workflow-container" style="display: none;">
                                        <div class="col-12 mb-3">
                                            <div class="alert alert-warning" role="alert">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <strong>Lưu ý:</strong> Việc chọn luồng quy trình sẽ ảnh hưởng đến các tab hiển thị và quy trình phê duyệt.
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-semibold">
                                                Xác nhận luồng quy trình <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-select" id="modal-workflowType">
                                                <option value="0">-- Chưa xác định --</option>
                                                <option value="1">Theo luồng ngân sách đầu tư</option>
