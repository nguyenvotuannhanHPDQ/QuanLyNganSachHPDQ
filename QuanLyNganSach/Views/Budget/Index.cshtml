                                <label class="form-label fw-semibold text-muted small">
                                    <i class="bi bi-pencil me-1"></i>Lý do chỉnh sửa
                                    <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control" id="modal_LyDoChinhSua"
                                          rows="2" placeholder="Nhập lý do chỉnh sửa..."></textarea>
                            </div>
                        </div>

                        <!-- ===== TAB 2: PHÂN NHIỆM (EDITABLE) ===== -->
                        <div class="tab-pane fade"
                             id="detail-phannhiem" role="tabpanel">
                            <div class="d-flex justify-content-between
                                align-items-center mb-3">
                                <h6 class="fw-semibold mb-0">
                                    <i class="bi bi-people-fill me-1"></i>
                                    Danh sách phân nhiệm
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            id="btnModalThemDong">
                                        <i class="bi bi-plus-circle me-1"></i>Thêm dòng
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            id="btnHuySearchPhanNhiem"
                                            style="display:none;">
                                        <i class="bi bi-x-circle"></i> Hủy tìm kiếm
                                    </button>
                                </div>
                            </div>
                            <!-- *** THÊM MỚI: Search + Filter Phân nhiệm *** -->
                            <div class="row g-2 mb-3" id="phanNhiemFilterRow">

                                <!-- Search tên nhân viên -->
                                <div class="col-md-4">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">
                                            <i class="bi bi-search"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control"
                                               id="pn_SearchTen"
                                               placeholder="Tìm theo tên nhân viên..." />
                                    </div>
                                </div>

                                <!-- Filter Bộ phận -->
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm"
                                            id="pn_FilterPhongBan">
                                        <option value="">-- Tất cả bộ phận --</option>
                                        @foreach (SelectListItem item in
                                            (IEnumerable<SelectListItem>)ViewBag.DsKhuVucModal)
                                        {
                                            <!-- Dùng DsPhongBanModal thay vì DsKhuVucModal -->
                                        }
                                    </select>
                                </div>

                                <!-- Filter Chức năng/Nhiệm vụ -->
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm"
                                            id="pn_FilterChucNang">
                                        <option value="">-- Tất cả chức năng --</option>
                                    </select>
                                </div>

                                <!-- Nút reset -->
                                <div class="col-md-2">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm w-100"
                                            id="btnResetPhanNhiemFilter">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                                    </button>
                                </div>

                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover
                                      align-middle" id="tblModalPhanNhiem">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:5%">#</th>
                                            <th style="width:22%">
                                                Tên Bộ phận
                                                <span class="text-danger">*</span>
                                            </th>
                                            <th style="width:22%">Nhân viên <span class="text-danger">*</span></th>
                                            <th style="width:25%">
                                                Chức năng / Nhiệm vụ
                                                <span class="text-danger">*</span>
                                            </th>
                                            <th style="width:20%">Email liên hệ <span class="text-danger">*</span></th>
                                            <th style="width:22%">Ghi chú</th>
                                            <th style="width:6%"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="modalPhanNhiemBody"></tbody>
                                </table>
                            </div>
                            <p class="text-muted small mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Chọn chức năng từ danh sách hoặc nhập trực tiếp
                                vào ô bên dưới nếu không có trong danh sách.
                            </p>
                        </div>

                        <!-- ===== TAB 3: PHÊ DUYỆT (PLACEHOLDER) ===== -->
                        <div class="tab-pane fade"
                             id="detail-pheduyet" role="tabpanel">
                            <!-- 2 CARD TỔNG HỢP -->
                            <div class="row g-3 mb-3">

                                <!-- Card Đang trình -->
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
                                        <div class="card-body py-3">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="text-muted small mb-1">
                                                        <i class="bi bi-hourglass-split me-1"></i>
                                                        Tổng ngân sách đang trình
                                                    </p>
                                                    <h5 class="fw-bold text-warning mb-0"
                                                        id="card_TongDangTrinh">
                                                        0 ₫
                                                    </h5>
                                                </div>
                                                <div class="bg-warning bg-opacity-10 rounded p-2">
                                                    <i class="bi bi-clock text-warning fs-5"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Đã duyệt -->
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                                        <div class="card-body py-3">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="text-muted small mb-1">
                                                        <i class="bi bi-check-circle me-1"></i>
                                                        Tổng ngân sách đã duyệt
                                                    </p>
                                                    <h5 class="fw-bold text-success mb-0"
                                                        id="card_TongDaDuyet">
                                                        0 ₫
                                                    </h5>
                                                </div>
                                                <div class="bg-success bg-opacity-10 rounded p-2">
                                                    <i class="bi bi-check2-circle text-success fs-5"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <!-- CARD NGÂN SÁCH GỐC -->
                            <div class="card border-primary mb-3" id="cardNganSachGoc">
                                <div class="card-header bg-primary text-white d-flex
            justify-content-between align-items-center py-2">
                                    <span class="fw-semibold">
                                        <i class="bi bi-wallet2 me-1"></i>Ngân sách gốc
                                    </span>
                                    <!-- Dropdown Khởi tạo quy trình — chỉ Admin/Manager -->
                                    <div id="processTypeSection" style="display:none;">
                                        <select class="form-select form-select-sm w-auto"
                                                id="pd_ProcessType" style="min-width:200px;">
                                            <option value="1">Theo QT Tập đoàn</option>
                                            <option value="2">Theo QT Công ty</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="card-body">

                                    <!-- TIẾN ĐỘ DUYỆT -->
                                    <h6 class="fw-semibold text-muted mb-3">
                                        <i class="bi bi-calendar-check me-1"></i>Tiến độ duyệt
                                    </h6>
                                    <div class="row g-3 mb-4" id="tienDoDuyetRow">

                                        <!-- PDA -->
                                        <div class="col-md-2 col-sm-4">
                                            <label class="form-label small fw-semibold">PDA</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetPDA" data-moc="PDA" />
                                            <small class="text-danger moc-error" id="error-pd_NgayDuyetPDA" style="display:none;"></small>
                                        </div>

                                        <!-- PKT -->
                                        <div class="col-md-2 col-sm-4">
                                            <label class="form-label small fw-semibold">PKT</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetPKT" data-moc="PKT"
                                                   data-requires="pd_NgayDuyetPDA" disabled />
                                            <small class="text-danger moc-error" id="error-pd_NgayDuyetPKT" style="display:none;"></small>
                                        </div>

                                        <!-- ERPD — chỉ hiện khi ProcessType = 1 -->
                                        <div class="col-md-2 col-sm-4 moc-tapDoan" style="display:none;">
                                            <label class="form-label small fw-semibold">ERPD</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetERPD" data-moc="ERPD"
                                                   data-requires="pd_NgayDuyetPKT" disabled />
                                            <small class="text-danger moc-error" id="error-pd_NgayDuyetERPD" style="display:none;"></small>
                                        </div>

                                        <!-- BTC — chỉ hiện khi ProcessType = 1 -->
                                        <div class="col-md-2 col-sm-4 moc-tapDoan" style="display:none;">
                                            <label class="form-label small fw-semibold">BTC</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetBTC" data-moc="BTC"
                                                   data-requires="pd_NgayDuyetERPD" disabled />
                                            <small class="text-danger moc-error" id="error-pd_NgayDuyetBTC" style="display:none;"></small>
                                        </div>

                                        <!-- BGĐ -->
                                        <div class="col-md-2 col-sm-4" id="colBGD">
                                            <label class="form-label small fw-semibold">BGĐ</label>
                                            <input type="date" class="form-control form-control-sm moc-ngay"
                                                   id="pd_NgayDuyetBGD" data-moc="BGD"
                                                   data-requires-congty="pd_NgayDuyetPKT"
                                                   data-requires-tapDoan="pd_NgayDuyetBTC" disabled />
                                            <small class="text-danger moc-error" id="error-pd_NgayDuyetBGD" style="display:none;"></small>
                                        </div>

                                    </div>

                                    <!-- NGÂN SÁCH PHÊ DUYỆT -->
                                    <h6 class="fw-semibold text-muted mb-3">
                                        <i class="bi bi-currency-exchange me-1"></i>Ngân sách phê duyệt
                                    </h6>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Dự toán gốc (VND)
                                            </label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_DuToanGoc" readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Ngân sách phê duyệt (VND)
                                            </label>
                                            <!-- *** THAY ĐỔI: bỏ input-group, bỏ button, thêm disabled mặc định *** -->
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_DuToanPheDuyet"
                                                   placeholder="Chưa có ngày duyệt BGĐ"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end">
                                            <span class="badge fs-6 p-2" id="badgeTrangThaiPheDuyet"></span>
                                        </div>
                                    </div>
                                    <!-- SỐ THÔNG BÁO + SỐ FM + SỐ IO -->
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Số thông báo
                                                <span class="text-danger" id="star_SoThongBao"
                                                      style="display:none;">*</span>
                                            </label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoThongBao"
                                                   placeholder="Nhập số thông báo"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Số FM
                                                <span class="text-danger" id="star_SoFM"
                                                      style="display:none;">*</span>
                                            </label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoFM"
                                                   placeholder="Nhập số FM"
                                                   readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">
                                                Số IO
                                                <span class="text-danger" id="star_SoIO"
                                                      style="display:none;">*</span>
                                            </label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="pd_SoIO"
                                                   placeholder="Nhập số IO"
                                                   readonly />
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- CONTAINER CÁC CARD BỔ SUNG (render động) -->
                            <div id="containerBoSung"></div>

                            <!-- BUTTON THÊM BỔ SUNG -->
                            <div class="d-flex justify-content-start mb-3">
                                <button type="button" class="btn btn-outline-success btn-sm"
                                        id="btnThemBoSung">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm bổ sung ngân sách
                                </button>
                            </div>
                        </div>

                        <!-- ===== TAB 4: NHẬT KÝ TIẾN ĐỘ (PLACEHOLDER) ===== -->
                        <div class="tab-pane fade" id="detail-nhatky" role="tabpanel">
                            <div class="tab-pane fade show active" id="detail-nhatky" role="tabpanel">

                                <!-- ── VÙNG 1: TỔNG QUAN TIẾN ĐỘ ── -->
