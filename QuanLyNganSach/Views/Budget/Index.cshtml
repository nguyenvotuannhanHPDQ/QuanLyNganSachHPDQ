                                            Hồ sơ thiếu thông tin
                                        </option>*@
                                </select>
                            </div>
                        </div>
                    </div>

                </div><!-- end modalContent -->
            </div><!-- end modal-body -->
            <!-- Modal nhập lý do trả hồ sơ -->
            <div class="modal fade" id="traHoSoModal" tabindex="-1"
                 data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-info">
                            <h6 class="modal-title fw-bold">
                                <i class="bi bi-arrow-return-left me-2"></i>
                                Xác nhận trả hồ sơ
                            </h6>
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label fw-semibold small">
                                Lý do trả hồ sơ <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control" id="txtLyDoTra"
                                      rows="3"
                                      placeholder="Nhập lý do trả hồ sơ..."></textarea>
                            <div class="text-danger small mt-1"
                                 id="errLyDoTra"
                                 style="display:none;">
                                Vui lòng nhập lý do trả hồ sơ.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>Hủy
                            </button>
                            <button type="button" class="btn btn-warning btn-sm"
                                    id="btnConfirmTraHoSo">
                                <i class="bi bi-arrow-return-left me-1"></i>Xác nhận trả hồ sơ
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                @if (ViewBag.IsManagerOrAdmin == true)
                {
                    <button type="button" class="btn btn-warning"
                            id="btnTraHoSo" style="display:none;">
                        <i class="bi bi-arrow-return-left me-1"></i>Trả hồ sơ
                    </button>
                }
                <button type="button" class="btn btn-info text-white"
                        id="btnGuiLai" style="display:none;">
                    <i class="bi bi-send me-1"></i>Gửi lại
                </button>
                <!-- Thêm vào modal-footer, chỉ render với user thường -->
                <button type="button" class="btn btn-warning"
                        id="btnChinhSua" style="display:none;">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                </button>
                <button type="button" class="btn btn-success"
                        id="btnGuiChinhSua" style="display:none;">
                    <i class="bi bi-send me-1"></i>Gửi thông tin chỉnh sửa
                </button>
                <button type="button" class="btn btn-primary" id="btnSaveDetailsModal">
                    <i class="bi bi-save me-1"></i>Lưu tất cả thông tin
                </button>
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
            </div>

        </div>
    </div>
</div>

