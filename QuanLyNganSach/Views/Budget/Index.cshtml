                                </div>
                            </div>

                            <!-- VÙNG 3: CHI TIẾT THEO KHU VỰC -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-semibold mb-0">
                                    <i class="bi bi-map me-1"></i>Chi tiết theo khu vực
                                </h6>
                                <button type="button" class="btn btn-outline-success btn-sm"
                                        id="btnThemKhuVuc">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm khu vực
                                </button>
