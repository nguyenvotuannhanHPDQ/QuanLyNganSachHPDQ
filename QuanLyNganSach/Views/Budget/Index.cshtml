                    + '<table class="table table-bordered table-sm '
                    + 'align-middle mb-2 tbl-khu-vuc">'
                    // Thay đoạn thead cũ trong taoCardKhuVuc
                    + '<thead class="table-light">'
                    + '<tr>'
                    + '<th style="min-width:200px">Hạng mục công việc</th>'
                    + '<th>Mô tả</th>' // *** THÊM MỚI cột Mô tả ***
                    + '<th style="width:80px">ĐVT</th>'
                    + '<th style="width:80px">KLHĐ</th>'
                    + '<th style="width:80px">KLTT</th>'
                    + '<th style="width:90px">% Tiến độ</th>'
