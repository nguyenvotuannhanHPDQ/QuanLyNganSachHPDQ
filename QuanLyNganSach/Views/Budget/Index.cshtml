                    + '<label class="form-label small fw-semibold">PKT</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_PKT_' + idx + '" data-index="' + idx + '" data-moc="PKT" '
                    + 'value="' + (data.NgayDuyetPKT
                        ? toDateInputValue(data.NgayDuyetPKT) : '') + '" disabled />'
                    + '</div>'

                    // ERPD
                    + '<div class="col-md-2 col-sm-4 bs-moc-tapDoan-' + idx + '" '
                    + 'style="display:' + (processType == 1 ? 'block' : 'none') + ';">'
                    + '<label class="form-label small fw-semibold">ERPD</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_ERPD_' + idx + '" data-index="' + idx + '" data-moc="ERPD" '
                    + 'value="' + (data.NgayDuyetERPD
                        ? toDateInputValue(data.NgayDuyetERPD) : '') + '" disabled />'
                    + '</div>'

                    // BTC
                    + '<div class="col-md-2 col-sm-4 bs-moc-tapDoan-' + idx + '" '
                    + 'style="display:' + (processType == 1 ? 'block' : 'none') + ';">'
                    + '<label class="form-label small fw-semibold">BTC</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_BTC_' + idx + '" data-index="' + idx + '" data-moc="BTC" '
                    + 'value="' + (data.NgayDuyetBTC
                        ? toDateInputValue(data.NgayDuyetBTC) : '') + '" disabled />'
                    + '</div>'

                    // BGĐ
                    + '<div class="col-md-2 col-sm-4">'
                    + '<label class="form-label small fw-semibold">BGĐ</label>'
                    + '<input type="date" class="form-control form-control-sm bs-moc-ngay" '
                    + 'id="bs_BGD_' + idx + '" data-index="' + idx + '" data-moc="BGD" '
                    + 'value="' + (data.NgayDuyetBGD
                        ? toDateInputValue(data.NgayDuyetBGD) : '') + '" disabled />'
                    + '</div>'

                    + '</div>' // end row tiến độ

                    // Lý do bổ sung + Ngân sách bổ sung
                    + '<div class="row g-3 mb-3">'
                    + '<div class="col-md-6">'
                    + '<label class="form-label small fw-semibold">Lý do bổ sung</label>'
                    + '<input type="text" class="form-control form-control-sm" '
                    + 'id="bs_LyDo_' + idx + '" '
                    + 'placeholder="Nhập lý do bổ sung..." '
                    + 'value="' + (data.LyDoBoSung || '') + '" />'
                    + '</div>'
                    + '<div class="col-md-3">'
                    + '<label class="form-label small fw-semibold">Ngân sách bổ sung (VND)</label>'
                    + '<input type="text" class="form-control form-control-sm bs-ngan-sach" '
                    + 'id="bs_NganSach_' + idx + '" '
                    + 'placeholder="0" '
                    + 'value="' + formatCurrencyBS(data.NganSachBoSung || 0) + '" />'
                    + '</div>'
                    + '<div class="col-md-3 d-flex align-items-end">'
                    + '<span class="badge fs-6 p-2 bs-badge-trang-thai" '
                    + 'id="bs_Badge_' + idx + '"></span>'
