            function loadUsersByPhongBan(phongBanId, $ddUser, selectedUserId, selectedText) {
                $ddUser.html('<option value="">Đang tải...</option>')
                       .prop('disabled', true)
                       .trigger("chosen:updated"); // Cập nhật trạng thái đang tải

                if (!phongBanId) {
                    $ddUser.html('<option value="">-- Chọn nhân viên --</option>')
                           .prop('disabled', false)
                           .trigger("chosen:updated");
                    return;
                }

                $.ajax({
                    url:  '@Url.Action("GetUsersByPhongBan", "Budget")',
                    type: 'GET',
                    data: { phongBanId: phongBanId },
                    success: function (res) {
                        var options = '<option value="">-- Chọn nhân viên --</option>';
                        if (res.success && res.data.length > 0) {
                            $.each(res.data, function (i, u) {
                                var selected = selectedUserId && u.value == selectedUserId ? 'selected' : '';
                                options += '<option value="' + u.value + '" ' + selected + '>' + u.text + '</option>';
                            });
                        }
                        // Sau khi đổ dữ liệu, kích hoạt hoặc cập nhật chosen
                        $ddUser.html(options).prop('disabled', false);

                        // Kích hoạt chosen nếu chưa có, hoặc cập nhật nếu đã có
                        if ($ddUser.next('.chosen-container').length > 0) {
                            $ddUser.trigger("chosen:updated");
                        } else {
                            $ddUser.chosen({ width: "100%" });
                        }
                    },
                    error: function () {
                        $ddUser.html('<option value="">-- Lỗi tải dữ liệu --</option>')
                               .prop('disabled', false)
                               .trigger("chosen:updated");
                    }
                });
            }

            // ── Modal: Load User khi đổi Phòng ban ───────────────────────
            $(document).on('change', '#modalPhanNhiemBody select[name*=PhongBanId]', function () {
                var phongBanId = $(this).val();
                var $ddUser = $(this).closest('tr').find('.dd-modal-user');
                loadUsersByPhongBan(phongBanId, $ddUser, null, null);
            });

            // ── Cập nhật STT + badge đếm dòng modal ─────────────────────
            function capNhatSTTModal() {
                var rows = $('#modalPhanNhiemBody tr');
                rows.each(function (i) {
                    $(this).find('.stt-modal').text(i + 1);
                });
                var count = rows.length;
                $('#modalPhanNhiemCount').text(count)
                    .toggleClass('bg-secondary', count === 0)
                    .toggleClass('bg-primary',   count > 0);
            }

            // ── Thêm dòng Phân nhiệm trong modal ────────────────────────
            $(document).on('click', '#btnModalThemDong', function () {
                if (isPhanNhiemSearchMode) {
                    alert("Bạn đang ở chế độ tìm kiếm. Vui lòng nhấn 'Hủy tìm kiếm' để có thể thêm mới hoặc chỉnh sửa dữ liệu.");
                    return;
                }
                var row = taoHtmlDongModal(modalRowIndex++);
                var $row = $(row);

                $('#modalPhanNhiemBody').append($row);

                // Kích hoạt chosen cho select Phòng ban của dòng vừa thêm
                $row.find('select[name*=PhongBanId]').chosen({ width: "100%" });

                capNhatSTTModal();
            });

            // ── Xóa dòng Phân nhiệm trong modal ─────────────────────────
            $(document).on('click', '.btnModalXoaDong', function () {
                $(this).closest('tr').remove();
                capNhatSTTModal();
            });

            // ── Validate tab Phân nhiệm trước khi lưu ────────────────────
            function validatePhanNhiem() {
                // *** THÊM MỚI: Bỏ qua validate khi đang ở search mode ***
                if (isPhanNhiemSearchMode) return true;

                var $rows = $('#modalPhanNhiemBody tr');

                // Chưa có dòng nào
                if ($rows.length === 0) {
                    showModalAlert('danger',
                        'Vui lòng thêm ít nhất một dòng phân nhiệm trước khi lưu.');
                    return false;
                }

                var isValid = true;
                var dongLoi = [];

                $rows.each(function (i) {
                    var $row = $(this);
                    var stt = i + 1;
                    var phongBan = $row.find('select[name*=PhongBanId]').val();
                    var userId = $row.find('.dd-modal-user').val();
                    var chucNang = $row.find('.ddModalChucNang').val();
                    var nhapTay = $row.find('.txtModalChucNangTay').val().trim();
                    var email = $row.find('input[name*=Email]').val().trim();

                    var loi = [];

                    if (!phongBan)
                        loi.push('Bộ phận');

                    if (!userId)
                        loi.push('Nhân viên');

                    if (!chucNang && !nhapTay)
                        loi.push('Chức năng / Nhiệm vụ');

                    if (!email)
                        loi.push('Email liên hệ');

                    if (loi.length > 0) {
                        dongLoi.push('Dòng ' + stt + ': thiếu ' + loi.join(', '));
                        isValid = false;
                    }
                });

                if (!isValid) {
                    showModalAlert('danger',
                        'Vui lòng điền đầy đủ thông tin bắt buộc ở tab Phân nhiệm:<br>'
                        + dongLoi.join('<br>'));
                }

                return isValid;
            }

            // ── Load dropdown filter khi modal mở ───────────────────────
            function initPhanNhiemFilters() {
                // Render dropdown Bộ phận từ dsPhongBan đã có
                var optionsPB = '<option value="">-- Tất cả bộ phận --</option>';
                $.each(dsPhongBan, function (i, pb) {
                    optionsPB += '<option value="' + pb.value + '">'
                               + pb.text + '</option>';
                });
                $('#pn_FilterPhongBan').html(optionsPB);

                // Render dropdown Chức năng từ dsChucNang đã có
                var optionsCN =
                    '<option value="">-- Tất cả chức năng --</option>';
                $.each(dsChucNang, function (i, cn) {
                    optionsCN += '<option value="' + cn.value + '">'
                               + cn.text + '</option>';
                });
                $('#pn_FilterChucNang').html(optionsCN);

                // *** THAY ĐỔI: Kích hoạt chosen cho 2 filter ***
                $('#pn_FilterPhongBan').chosen({
                    width: "100%"
                });
            }

            // ── Gọi API SearchPhanNhiem ──────────────────────────────────
            function searchPhanNhiem() {
                if (!currentBudgetId) return;

                $.ajax({
                    url:  '@Url.Action("SearchPhanNhiem", "Budget")',
                    type: 'GET',
                    data: {
                        budgetRegistrationId: currentBudgetId,
                        search:      $('#pn_SearchTen').val().trim(),
                        phongBanId:  $('#pn_FilterPhongBan').val()  || null,
                        chucNangId:  $('#pn_FilterChucNang').val()  || null
                    },
                    success: function (res) {
                        if (!res.success) return;
                        isPhanNhiemSearchMode = true; // *** THÊM ***
                        $('#btnHuySearchPhanNhiem').show();
                        renderPhanNhiemReadonly(res.data);
                    }
                });
            }

            // ── Render bảng Phân nhiệm từ kết quả search ────────────────
            function renderPhanNhiemReadonly(data) {
                var $tbody = $('#modalPhanNhiemBody');
                $tbody.empty();

                if (!data || data.length === 0) {
                    $tbody.append(
                        '<tr><td colspan="7" class="text-center text-muted">'
                        + 'Không tìm thấy dữ liệu.</td></tr>');
                    // Cập nhật badge đếm
                    $('#modalPhanNhiemCount').text(0)
                        .removeClass('bg-primary').addClass('bg-secondary');
                    return;
                }

                $.each(data, function (i, pn) {
                    var chucNang = pn.TenChucNang || pn.TenChucNangNhapTay || '--';
                    var $tr = $(
                        '<tr>'
                        + '<td class="text-center stt-modal">' + (i + 1) + '</td>'
                        + '<td>' + (pn.TenPhongBan || '--') + '</td>'
                        + '<td>' + (pn.TenUser     || '--') + '</td>'
                        + '<td>' + chucNang + '</td>'
                        + '<td>' + (pn.Email  || '--') + '</td>'
                        + '<td>' + (pn.GhiChu || '--') + '</td>'
                        + '<td></td>'
                        + '</tr>');
                    $tbody.append($tr);
                });

                // Cập nhật badge đếm
                $('#modalPhanNhiemCount').text(data.length)
                    .removeClass('bg-secondary').addClass('bg-primary');
            }

            // ── Lắng nghe thay đổi filter ────────────────────────────────
            var searchTimer = null;
            $(document).on('input', '#pn_SearchTen', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(searchPhanNhiem, 400); // debounce
            });

            $(document).on('change',
                '#pn_FilterPhongBan, #pn_FilterChucNang',
                function () { searchPhanNhiem(); });

            // ── Nút đặt lại ──────────────────────────────────────────────
            $(document).on('click', '#btnResetPhanNhiemFilter', function () {
                $('#pn_SearchTen').val('');
                // Cập nhật chosen
                $('#pn_FilterPhongBan').val('').trigger("chosen:updated");
                $('#pn_FilterChucNang').val('');
                searchPhanNhiem();
            });

            // ── Expose hàm init để gọi khi modal mở ─────────────────────
            window.initPhanNhiemFilters = initPhanNhiemFilters;
            window.searchPhanNhiem      = searchPhanNhiem;

            // ── Nút Lưu thông tin ────────────────────────────────────────
            $(document).on('click', '#btnSaveDetailsModal', function () {
                var $btn = $(this);

                if (!validatePhanNhiem()) return;

                if (isManagerOrAdminGlobal) {
                    // *** THÊM MỚI: Validate 3 field bắt buộc khi có ngày BGĐ ***
                    var bgdVal = $('#pd_NgayDuyetBGD').val();
                    if (!!bgdVal) {
                        var soThongBao = $('#pd_SoThongBao').val().trim();
                        var soFM = $('#pd_SoFM').val().trim();
                        var soIO = $('#pd_SoIO').val().trim();
                        var loiThieu = [];

                        if (!soThongBao) loiThieu.push('Số thông báo');
                        if (!soFM) loiThieu.push('Số FM');
                        if (!soIO) loiThieu.push('Số IO');

                        if (loiThieu.length > 0) {
                            showModalAlert('danger',
                                'Vui lòng nhập đầy đủ thông tin bắt buộc khi đã có ngày duyệt BGĐ: '
                                + loiThieu.join(', ') + '.');
                            // Chuyển sang tab Phê duyệt để user thấy lỗi
                            $('#detail-pheduyet-btn').tab('show');
                            return;
                        }
                    }
                }

                var tongTiTrong = (parseFloat($('#cfg_XayDung').val()) || 0)
                    + (parseFloat($('#cfg_KetCauThep').val()) || 0)
                    + (parseFloat($('#cfg_LapDatThietBi').val()) || 0)
                    + (parseFloat($('#cfg_HangMucKhac').val()) || 0);

                if (Math.abs(tongTiTrong - 100) > 0.01 && tongTiTrong > 0) {
                    showModalAlert('danger',
                        'Tổng tỉ trọng đang là ' + tongTiTrong.toFixed(2)
                        + '%. Vui lòng điều chỉnh để tổng = 100% trước khi lưu.');
                    return;
                }

                // Thu thập dữ liệu Phân nhiệm từ các dòng trong bảng
                var danhSachPhanNhiem = [];
                if (!isPhanNhiemSearchMode) {
                    // *** Chỉ collect khi không ở search mode ***
                    $('#modalPhanNhiemBody tr').each(function () {
                        var $row = $(this);
                        var idx = $row.data('index');
                        var phongBanId = $row.find('select[name*=PhongBanId]').val();
                        if (!phongBanId) return; // bỏ dòng chưa chọn phòng ban

                        danhSachPhanNhiem.push({
                            PhongBanId: phongBanId,
                            UserId: $row.find('.dd-modal-user').val() || null,
                            ChucNangNhiemVuId: $row.find('.ddModalChucNang').val() || null,
                            TenChucNangNhapTay: $row.find('.txtModalChucNangTay').val() || null,
                            Email: $row.find('input[name*=Email]').val() || null,
                            GhiChu: $row.find('input[name*=GhiChu]').val() || null
                        });
                    });
                }

                var payload = {
                    BudgetRegistrationId: currentBudgetId,
                    WorkflowType:         $('#modal_WorkflowType').val() || null,
                    DanhSachPhanNhiem: danhSachPhanNhiem,
