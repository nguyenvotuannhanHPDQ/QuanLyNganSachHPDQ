@model  QuanLyNganSach.Models.ViewModels.CreateBudgetRegistrationViewModel
@{
    ViewBag.Title = "Đăng ký hồ sơ ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var user = ViewBag.CurrentUser as QuanLyNganSach.Models.Auth.LoggedInUser;
}

<div class="container-fluid mt-2 mb-5 px-1">
    <div class="row">
        <div class="col-12">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="text-decoration-none">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Đăng ký kế hoạch ngân sách
                    </li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header text-bg-primary py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-file-earmark-text-fill me-1"></i>
                        Đăng ký kế hoạch ngân sách
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Create", "Budget", FormMethod.Post,
                                           new { enctype = "multipart/form-data", id = "mainForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <ul class="nav nav-tabs mb-4" id="budgetTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-semibold" id="tab-phieu-btn"
                                        data-bs-toggle="tab" data-bs-target="#tab-phieu"
                                        type="button" role="tab">
                                    <i class="bi bi-file-earmark-text me-1"></i>Phiếu đăng ký
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-semibold" id="tab-phannhiem-btn"
                                        data-bs-toggle="tab" data-bs-target="#tab-phannhiem"
                                        type="button" role="tab">
                                    <i class="bi bi-people me-1"></i>Phân nhiệm
                                    <span id="phanNhiemCount" class="badge bg-secondary ms-1">0</span>
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="budgetTabsContent">

                            <div class="tab-pane fade show active" id="tab-phieu" role="tabpanel">

                                <div class="row">
                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            Khu vực dự án <span class="text-danger">*</span>
                                        </label>

                                        @* Sửa cách render Dropdown để đính kèm thuộc tính data-is-custom *@
                                        <select Convert.ToString(Model.ProjectAreaId) name="ProjectAreaId" id="ProjectAreaId" class="form-select">
                                            <option value="">-- Chọn khu vực --</option>
                                            @if (Model.DanhSachKhuVuc != null)
                                            {
                                                foreach (var item in Model.DanhSachKhuVuc)
                                                {
                                                    // Giả định SelectListItem của bạn có thể chứa dữ liệu Custom thông qua việc ép kiểu hoặc select list đặc thù.
                                                    // Để đơn giản và an toàn nhất, ta sẽ check text hoặc value tùy thuộc vào cách bạn gán ở hàm GetProjectAreaSelectList()
                                                    <option value="@item.Value"
                                                            selected="@(item.Selected)"
                                                            data-is-custom="@(item.Text.Contains("khác") || item.Value == "khac" ? "true" : "false")">
                                                        @item.Text
                                                    </option>
                                                }
                                            }
                                        </select>
                                        @Html.ValidationMessageFor(m => m.ProjectAreaId, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3" id="divProjectAreaCustom" style="display: none;">
                                        <label class="form-label fw-semibold text-danger">
                                            Tên khu vực mới <span class="text-danger">*</span>
                                        </label>
                                        @Html.TextBoxFor(m => m.ProjectAreaCustom, new { @class = "form-control", placeholder = "Nhập tên khu vực khác..." })
                                        @Html.ValidationMessageFor(m => m.ProjectAreaCustom, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Bộ phận</label>
                                        <input type="text" class="form-control bg-light" value="@user.TenPhongBan" readonly />
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Loại hạng mục <span class="text-danger">*</span></label>
                                        @Html.DropDownListFor(m => m.CategoryTypeId, Model.CategoryTypes, "-- Chọn --", new { @class = "form-select" })
                                        @Html.ValidationMessageFor(m => m.CategoryTypeId, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Mức ưu tiên <span class="text-danger">*</span></label>
                                        @Html.DropDownListFor(m => m.PriorityLevelId, Model.PriorityLevels, "-- Chọn --", new { @class = "form-select" })
                                        @Html.ValidationMessageFor(m => m.PriorityLevelId, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    @Html.HiddenFor(m => m.MaHangMuc)
                                </div>

                                <div class="row">
                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Tên hạng mục <span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(m => m.TenHangMuc, new { @class = "form-control", placeholder = "Nhập tên hạng mục..." })
                                        @Html.ValidationMessageFor(m => m.TenHangMuc, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Dự toán <span class="text-danger">*</span></label>
                                        @Html.HiddenFor(m => m.DuToan, new { id = "DuToan_Hidden" })
                                        <input type="text" id="DuToan_Display" class="form-control fw-semibold text-primary" placeholder="Nhập dự toán..." autocomplete="off" />
                                        @Html.ValidationMessageFor(m => m.DuToan, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Số lượng</label>
                                        @Html.TextBoxFor(m => m.SoLuong, new { @class = "form-control text-center", type = "number", placeholder = "0", min = 0 })
                                        @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Số tờ trình</label>
                                        @Html.TextBoxFor(m => m.SoToTrinh, new { @class = "form-control", placeholder = "Nhập số tờ trình..." })
                                        @Html.ValidationMessageFor(m => m.SoToTrinh, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-semibold">Lý do đầu tư <span class="text-danger">*</span></label>
                                        @Html.DropDownListFor(m => m.InvestmentReasonId,
                                            Model.InvestmentReasons ?? new List<SelectListItem>(),
                                            "-- Chọn lý do đầu tư --",
                                            new { @class = "form-select", id = "ddlInvestmentReason" })

                                        @Html.ValidationMessageFor(m => m.InvestmentReasonId, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-12 mb-3" id="divLyDoNhapTay" style="display: none;">
                                        <label class="form-label fw-semibold text-primary">
                                            <i class="bi bi-pencil-square me-1"></i>Lý do đầu tư (điền thủ công)
                                        </label>
                                        @Html.TextAreaFor(m => m.LyDoDauTu, new { @class = "form-control", rows = 3, id = "txtLyDoDauTu", placeholder = "Nhập lý do đầu tư..." })
                                        @Html.ValidationMessageFor(m => m.LyDoDauTu, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-semibold">Mô tả kỹ thuật</label>
                                        @Html.TextAreaFor(m => m.MoTaKyThuat, new { @class = "form-control", rows = 3, placeholder = "Nhập mô tả kỹ thuật..." })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Ngày bắt đầu<span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control custom-date-input" })
                                        @Html.ValidationMessageFor(m => m.NgayBatDau, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 mb-3">
                                        <label class="form-label fw-semibold">Ngày kết thúc<span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control custom-date-input" })
                                        @Html.ValidationMessageFor(m => m.NgayKetThuc, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-12 mb-3">
                                        <label class="form-label fw-semibold">Hồ sơ căn cứ</label>
                                        <input type="file" name="HoSoCanCu" id="HoSoCanCu" class="form-control" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.png" />
                                        <div class="form-text text-muted" style="font-size: 0.75rem;">File tối đa 20MB (.pdf, .docx, .xlsx, ảnh)</div>
                                        @Html.ValidationMessageFor(m => m.HoSoCanCu, "", new { @class = "text-danger small mt-1 d-block" })
                                    </div>

                                    <div class="col-md-3 col-sm-12 mb-3">
                                        <label class="form-label fw-semibold">Link tài liệu liên quan</label>
                                        @Html.TextBoxFor(m => m.LinkTaiLieuLienQuan, new { @class = "form-control", placeholder = "https://..." })
                                    </div>
                                </div>

                            </div>

                            <div class="tab-pane fade" id="tab-phannhiem" role="tabpanel">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0 text-secondary">
                                        <i class="bi bi-people-fill me-1 text-primary"></i>Danh sách phân nhiệm
                                    </h6>
                                    <button type="button" class="btn btn-success btn-sm shadow-sm" id="btnThemDong">
                                        <i class="bi bi-plus-circle me-1"></i>Thêm dòng
                                    </button>
                                </div>

                                <div class="table-responsive border rounded">
                                    <table class="table table-bordered table-hover align-middle mb-0" id="tblPhanNhiem">
                                        <thead class="table-light text-nowrap">
                                            <tr>
                                                <th style="width: 4%" class="text-center">#</th>
                                                <th style="width: 20%">Tên Bộ phận <span class="text-danger">*</span></th>
                                                <th style="width: 18%">Nhân viên <span class="text-danger">*</span></th>
                                                <th style="width: 24%">Chức năng / Nhiệm vụ <span class="text-danger">*</span></th>
                                                <th style="width: 16%">Email liên hệ <span class="text-danger">*</span></th>
                                                <th style="width: 14%">Ghi chú</th>
                                                <th style="width: 4%" class="text-center">Xóa</th>
                                            </tr>
                                        </thead>
                                        <tbody id="phanNhiemBody">
                                            @* Hệ thống Script tự động render dòng trống hoặc nạp dữ liệu cũ tại đây *@
                                        </tbody>
                                    </table>
                                </div>

                                <div class="alert alert-info d-flex align-items-center mt-3 py-2 px-3 m-0" role="alert">
                                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                    <div class="small">
                                        Chọn chức năng từ danh sách hoặc nhập thủ công.
                                    </div>
                                </div>
                            </div>

                        </div>

                        <hr class="mt-4 mb-3" />
                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i>
                                Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary px-5 fw-semibold shadow-sm">
                                <i class="bi bi-send-check me-1"></i> Gửi đăng ký
                            </button>
                        </div>
                    }
                </div>

                <div class="card-footer bg-light text-muted small py-2 px-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span></span>
                        <span>
                            <i class="bi bi-clock-history"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    $(document).ready(function () {

        // Sự kiện thay đổi giá trị trên Dropdown lý do đầu tư
        $('#ddlInvestmentReason').change(function () {
            var selectedText = $(this).find('option:selected').text().trim();
            var $divNhapTay = $('#divLyDoNhapTay');
            var $txtNhapTay = $('#txtLyDoDauTu');

            if (selectedText === "Điền thủ công") {
                // Hiển thị vùng nhập tay với hiệu ứng trượt nhẹ
                $divNhapTay.slideDown(200);
                $txtNhapTay.focus();
            } else {
                // Ẩn vùng nhập tay và clear sạch nội dung đã nhập trước đó
                $divNhapTay.slideUp(200);
                $txtNhapTay.val('');
            }
        });

        // Kích hoạt kiểm tra ngay khi load form (Phục vụ case Edit hoặc reload khi validation thất bại)
        if ($('#ddlInvestmentReason').find('option:selected').text().trim() === "Điền thủ công") {
            $('#divLyDoNhapTay').show();
        }

        var $display = $('#DuToan_Display');
        var $hidden = $('#DuToan_Hidden');

        // Khởi tạo: nếu hidden đã có giá trị thì hiển thị format
        var initVal = parseFloat($hidden.val()) || 0;
        if (initVal > 0) {
            $display.val(initVal.toLocaleString('en-US'));
        }

        // Chỉ cho nhập số và các phím điều hướng
        $display.on('keydown', function (e) {
            var allowed = [
                'Backspace', 'Delete', 'Tab', 'Escape', 'Enter',
                'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown',
                'Home', 'End'
            ];
            // Cho phép Ctrl+A, Ctrl+C, Ctrl+V, Ctrl+X
            if (e.ctrlKey || e.metaKey) return;
            // Cho phép các phím đặc biệt
            if (allowed.includes(e.key)) return;
            // Chỉ cho nhập chữ số
            if (!/^\d$/.test(e.key)) {
                e.preventDefault();
            }
        });

        // Format khi nhập
        $display.on('input', function () {
            var raw = $(this).val().replace(/,/g, '');
            var num = parseFloat(raw) || 0;

            // Cập nhật hidden field (số thuần)
            $hidden.val(num > 0 ? num : '');

            // Format hiển thị
            if (raw === '' || raw === '0') {
                $(this).val('');
                return;
            }
            var formatted = num.toLocaleString('en-US');
            $(this).val(formatted);
        });

        // Validate trước khi submit
        $('#mainForm').on('submit', function () {
            var raw = $display.val().replace(/,/g, '');
            var num = parseFloat(raw) || 0;
            $hidden.val(num > 0 ? num : '');
        });

        // ── Dữ liệu dropdown từ Razor ──────────────────────────────────
        var dsPhongBan  = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            Model.DanhSachPhongBan.Select(x => new { value = x.Value, text = x.Text })
        ));
        var dsChucNang  = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            Model.DanhSachChucNang.Select(x => new { value = x.Value, text = x.Text })
        ));

        var rowIndex = 0; // đếm index dòng để bind đúng tên field

        // ── Hàm render 1 dòng mới ──────────────────────────────────────
        function taoHtmlDong(idx) {
            // Dropdown Phòng ban
            var optionsPhongBan = '<option value="">-- Chọn --</option>';
            $.each(dsPhongBan, function (i, pb) {
                optionsPhongBan += '<option value="' + pb.value + '">'
                                    + pb.text + '</option>';
            });

            // Dropdown Chức năng
            var optionsChucNang = '<option value="">-- Chọn hoặc nhập tay --</option>';
            $.each(dsChucNang, function (i, cn) {
                optionsChucNang += '<option value="' + cn.value + '">'
                                    + cn.text + '</option>';
            });

            return '<tr data-index="' + idx + '">'
                + '<td class="text-center stt"></td>'

                // Phòng ban
                + '<td>'
                + '<select name="DanhSachPhanNhiem[' + idx + '].PhongBanId" '
                +         'class="form-select form-select-sm" required>'
                + optionsPhongBan
                + '</select>'
                + '</td>'

                // User
                + '<td>'
                + '<select name="DanhSachPhanNhiem[' + idx + '].UserId" '
                + 'class="form-select form-select-sm dd-user" required>'
                + '<option value="">-- Chọn nhân viên --</option>'
                + '</select>'
                + '</td>'

                // Chức năng — dropdown + textbox nhập tay
                + '<td>'
                + '<select name="DanhSachPhanNhiem[' + idx + '].ChucNangNhiemVuId" '
                +         'class="form-select form-select-sm mb-1 ddChucNang">'
                + optionsChucNang
                + '</select>'
                + '<input type="text" '
                +        'name="DanhSachPhanNhiem[' + idx + '].TenChucNangNhapTay" '
                +        'class="form-control form-control-sm txtChucNangTay" '
                +        'placeholder="Hoặc nhập tay tại đây..." />'
                + '</td>'

                // Email
                + '<td>'
                + '<input type="email" '
                +        'name="DanhSachPhanNhiem[' + idx + '].Email" '
                +        'class="form-control form-control-sm" '
                +        'placeholder="" />'
                + '</td>'

                // Ghi chú
                + '<td>'
                + '<input type="text" '
                +        'name="DanhSachPhanNhiem[' + idx + '].GhiChu" '
                +        'class="form-control form-control-sm" '
                +        'placeholder="Ghi chú..." />'
                + '</td>'

                // Nút xóa
                + '<td class="text-center">'
                + '<button type="button" class="btn btn-danger btn-sm btnXoaDong" '
                +         'title="Xóa dòng">'
                + '<i class="bi bi-trash"></i>'
                + '</button>'
                + '</td>'
                + '</tr>';
        }

        // ── Hàm load User theo PhongBanId (dùng chung cho cả 2 context) ──
        @*function loadUsersByPhongBan(phongBanId, $ddUser,
                                        selectedUserId, selectedText) {
            $ddUser.html('<option value="">Đang tải...</option>')
                    .prop('disabled', true);

            if (!phongBanId) {
                $ddUser.html('<option value="">-- Chọn nhân viên --</option>')
                        .prop('disabled', false);
                return;
            }

            $.ajax({
                url:  '@Url.Action("GetUsersByPhongBan", "Budget")',
                type: 'GET',
                data: { phongBanId: phongBanId },
                success: function (res) {
                    var options =
                        '<option value="">-- Chọn nhân viên --</option>';
                    if (res.success && res.data.length > 0) {
                        $.each(res.data, function (i, u) {
                            var selected = selectedUserId
                                && u.value == selectedUserId
                                ? 'selected' : '';
                            options += '<option value="' + u.value + '" '
                                        + selected + '>'
                                        + u.text + '</option>';
                        });
                    }
                    $ddUser.html(options).prop('disabled', false);
                },
                error: function () {
                    $ddUser.html('<option value="">-- Lỗi tải dữ liệu --</option>')
                            .prop('disabled', false);
                }
            });
        }*@

        function loadUsersByPhongBan(phongBanId, $ddUser, selectedUserId, selectedText) {
            // 1. Hiển thị trạng thái đang tải và cập nhật giao diện Chosen
            $ddUser.html('<option value="">Đang tải...</option>')
                    .prop('disabled', true)
                    .trigger("chosen:updated");

            // 2. Kiểm tra nếu không có Phòng ban nào được chọn
            if (!phongBanId) {
                $ddUser.html('<option value="">-- Chọn nhân viên --</option>')
                        .prop('disabled', false)
                        .trigger("chosen:updated");
                return;
            }

            // 3. Gọi Ajax lấy danh sách nhân viên
            $.ajax({
                url: '@Url.Action("GetUsersByPhongBan", "Budget")',
                type: 'GET',
                data: { phongBanId: phongBanId },
                success: function (res) {
                    var options = '<option value="">-- Chọn nhân viên --</option>';

                    if (res.success && res.data.length > 0) {
                        $.each(res.data, function (i, u) {
                            var selected = selectedUserId && u.value == selectedUserId ? 'selected' : '';
                            options += '<option value="' + u.value + '" ' + selected + '>' + u.text + '</option>';
                        });
                    }

                    // Đổ dữ liệu mới vào và mở khóa select
                    $ddUser.html(options).prop('disabled', false);

                    // 4. Kích hoạt Chosen nếu chưa có, hoặc cập nhật nếu đã tồn tại
                    if ($ddUser.next('.chosen-container').length > 0) {
                        $ddUser.trigger("chosen:updated");
                    } else {
                        $ddUser.chosen({
                            width: "100%",
                            no_results_text: "Không tìm thấy nhân viên:"
                        });
                    }
                },
                error: function () {
                    // Xử lý khi có lỗi xảy ra
                    $ddUser.html('<option value="">-- Lỗi tải dữ liệu --</option>')
                            .prop('disabled', false)
                            .trigger("chosen:updated");
                }
            });
        }

        // ── Trang Create: Load User khi đổi Phòng ban ────────────────
        $(document).on('change',
            '#phanNhiemBody select[name*=PhongBanId]',
            function () {
                var phongBanId = $(this).val();
                var $ddUser = $(this).closest('tr').find('.dd-user');
                loadUsersByPhongBan(phongBanId, $ddUser, null, null);
            }
        );

        // ── Cập nhật số thứ tự và badge đếm dòng ──────────────────────
        function capNhatSTT() {
            var rows = $('#phanNhiemBody tr');
            rows.each(function (i) {
                $(this).find('.stt').text(i + 1);
            });
            var count = rows.length;
            $('#phanNhiemCount').text(count)
                .toggleClass('bg-secondary', count === 0)
                .toggleClass('bg-primary',   count > 0);
        }

        // ── Thêm dòng ──────────────────────────────────────────────────
        $('#btnThemDong').on('click', function () {
            var row = taoHtmlDong(rowIndex++);
            var $row = $(row);

            $('#phanNhiemBody').append($row);
            // Kích hoạt chosen cho select Phòng ban của dòng vừa thêm
            $row.find('select[name*=PhongBanId]').chosen({ width: "100%" });
            capNhatSTT();
        });

        // ── Xóa dòng (event delegation) ────────────────────────────────
        $('#phanNhiemBody').on('click', '.btnXoaDong', function () {
            $(this).closest('tr').remove();
            capNhatSTT();
        });

        // ── Auto-dismiss alerts ─────────────────────────────────────────
        setTimeout(function () { $('.alert').fadeOut('slow'); }, 5000);

        // ── Chống double-submit ─────────────────────────────────────────
        $('#mainForm').submit(function () {
            if (!$(this).valid()) return;

            // *** THÊM MỚI: Validate tab Phân nhiệm ***
            var $rows = $('#phanNhiemBody tr');
            var isValid = true;
            var dongLoi = [];

            if ($rows.length === 0) {
                alert('Vui lòng thêm ít nhất một dòng phân nhiệm trước khi lưu.');
                // Chuyển sang tab Phân nhiệm để user thấy
                $('#tab-phannhiem-btn').tab('show');
                return false;
            }

            $rows.each(function (i) {
                var $row = $(this);
                var stt = i + 1;
                var phongBan = $row.find('select[name*=PhongBanId]').val();
                var userId = $row.find('.dd-user').val();
                var chucNang = $row.find('.ddChucNang').val();
                var nhapTay = $row.find('.txtChucNangTay').val().trim();
                var email = $row.find('input[name*=Email]').val().trim();
                var loi = [];

                if (!phongBan) loi.push('Bộ phận');
                if (!userId) loi.push('Nhân viên');
                if (!chucNang && !nhapTay) loi.push('Chức năng / Nhiệm vụ');
                if (!email) loi.push('Email liên hệ');

                if (loi.length > 0) {
                    dongLoi.push('Dòng ' + stt + ': thiếu ' + loi.join(', '));
                    isValid = false;
                }
            });

            if (!isValid) {
                // Chuyển sang tab Phân nhiệm và hiển thị lỗi
                $('#tab-phannhiem-btn').tab('show');
                // Hiện alert lỗi ngay trong tab
                var alertHtml = '<div class="alert alert-danger alert-dismissible '
                    + 'fade show" role="alert">'
                    + '<i class="bi bi-exclamation-triangle-fill me-2"></i>'
                    + '<strong>Vui lòng điền đầy đủ thông tin bắt buộc '
                    + 'ở tab Phân nhiệm:</strong><br>'
                    + dongLoi.join('<br>')
                    + '<button type="button" class="btn-close" '
                    + 'data-bs-dismiss="alert"></button>'
                    + '</div>';
                // Chèn alert vào đầu tab Phân nhiệm
                $('#tab-phannhiem').prepend(alertHtml);
                return false;
            }

            // Tất cả hợp lệ — disable button chống double submit
            $(this).find('button[type="submit"]')
                .prop('disabled', true)
                .html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');
        });

        // Auto-generate MaHangMuc when CategoryTypeId changes
        $('#CategoryTypeId').on('change', function() {
            var loaiHangMucId = $(this).val();

            if (!loaiHangMucId || loaiHangMucId === '') {
                $('#MaHangMuc').val('');
                return;
            }

            // Show loading state
            var $MaHangMuc = $('#MaHangMuc');
            var originalValue = $MaHangMuc.val();
            $MaHangMuc.val('Đang tạo mã...').prop('disabled', true);

            // Call AJAX to generate new code
            $.ajax({
                url: '@Url.Action("GenerateNewMaHangMuc", "Budget")',
                type: 'POST',
                data: { loaiHangMucId: loaiHangMucId },
                success: function(response) {
                    if (response.success) {
                        $MaHangMuc.val(response.maHangMuc);
                    } else {
                        alert(response.message || 'Không thể tạo mã hạng mục.');
                        $MaHangMuc.val(originalValue);
                    }
                },
                error: function() {
                    alert('Đã xảy ra lỗi khi tạo mã hạng mục.');
                    $MaHangMuc.val(originalValue);
                },
                complete: function() {
                    $MaHangMuc.prop('disabled', false);
                }
            });
        });

        // Hàm kiểm tra ẩn hiện Khu vực tự nhập
        function toggleProjectAreaCustom() {
            var $selectedOption = $('#ProjectAreaId option:selected');
            var isCustom = $selectedOption.data('is-custom') === true || $selectedOption.data('is-custom') === "true";

            if (isCustom) {
                console.log('isCustom')
                $('#divProjectAreaCustom').slideDown(300);
                $('#ProjectAreaCustom').attr('required', 'required'); // Thêm validate mềm ở client
            } else {
                console.log('isNoCustom')
                $('#divProjectAreaCustom').slideUp(200);
                $('#ProjectAreaCustom').val('').removeAttr('required'); // Xóa text nếu user đổi ý chọn khu vực khác
            }
        }

        // Lắng nghe sự kiện thay đổi trên dropdown Khu vực dự án
        $('#ProjectAreaId').on('change', function () {
            console.log('on change')
            toggleProjectAreaCustom();
        });

        // Chạy kích hoạt lần đầu tiên phòng trường hợp form bị lỗi ModelState trả về và giữ nguyên dữ liệu cũ
        toggleProjectAreaCustom();

    });
</script>
