@model  QuanLyNganSach.Models.ViewModels.CreateBudgetRegistrationViewModel
@{
    ViewBag.Title = "Đăng ký hồ sơ ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var user = ViewBag.CurrentUser as QuanLyNganSach.Models.Auth.LoggedInUser;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Đăng ký kế hoạch ngân sách
                    </li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header text-bg-primary py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-text"></i>
                        Đăng ký kế hoạch ngân sách
                    </h5>
                </div>

                <div class="card-body p-4">
                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @using (Html.BeginForm("Create", "Budget", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Bộ phận</label>
                                <input type="text"
                                       class="form-control"
                                       value="@user.TenPhongBan"
                                       readonly />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Mã hạng mục</label>
                                @Html.TextBoxFor(m => m.MaHangMuc,
                                    new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Tên hạng mục <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.TenHangMuc, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.TenHangMuc, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">
                                    Dự toán
                                </label>

                                @Html.TextBoxFor(m => m.DuToan, new
                                {
                                    @class = "form-control",
                                    type = "number",
                                })

                                @Html.ValidationMessageFor(m => m.DuToan, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số tờ trình</label>
                            @Html.TextBoxFor(m => m.SoToTrinh, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.SoToTrinh, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Loại hạng mục <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.CategoryTypeId, Model.CategoryTypes, "-- Chọn --", new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.CategoryTypeId, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Mức ưu tiên <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.PriorityLevelId, Model.PriorityLevels, "-- Chọn --", new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.PriorityLevelId, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">
                                    Số lượng
                                </label>

                                @Html.TextBoxFor(m => m.SoLuong, new
                                {
                                    @class = "form-control",
                                    type = "number",
                                    placeholder = "Nhập số lượng"
                                })

                                @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger small mt-1" })
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label fw-semibold">
                                    Lý do đầu tư
                                </label>

                                @Html.TextAreaFor(m => m.LyDoDauTu, new
                                {
                                    @class = "form-control",
                                    rows = 4
                                })

                                @Html.ValidationMessageFor(m => m.LyDoDauTu, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>


                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Mô tả kỹ thuật
                            </label>
                            @Html.TextAreaFor(m => m.MoTaKyThuat, new { @class = "form-control textarea-wide", rows = 4 })
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Ngày bắt đầu</label>
                                @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.NgayBatDau, "", new { @class = "text-danger small mt-1" })
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Ngày kết thúc</label>
                                @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.NgayKetThuc, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Hồ sơ căn cứ</label>
                                @Html.TextBoxFor(m => m.HoSoCanCu, new
                                {
                                    type = "file",
                                    @class = "form-control"
                                })
                                @Html.ValidationMessageFor(m => m.HoSoCanCu, "", new { @class = "text-danger small mt-1" })
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Link tài liệu liên quan</label>
                                @Html.TextBoxFor(m => m.LinkTaiLieuLienQuan, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-save"></i> Gửi đăng ký
                            </button>
                            <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-secondary flex-fill">Hủy</a>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light text-muted small py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>
                            
                        </span>
                        <span class="text-end">
                            <i class="bi bi-clock-history"></i>
                            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
            $(document).ready(function () {
                // Auto-dismiss alerts after 5 seconds
                setTimeout(function () {
                    $('.alert').fadeOut('slow');
                }, 5000);

                // Form validation
                $('form').submit(function () {
                    if ($(this).valid()) {
                        // Disable submit button to prevent double submission
                        $(this).find('button[type="submit"]')
                            .prop('disabled', true)
                            .html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');
                    }
                });

                // Auto-generate MaHangMuc when CategoryTypeId changes
                $('#CategoryTypeId').on('change', function() {
                    var loaiHangMucId = $(this).val();

                    if (!loaiHangMucId || loaiHangMucId === '') {
                        $('#MaHangMuc').val('');
                        return;
                    }

                    // Show loading state
                    var $MaHangMuc = $('#MaHangMuc');
                    var originalValue = $MaHangMuc.val();
                    $MaHangMuc.val('Đang tạo mã...').prop('disabled', true);

                    // Call AJAX to generate new code
                    $.ajax({
                        url: '@Url.Action("GenerateNewMaHangMuc", "Budget")',
                        type: 'POST',
                        data: { loaiHangMucId: loaiHangMucId },
                        success: function(response) {
                            if (response.success) {
                                $MaHangMuc.val(response.maHangMuc);
                            } else {
                                alert(response.message || 'Không thể tạo mã hạng mục.');
                                $MaHangMuc.val(originalValue);
                            }
                        },
                        error: function() {
                            alert('Đã xảy ra lỗi khi tạo mã hạng mục.');
                            $MaHangMuc.val(originalValue);
                        },
                        complete: function() {
                            $MaHangMuc.prop('disabled', false);
                        }
                    });
                });
            });
    </script>
    <style>
        /* Custom styles matching layout theme */
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .form-control, .form-select {
            border-radius: 0.375rem;
        }

        media (max-width: 768px) {
            .card-body

        {
            padding: 1.5rem !important;
        }

        }

        .card-header {
            border-bottom: 3px solid rgba(255, 255, 255, 0.3);
        }

        .form-label {
            margin-bottom: 0.5rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .btn {
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }

        /* Responsive adjustments */
        media (max-width: 576px) {
            .container

        {
            padding-left: 15px;
            padding-right: 15px;
        }

        .card-body {
            padding: 1.5rem !important;
        }

        .card-header h5 {
            font-size: 1.1rem;
        }

        }

        /* Loading state */
        button[disabled] {
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* Validation styles */
        .field-validation-error {
            display: block;
            margin-top: 0.25rem;
        }

        .input-validation-error {
            border-color: #dc3545 !important;
        }

        /* Alert animations */
        .alert {
            animation: slideDown 0.3s ease-out;
        }

        keyframes slideDown {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
        }
    </style>

}