@model  QuanLyNganSach.Models.ViewModels.CreateBudgetRegistrationViewModel
@{
    ViewBag.Title = "Đăng ký hồ sơ ngân sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var user = ViewBag.CurrentUser as QuanLyNganSach.Models.Auth.LoggedInUser;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Đăng ký kế hoạch ngân sách
                    </li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header text-bg-primary py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-text"></i>
                        Đăng ký kế hoạch ngân sách
                    </h5>
                </div>

                <div class="card-body p-4">
                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Create", "Budget", FormMethod.Post,
                                           new { enctype = "multipart/form-data", id = "mainForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- ===== TAB NAVIGATION ===== -->
                        <ul class="nav nav-tabs mb-4" id="budgetTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-phieu-btn"
                                        data-bs-toggle="tab" data-bs-target="#tab-phieu"
                                        type="button" role="tab">
                                    <i class="bi bi-file-earmark-text me-1"></i>Phiếu đăng ký
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-phannhiem-btn"
                                        data-bs-toggle="tab" data-bs-target="#tab-phannhiem"
                                        type="button" role="tab">
                                    <i class="bi bi-people me-1"></i>Phân nhiệm
                                    <span id="phanNhiemCount" class="badge bg-secondary ms-1">0</span>
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="budgetTabsContent">

                            <!-- ===== TAB 1: PHIẾU ĐĂNG KÝ (giữ nguyên toàn bộ nội dung cũ) ===== -->
                            <div class="tab-pane fade show active" id="tab-phieu" role="tabpanel">

                                <div class="row">
                                    <!-- Khu vực dự án — THÊM MỚI, đặt trước Bộ phận -->
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">
                                            Khu vực dự án <span class="text-danger">*</span>
                                        </label>
                                        @Html.DropDownListFor(m => m.ProjectAreaId,
                                            Model.DanhSachKhuVuc,
                                            "-- Chọn khu vực --",
                                            new { @class = "form-select" })
                                        @Html.ValidationMessageFor(m => m.ProjectAreaId, "",
                                            new { @class = "text-danger small mt-1" })
                                    </div>

                                    <!-- Bộ phận — giữ nguyên -->
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Bộ phận</label>
                                        <input type="text"
                                               class="form-control"
                                               value="@user.TenPhongBan"
                                               readonly />
                                    </div>

                                    <!-- Mã hạng mục — giữ nguyên -->
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Mã hạng mục</label>
                                        @Html.TextBoxFor(m => m.MaHangMuc,
                                            new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Tên hạng mục <span class="text-danger">*</span></label>
                                        @Html.TextBoxFor(m => m.TenHangMuc, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.TenHangMuc, "", new { @class = "text-danger small mt-1" })
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">
                                            Dự toán
                                        </label>

                                        @Html.TextBoxFor(m => m.DuToan, new
                                        {
                                            @class = "form-control",
                                            type = "number",
                                        })

                                        @Html.ValidationMessageFor(m => m.DuToan, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Số tờ trình</label>
                                    @Html.TextBoxFor(m => m.SoToTrinh, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.SoToTrinh, "", new { @class = "text-danger small mt-1" })
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Loại hạng mục <span class="text-danger">*</span></label>
                                        @Html.DropDownListFor(m => m.CategoryTypeId, Model.CategoryTypes, "-- Chọn --", new { @class = "form-select" })
                                        @Html.ValidationMessageFor(m => m.CategoryTypeId, "", new { @class = "text-danger small mt-1" })
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Mức ưu tiên <span class="text-danger">*</span></label>
                                        @Html.DropDownListFor(m => m.PriorityLevelId, Model.PriorityLevels, "-- Chọn --", new { @class = "form-select" })
                                        @Html.ValidationMessageFor(m => m.PriorityLevelId, "", new { @class = "text-danger small mt-1" })
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">
                                            Số lượng
                                        </label>

                                        @Html.TextBoxFor(m => m.SoLuong, new
                                        {
                                            @class = "form-control",
                                            type = "number",
                                            placeholder = "Nhập số lượng"
                                        })

                                        @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger small mt-1" })
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-semibold">
                                            Lý do đầu tư
                                        </label>

                                        @Html.TextAreaFor(m => m.LyDoDauTu, new
                                        {
                                            @class = "form-control",
                                            rows = 4
                                        })

                                        @Html.ValidationMessageFor(m => m.LyDoDauTu, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                </div>


                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Mô tả kỹ thuật
                                    </label>
                                    @Html.TextAreaFor(m => m.MoTaKyThuat, new { @class = "form-control textarea-wide", rows = 4 })
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Ngày bắt đầu</label>
                                        @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.NgayBatDau, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Ngày kết thúc</label>
                                        @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.NgayKetThuc, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Hồ sơ căn cứ</label>
                                        @Html.TextBoxFor(m => m.HoSoCanCu, new
                                        {
                                            type = "file",
                                            @class = "form-control"
                                        })
                                        @Html.ValidationMessageFor(m => m.HoSoCanCu, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">Link tài liệu liên quan</label>
                                        @Html.TextBoxFor(m => m.LinkTaiLieuLienQuan, new { @class = "form-control" })
                                    </div>
                                </div>

                            </div>

                            <!-- ===== TAB 2: PHÂN NHIỆM ===== -->
                            <div class="tab-pane fade" id="tab-phannhiem" role="tabpanel">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-semibold mb-0">
                                        <i class="bi bi-people-fill me-1"></i>Danh sách phân nhiệm
                                    </h6>
                                    <button type="button" class="btn btn-success btn-sm" id="btnThemDong">
                                        <i class="bi bi-plus-circle me-1"></i>Thêm dòng
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover align-middle" id="tblPhanNhiem">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:5%">#</th>
                                                <th style="width:22%">Tên Bộ phận <span class="text-danger">*</span></th>
                                                <th style="width:25%">Chức năng / Nhiệm vụ <span class="text-danger">*</span></th>
                                                <th style="width:20%">Email liên hệ <span class="text-danger">*</span></th>
                                                <th style="width:22%">Ghi chú</th>
                                                <th style="width:6%"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="phanNhiemBody">
                                            @* Dòng trống mặc định nếu chưa có dữ liệu *@
                                        </tbody>
                                    </table>
                                </div>

                                <p class="text-muted small mt-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Chọn chức năng từ danh sách hoặc nhập trực tiếp vào ô bên dưới nếu không có trong danh sách.
                                </p>
                            </div>

                        </div>

                        <!-- ===== NÚT SUBMIT (dùng chung cho cả 2 tab) ===== -->
                        <hr class="mt-4" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-save"></i> Gửi đăng ký
                            </button>
                            <a href="@Url.Action("Index", "Home", new { area = "" })"
                               class="btn btn-outline-secondary flex-fill">Hủy</a>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light text-muted small py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>

                        </span>
                        <span class="text-end">
                            <i class="bi bi-clock-history"></i>
                            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
            $(document).ready(function () {
                // ── Dữ liệu dropdown từ Razor ──────────────────────────────────
                var dsPhongBan  = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                    Model.DanhSachPhongBan.Select(x => new { value = x.Value, text = x.Text })
                ));
                var dsChucNang  = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                    Model.DanhSachChucNang.Select(x => new { value = x.Value, text = x.Text })
                ));

                var rowIndex = 0; // đếm index dòng để bind đúng tên field

                // ── Hàm render 1 dòng mới ──────────────────────────────────────
                function taoHtmlDong(idx) {
                    // Dropdown Phòng ban
                    var optionsPhongBan = '<option value="">-- Chọn --</option>';
                    $.each(dsPhongBan, function (i, pb) {
                        optionsPhongBan += '<option value="' + pb.value + '">'
                                         + pb.text + '</option>';
                    });

                    // Dropdown Chức năng
                    var optionsChucNang = '<option value="">-- Chọn hoặc nhập tay --</option>';
                    $.each(dsChucNang, function (i, cn) {
                        optionsChucNang += '<option value="' + cn.value + '">'
                                         + cn.text + '</option>';
                    });

                    return '<tr data-index="' + idx + '">'
                        + '<td class="text-center stt"></td>'

                        // Phòng ban
                        + '<td>'
                        + '<select name="DanhSachPhanNhiem[' + idx + '].PhongBanId" '
                        +         'class="form-select form-select-sm" required>'
                        + optionsPhongBan
                        + '</select>'
                        + '</td>'

                        // Chức năng — dropdown + textbox nhập tay
                        + '<td>'
                        + '<select name="DanhSachPhanNhiem[' + idx + '].ChucNangNhiemVuId" '
                        +         'class="form-select form-select-sm mb-1 ddChucNang">'
                        + optionsChucNang
                        + '</select>'
                        + '<input type="text" '
                        +        'name="DanhSachPhanNhiem[' + idx + '].TenChucNangNhapTay" '
                        +        'class="form-control form-control-sm txtChucNangTay" '
                        +        'placeholder="Hoặc nhập tay tại đây..." />'
                        + '</td>'

                        // Email
                        + '<td>'
                        + '<input type="email" '
                        +        'name="DanhSachPhanNhiem[' + idx + '].Email" '
                        +        'class="form-control form-control-sm" '
                        +        'placeholder="" />'
                        + '</td>'

                        // Ghi chú
                        + '<td>'
                        + '<input type="text" '
                        +        'name="DanhSachPhanNhiem[' + idx + '].GhiChu" '
                        +        'class="form-control form-control-sm" '
                        +        'placeholder="Ghi chú..." />'
                        + '</td>'

                        // Nút xóa
                        + '<td class="text-center">'
                        + '<button type="button" class="btn btn-danger btn-sm btnXoaDong" '
                        +         'title="Xóa dòng">'
                        + '<i class="bi bi-trash"></i>'
                        + '</button>'
                        + '</td>'
                        + '</tr>';
                }

                // ── Cập nhật số thứ tự và badge đếm dòng ──────────────────────
                function capNhatSTT() {
                    var rows = $('#phanNhiemBody tr');
                    rows.each(function (i) {
                        $(this).find('.stt').text(i + 1);
                    });
                    var count = rows.length;
                    $('#phanNhiemCount').text(count)
                        .toggleClass('bg-secondary', count === 0)
                        .toggleClass('bg-primary',   count > 0);
                }

                // ── Thêm dòng ──────────────────────────────────────────────────
                $('#btnThemDong').on('click', function () {
                    $('#phanNhiemBody').append(taoHtmlDong(rowIndex++));
                    capNhatSTT();
                });

                // ── Xóa dòng (event delegation) ────────────────────────────────
                $('#phanNhiemBody').on('click', '.btnXoaDong', function () {
                    $(this).closest('tr').remove();
                    capNhatSTT();
                });

                // ── Auto-dismiss alerts ─────────────────────────────────────────
                setTimeout(function () { $('.alert').fadeOut('slow'); }, 5000);

                // ── Chống double-submit ─────────────────────────────────────────
                $('#mainForm').submit(function () {
                    if (!$(this).valid()) return;

                    // *** THÊM MỚI: Validate tab Phân nhiệm ***
                    var $rows = $('#phanNhiemBody tr');
                    var isValid = true;
                    var dongLoi = [];

                    if ($rows.length === 0) {
                        alert('Vui lòng thêm ít nhất một dòng phân nhiệm trước khi lưu.');
                        // Chuyển sang tab Phân nhiệm để user thấy
                        $('#tab-phannhiem-btn').tab('show');
                        return false;
                    }

                    $rows.each(function (i) {
                        var $row = $(this);
                        var stt = i + 1;
                        var phongBan = $row.find('select[name*=PhongBanId]').val();
                        var chucNang = $row.find('.ddChucNang').val();
                        var nhapTay = $row.find('.txtChucNangTay').val().trim();
                        var email = $row.find('input[name*=Email]').val().trim();
                        var loi = [];

                        if (!phongBan) loi.push('Bộ phận');
                        if (!chucNang && !nhapTay) loi.push('Chức năng / Nhiệm vụ');
                        if (!email) loi.push('Email liên hệ');

                        if (loi.length > 0) {
                            dongLoi.push('Dòng ' + stt + ': thiếu ' + loi.join(', '));
                            isValid = false;
                        }
                    });

                    if (!isValid) {
                        // Chuyển sang tab Phân nhiệm và hiển thị lỗi
                        $('#tab-phannhiem-btn').tab('show');
                        // Hiện alert lỗi ngay trong tab
                        var alertHtml = '<div class="alert alert-danger alert-dismissible '
                            + 'fade show" role="alert">'
                            + '<i class="bi bi-exclamation-triangle-fill me-2"></i>'
                            + '<strong>Vui lòng điền đầy đủ thông tin bắt buộc '
                            + 'ở tab Phân nhiệm:</strong><br>'
                            + dongLoi.join('<br>')
                            + '<button type="button" class="btn-close" '
                            + 'data-bs-dismiss="alert"></button>'
                            + '</div>';
                        // Chèn alert vào đầu tab Phân nhiệm
                        $('#tab-phannhiem').prepend(alertHtml);
                        return false;
                    }

                    // Tất cả hợp lệ — disable button chống double submit
                    $(this).find('button[type="submit"]')
                        .prop('disabled', true)
                        .html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');
                });

                // Auto-generate MaHangMuc when CategoryTypeId changes
                $('#CategoryTypeId').on('change', function() {
                    var loaiHangMucId = $(this).val();

                    if (!loaiHangMucId || loaiHangMucId === '') {
                        $('#MaHangMuc').val('');
                        return;
                    }

                    // Show loading state
                    var $MaHangMuc = $('#MaHangMuc');
                    var originalValue = $MaHangMuc.val();
                    $MaHangMuc.val('Đang tạo mã...').prop('disabled', true);

                    // Call AJAX to generate new code
                    $.ajax({
                        url: '@Url.Action("GenerateNewMaHangMuc", "Budget")',
                        type: 'POST',
                        data: { loaiHangMucId: loaiHangMucId },
                        success: function(response) {
                            if (response.success) {
                                $MaHangMuc.val(response.maHangMuc);
                            } else {
                                alert(response.message || 'Không thể tạo mã hạng mục.');
                                $MaHangMuc.val(originalValue);
                            }
                        },
                        error: function() {
                            alert('Đã xảy ra lỗi khi tạo mã hạng mục.');
                            $MaHangMuc.val(originalValue);
                        },
                        complete: function() {
                            $MaHangMuc.prop('disabled', false);
                        }
                    });
                });

            });
    </script>
    <style>
        /* Custom styles matching layout theme */
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .form-control, .form-select {
            border-radius: 0.375rem;
        }

        media (max-width: 768px) {
            .card-body

        {
            padding: 1.5rem !important;
        }

        }

        .card-header {
            border-bottom: 3px solid rgba(255, 255, 255, 0.3);
        }

        .form-label {
            margin-bottom: 0.5rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .btn {
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
            }

        /* Responsive adjustments */
        media (max-width: 576px) {
            .container

        {
            padding-left: 15px;
            padding-right: 15px;
        }

        .card-body {
            padding: 1.5rem !important;
        }

        .card-header h5 {
            font-size: 1.1rem;
        }

        }

        /* Loading state */
        button[disabled] {
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* Validation styles */
        .field-validation-error {
            display: block;
            margin-top: 0.25rem;
        }

        .input-validation-error {
            border-color: #dc3545 !important;
        }

        /* Alert animations */
        .alert {
            animation: slideDown 0.3s ease-out;
        }

        keyframes slideDown {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
        }
    </style>

}