@model IEnumerable<QuanLyNganSach.Models.ViewModels.RevisionListItemViewModel>
@{
    ViewBag.Title = "Hồ sơ chờ duyệt thay đổi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2 mb-5 px-1">
    <div class="row">
        <div class="col-12">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="text-decoration-none">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Hồ sơ chờ duyệt thay đổi
                    </li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                <div>
                    <h4 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>
                        Danh sách hồ sơ chờ duyệt thay đổi
                    </h4>
                    <small class="text-muted">
                        @*Cần xử lý các yêu cầu chỉnh sửa hoặc hoàn trả từ người dùng*@
                    </small>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0 text-nowrap">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th class="text-center" style="width: 5%">STT</th>
                                    <th style="width: 12%">Mã hạng mục</th>
                                    <th style="width: 38%">Tên hạng mục</th>
                                    @*<th class="text-center" style="width: 15%">Loại yêu cầu</th>*@
                                    <th style="width: 20%">Bộ phận</th>
                                    <th class="text-center" style="width: 10%">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">
                                            <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                            Không có dữ liệu.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int stt = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center fw-semibold text-muted">#@stt</td>

                                            <td>
                                                @if (!string.IsNullOrEmpty(item.MaHangMuc))
                                                {
                                                    <span class="badge bg-dark-subtle text-dark border border-dark-subtle px-2.5 py-1.5 fw-bold font-monospace">@item.MaHangMuc</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">---</span>
                                                }
                                            </td>

                                            <td class="text-wrap fw-semibold text-dark" style="min-width: 250px;">
                                                @item.TenHangMuc
                                            </td>

                                            @*<td class="text-center">
                                                @if (item.RevisionType == 1)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border px-2 py-1.5 fw-medium">
                                                        <i class="bi bi-arrow-left-square me-1"></i> Trả hồ sơ
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info-subtle text-info border px-2 py-1.5 fw-medium">
                                                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                                                    </span>
                                                }
                                            </td>*@

                                            <td>
                                                <div class="fw-semibold text-dark">
                                                    <i class="bi bi-person me-1 text-secondary"></i>@item.CreatedByName
                                                </div>
                                                <div class="text-muted small mt-0.5">
                                                    <i class="bi bi-clock me-1"></i>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-sm px-2 py-0.5 btn-view-revision"
                                                        data-revision-id="@item.RevisionId"
                                                        data-budget-id="@item.BudgetRegistrationId"
                                                        title="Xem và duyệt thay đổi">
                                                    <i class="bi bi-eye"></i> Xem & Duyệt
                                                </button>
                                            </td>
                                        </tr>
                                        stt++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light py-2 border-top border-light-subtle">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Hiển thị <span class="fw-semibold text-dark">@Model.Count()</span> yêu cầu chờ duyệt
                        </small>
                        <small class="text-secondary text-end">
                            <i class="bi bi-clock-history me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal xem chi tiết Revision -->
<div class="modal fade" id="revisionDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header text-bg-primary">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-file-earmark-diff me-2"></i>
                    Chi tiết thay đổi hồ sơ
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">

                <div id="revisionLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Đang tải...</p>
                </div>

                <div id="revisionContent" style="display:none;">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Khu vực dự án</label>
                            <input type="text" class="form-control" id="rv_KhuVuc" disabled />
                        </div>
                        <div class="col-md-4 mb-3" id="divRvKhuVucCustom" style="display: none;">
                            <label class="form-label fw-semibold text-danger small">Tên khu vực khác</label>
                            <input type="text" class="form-control" id="rv_KhuVucCustom" disabled />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Tên hạng mục</label>
                            <input type="text" class="form-control" id="rv_TenHangMuc" disabled />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Dự toán</label>
                            <input type="text" class="form-control" id="rv_DuToan" disabled />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Số tờ trình</label>
                            <input type="text" class="form-control" id="rv_SoToTrinh" disabled />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Loại hạng mục</label>
                            <input type="text" class="form-control" id="rv_CategoryType" disabled />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Mức ưu tiên</label>
                            <input type="text" class="form-control" id="rv_PriorityLevel" disabled />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Số lượng</label>
                            <input type="text" class="form-control" id="rv_SoLuong" disabled />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Ngày bắt đầu</label>
                            <input type="text" class="form-control" id="rv_NgayBatDau" disabled />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold text-muted small">Ngày kết thúc</label>
                            <input type="text" class="form-control" id="rv_NgayKetThuc" disabled />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Lý do đầu tư</label>
                        <textarea class="form-control" id="rv_LyDoDauTu" rows="3" disabled></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Mô tả kỹ thuật</label>
                        <textarea class="form-control" id="rv_MoTaKyThuat" rows="3" disabled></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Link tài liệu liên quan</label>
                        <input type="text" class="form-control" id="rv_LinkTaiLieu" disabled />
                    </div>
                    <div class="mb-3" id="rv_LyDoChinhSuaSection" style="display:none;">
                        <label class="form-label fw-semibold text-muted small">
                            <i class="bi bi-pencil me-1"></i>Lý do chỉnh sửa
                        </label>
                        <textarea class="form-control" id="rv_LyDoChinhSua"
                                  rows="2" disabled></textarea>
                    </div>
                    <!-- File đính kèm -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">
                            <i class="bi bi-paperclip me-1"></i>Hồ sơ căn cứ đính kèm
                        </label>
                        <div id="rv_Attachments"
                             class="border rounded p-2 bg-light"></div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
                <button type="button" class="btn btn-success"
                        id="btnApproveRevision">
                    <i class="bi bi-check2-circle me-1"></i>Duyệt thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentRevisionId = 0;

        $(document).on('click', '.btn-view-revision', function () {
            currentRevisionId = $(this).data('revision-id');
            $('#revisionLoading').show();
            $('#revisionContent').hide();

            var modal = new bootstrap.Modal(
                document.getElementById('revisionDetailModal'));
            modal.show();

            $.get('@Url.Action("GetRevisionDetail", "Budget")', { revisionId: currentRevisionId }, function (data) {

                if (!data.success) return;

                $('#rv_KhuVuc').val(data.TenKhuVuc || '');
                $('#rv_KhuVucCustom').val(data.ProjectAreaCustom || '');
                if (data.ProjectAreaCustom && data.ProjectAreaCustom.trim() !== '') {
                    $('#divRvKhuVucCustom').show();
                } else {
                    $('#divRvKhuVucCustom').hide();
                }
                $('#rv_CategoryType').val(data.TenCategoryType  || '');
                $('#rv_PriorityLevel').val(data.TenPriorityLevel || '');
                $('#rv_TenHangMuc').val(data.TenHangMuc      || '');
                $('#rv_DuToan').val(formatCurrency(data.DuToan));
                $('#rv_SoToTrinh').val(data.SoToTrinh        || '');
                $('#rv_SoLuong').val(data.SoLuong            || '');
                $('#rv_NgayBatDau').val(data.NgayBatDau      || '');
                $('#rv_NgayKetThuc').val(data.NgayKetThuc    || '');
                $('#rv_LyDoDauTu').val(data.LyDoDauTu        || '');
                $('#rv_MoTaKyThuat').val(data.MoTaKyThuat    || '');
                $('#rv_LinkTaiLieu').val(data.LinkTaiLieuLienQuan || '');
                // Hiển thị lý do chỉnh sửa nếu RevisionType = 2
                if (data.RevisionType === 2) {
                    $('#rv_LyDoChinhSuaSection').show();
                    $('#rv_LyDoChinhSua').val(data.LyDoChinhSua || '');
                    // Đổi tiêu đề nút duyệt
                    $('#btnApproveRevision')
                        .html('<i class="bi bi-check2-circle me-1"></i>Xác nhận thay đổi');
                } else {
                    $('#rv_LyDoChinhSuaSection').hide();
                    $('#btnApproveRevision')
                        .html('<i class="bi bi-check2-circle me-1"></i>Duyệt thay đổi');
                }

                // File đính kèm
                var $att = $('#rv_Attachments').empty();
                if (data.Attachments && data.Attachments.length > 0) {
                    $.each(data.Attachments, function (_, a) {
                        $att.append(
                            '<div class="d-flex align-items-center gap-2 mb-1">' +
                            '  <i class="bi bi-file-earmark me-1"></i>' +
                            '  <a href="' + a.FilePath + '" target="_blank">'
                                + a.FileName + '</a>' +
                            '</div>'
                        );
                    });
                } else {
                    $att.html(
                        '<span class="text-muted small">Không có file đính kèm.</span>'
                    );
                }

                $('#revisionLoading').hide();
                $('#revisionContent').show();
            });
        });

        // Duyệt thay đổi
        $('#btnApproveRevision').on('click', function () {
            var $btn = $(this);
            $btn.prop('disabled', true)
                .html('<i class="bi bi-hourglass-split me-1"></i>Đang duyệt...');

            $.ajax({
                url  : '@Url.Action("ApproveRevision", "Budget")',
                type : 'POST',
                data : { revisionId: currentRevisionId },
                success: function (res) {
                    if (res.success) {
                        showModalAlert('success', res.message);

                        setTimeout(function () {
                            // Lấy instance và đóng modal
                            var modalEl = document.getElementById('revisionDetailModal');
                            if (modalEl) {
                                var modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) {
                                    modalInstance.hide();
                                }
                            }

                            window.location.reload();
                        }, 2000);

                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('Lỗi kết nối, vui lòng thử lại.');
                },
                complete: function () {
                    $btn.prop('disabled', false)
                        .html('<i class="bi bi-check2-circle me-1"></i>Duyệt thay đổi');
                }
            });
        });

        // Auto-open modal nếu URL có ?openRevision=xxx
        (function () {
            var params = new URLSearchParams(window.location.search);
            var revisionId = params.get('openRevision');
            if (revisionId) {
                var $btn = $('[data-revision-id="' + revisionId + '"].btn-view-revision');
                if ($btn.length) {
                    $btn.trigger('click');
                }
                window.history.replaceState({}, '', '/Budget/Revisions');
            }
        })();

        // Hàm format tiền tệ
        function formatCurrency(value) {
            if (!value) return '0';
            return Number(value).toLocaleString('en-US');
        }

        // ── Helper: hiện alert trong modal ──────────────────────────
        function showModalAlert(type, message) {
            var html = '<div class="alert alert-' + type + ' alert-dismissible '
                + 'fade show mt-3" role="alert">'
                + '<i class="bi bi-' + (type === 'success'
                    ? 'check-circle-fill' : 'exclamation-triangle-fill')
                + ' me-2"></i>' + message
                + '<button type="button" class="btn-close" '
                + 'data-bs-dismiss="alert"></button>'
                + '</div>';
            // Chèn alert vào đầu modal-body
            $('#revisionContent').prepend(html);
            setTimeout(function () {
                $('#revisionContent .alert').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 4000);
        }
    </script>
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .table thead th {
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #dee2e6;
        }

        .table tbody tr {
            transition: all 0.2s ease;
        }

        .table tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
            transform: translateX(2px);
        }
    </style>
}