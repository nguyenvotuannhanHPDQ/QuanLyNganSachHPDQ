
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid pt-3">
    <div class="card shadow-sm mb-4 border-0 bg-white">
        <div class="card-body py-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-0 fw-bold text-secondary"><i class="bi bi-speedometer2 text-primary me-2"></i>DASHBOARD</h5>
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold text-muted text-nowrap mb-0">Bộ phận:</label>
                <div class="w-chosen-dept">
                    @Html.DropDownList("FilterDeptId", (SelectList)ViewBag.PhongBanList, "-- Tất cả bộ phận --", new { @class = "form-select form-select-sm" })
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center">
                    @*<div class="fs-1 me-3 opacity-75"><i class="bi bi-folder-fill"></i></div>*@
                    <div>
                        <h6 class="card-title text-uppercase mb-1 small opacity-75">Tổng Số Hồ Sơ</h6>
                        <h3 class="mb-0 fw-bold" id="card_TotalRegs">0</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body d-flex align-items-center">
                    @*<div class="fs-1 me-3 opacity-75"><i class="bi bi-wallet2"></i></div>*@
                    <div>
                        <h6 class="card-title text-uppercase mb-1 small opacity-75">Dự Toán Đề Xuất</h6>
                        <h3 class="mb-0 fw-bold" id="card_TotalDuToan">0</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body d-flex align-items-center">
                    @*<div class="fs-1 me-3 opacity-75"><i class="bi bi-check-circle-fill"></i></div>*@
                    <div>
                        <h6 class="card-title text-uppercase mb-1 small opacity-75">Ngân Sách Đã Duyệt</h6>
                        <h3 class="mb-0 fw-bold" id="card_TotalApproved">0</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body d-flex align-items-center">
                    @*<div class="fs-1 me-3 opacity-75"><i class="bi bi-hourglass-split"></i></div>*@
                    <div>
                        <h6 class="card-title text-uppercase mb-1 small opacity-75">Ngân Sách Đang Trình</h6>
                        <h3 class="mb-0 fw-bold" id="card_TotalPending">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold text-muted py-3 border-0"><i class="bi bi-bar-chart-line me-2 text-danger"></i>TƯƠNG QUAN NGÂN SÁCH THEO BỘ PHẬN</div>
                <div class="card-body"><div id="chart_BarDept"></div></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold text-muted py-3 border-0"><i class="bi bi-pie-chart me-2 text-success"></i>TRẠNG THÁI HỒ SƠ TỔNG THỂ</div>
                <div class="card-body d-flex align-items-center justify-content-center"><div id="chart_PieStatus" style="width: 100%;"></div></div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold text-muted py-3 border-0"><i class="bi bi-graph-up me-2 text-primary"></i>TẦN SUẤT ĐĂNG KÝ HỒ SƠ THEO THÁNG (NĂM @DateTime.Now.Year)</div>
                <div class="card-body"><div id="chart_LineMonth"></div></div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
@section Scripts {
    <script>
        // Khai báo biến toàn cục quản lý các thực thể biểu đồ để cập nhật động (updateSeries)
        var barChart, pieChart, lineChart;

        $(document).ready(function () {
            // Khởi tạo các biểu đồ rỗng (Mẫu) ngay khi load trang
            initEmptyCharts();

            // Tự động kích hoạt gọi API đổ dữ liệu lần đầu tiên
            loadDashboardData();

            // Sự kiện khi người dùng thay đổi Lựa chọn Bộ phận dropdown list
            $('#FilterDeptId').on('change', function () {
                loadDashboardData();
            });
        });

        function initEmptyCharts() {
            // 1. Cấu hình Biểu đồ Cột Đôi (Bar Chart)
            var barOptions = {
                chart: { type: 'bar', height: 350, toolbar: { show: false } },
                series: [],
                xaxis: { categories: [] },
                colors: ['#198754', '#0dcaf0'], // Màu xanh (Đã duyệt) và màu xanh lam (Đang trình)
                plotOptions: { bar: { horizontal: false, columnWidth: '55%', borderRadius: 4 } },
                dataLabels: { enabled: false },
                yaxis: { title: { text: 'Số tiền (VNĐ)' }, labels: { formatter: function(val) { return val.toLocaleString() + ' đ'; } } }
            };
            barChart = new ApexCharts(document.querySelector("#chart_BarDept"), barOptions);
            barChart.render();

            // 2. Cấu hình Biểu đồ Tròn (Donut Chart)
            var pieOptions = {
                chart: { type: 'donut', height: 320 },
                series: [],
                labels: [],
                colors: ['#0d6efd', '#ffc107', '#198754', '#dc3545'],
                responsive: [{ breakpoint: 480, options: { chart: { width: 200 }, legend: { position: 'bottom' } } }]
            };
            pieChart = new ApexCharts(document.querySelector("#chart_PieStatus"), pieOptions);
            pieChart.render();

            // 3. Cấu hình Biểu đồ Đường (Line Chart)
            var lineOptions = {
                chart: { type: 'line', height: 300, toolbar: { show: false }, zoom: { enabled: false } },
                series: [],
                xaxis: { categories: [] },
                stroke: { curve: 'smooth', width: 3 },
                colors: ['#0d6efd'],
                markers: { size: 4 }
            };
            lineChart = new ApexCharts(document.querySelector("#chart_LineMonth"), lineOptions);
            lineChart.render();
        }

        function loadDashboardData() {
            var selectedDeptId = $('#FilterDeptId').val();

            // Thực hiện Ajax gọi lên hàm Json Backend
            $.ajax({
                url: '@Url.Action("GetDashboardData", "Budget")',
                type: 'GET',
                data: { phongBanId: selectedDeptId },
                success: function (res) {
                    // 1. Cập nhật số liệu chữ lên các Thẻ Cards (Có format hiển thị phân cách hàng nghìn)
                    $('#card_TotalRegs').text(res.TongSoHoSo.toLocaleString());
                    $('#card_TotalDuToan').text(res.TongDuToanDeXuat.toLocaleString() + '');
                    $('#card_TotalApproved').text(res.TongNganSachDaDuyet.toLocaleString() + '');
                    $('#card_TotalPending').text(res.TongNganSachDangTrinh.toLocaleString() + '');

                    // 2. Đẩy dữ liệu mới vào Biểu đồ Cột bộ phận
                    barChart.updateOptions({ xaxis: { categories: res.DeptLabels } });
                    barChart.updateSeries([
                        { name: 'Ngân sách Đã duyệt', data: res.DeptApprovedValues },
                        { name: 'Ngân sách Đang trình', data: res.DeptPendingValues }
                    ]);

                    // 3. Đẩy dữ liệu mới vào Biểu đồ Tròn tỷ lệ trạng thái
                    pieChart.updateOptions({ labels: res.StatusLabels });
                    pieChart.updateSeries(res.StatusValues);

                    // 4. Đẩy dữ liệu mới vào Biểu đồ Đường xu hướng tháng
                    lineChart.updateOptions({ xaxis: { categories: res.MonthLabels } });
                    lineChart.updateSeries([
                        { name: 'Số lượng hồ sơ đăng ký', data: res.MonthRegistrationCounts }
                    ]);
                },
                error: function () {
                    console.error("Lỗi hệ thống khi tải dữ liệu biểu đồ Dashboard.");
                }
            });
        }

        $("#FilterDeptId").chosen({
            width: "280px", // Khóa chặt chiều rộng ở mức 280px (Bạn có thể tăng/giảm số này tùy ý)
        });
    </script>
}