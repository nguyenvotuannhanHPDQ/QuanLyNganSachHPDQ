@model QuanLyNganSach.Models.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Đổi mật khẩu
                    </li>
                </ol>
            </nav>

            <!-- Card chính -->
            <div class="card shadow-sm border-0">
                <!-- Header -->
                <div class="card-header text-bg-info text-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-key-fill fs-5"></i>
                        <h5 class="mb-0 fw-semibold">Đổi mật khẩu</h5>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <!-- User Info -->
                    <div class="alert alert-info d-flex align-items-center mb-4">
                        <i class="bi bi-person-circle fs-4 me-3"></i>
                        <div>
                            <div class="fw-semibold">Tài khoản: @User.Identity.Name</div>
                            <small class="text-muted">Đổi mật khẩu để bảo vệ tài khoản của bạn</small>
                        </div>
                    </div>

                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Form -->
                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label for="CurrentPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock text-info"></i>
                                Mật khẩu hiện tại
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.CurrentPassword, new
                                {
                                    @class = "form-control" + (Html.ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0 ? " is-invalid" : ""),
                                    placeholder = "Nhập mật khẩu hiện tại",
                                    id = "CurrentPassword"
                                })
                                <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPassword">
                                    <i class="bi bi-eye" id="iconCurrentPassword"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "invalid-feedback d-block" })
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label for="NewPassword" class="form-label fw-semibold">
                                <i class="bi bi-key text-info"></i>
                                Mật khẩu mới
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.NewPassword, new
                                {
                                    @class = "form-control" + (Html.ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? " is-invalid" : ""),
                                    placeholder = "Nhập mật khẩu mới (ít nhất 6 ký tự)",
                                    id = "NewPassword"
                                })
                                <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                    <i class="bi bi-eye" id="iconNewPassword"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "invalid-feedback d-block" })

                            <!-- Password strength indicator -->
                            <div class="mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" id="passwordStrength" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted" id="passwordStrengthText"></small>
                            </div>
                        </div>

                        <!-- Xác nhận mật khẩu mới -->
                        <div class="mb-4">
                            <label for="ConfirmPassword" class="form-label fw-semibold">
                                <i class="bi bi-shield-check text-info"></i>
                                Xác nhận mật khẩu mới
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.ConfirmPassword, new
                                {
                                    @class = "form-control" + (Html.ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? " is-invalid" : ""),
                                    placeholder = "Nhập lại mật khẩu mới",
                                    id = "ConfirmPassword"
                                })
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                    <i class="bi bi-eye" id="iconConfirmPassword"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "invalid-feedback d-block" })
                        </div>

                        <!-- Yêu cầu mật khẩu -->
                        <div class="alert alert-light border mb-4">
                            <div class="fw-semibold mb-2">
                                <i class="bi bi-info-circle text-info"></i>
                                Yêu cầu mật khẩu:
                            </div>
                            <ul class="mb-0 small" id="passwordRequirements">
                                <li id="reqLength" class="text-muted">
                                    <i class="bi bi-circle"></i> Ít nhất 6 ký tự
                                </li>
                                <li id="reqMatch" class="text-muted">
                                    <i class="bi bi-circle"></i> Mật khẩu xác nhận phải khớp
                                </li>
                                <li id="reqDifferent" class="text-muted">
                                    <i class="bi bi-circle"></i> Khác với mật khẩu hiện tại
                                </li>
                            </ul>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 flex-column flex-sm-row">
                            <button type="submit" class="btn btn-info text-white flex-fill">
                                <i class="bi bi-check-circle me-1"></i>
                                Đổi mật khẩu
                            </button>
                            <a href="@Url.Action("Index", "Home", new { area = "" })"
                               class="btn btn-outline-secondary flex-fill">
                                <i class="bi bi-x-circle me-1"></i>
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light text-muted small py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>
                            <i class="bi bi-shield-lock"></i>
                            Mật khẩu được mã hóa
                        </span>
                        <span class="text-end">
                            <i class="bi bi-exclamation-triangle"></i>
                            Cần đăng nhập lại sau khi đổi mật khẩu
                        </span>
                    </div>
                </div>
            </div>

            <!-- Helper text -->
            <div class="mt-3 text-center">
                <small class="text-muted">
                    <i class="bi bi-question-circle"></i>
                    Quên mật khẩu? Liên hệ
                    <a href="mailto:nguyenvotuannhan@hoaphat.com.vn">P.CNTT & CĐS</a>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Auto-dismiss alerts
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Toggle password visibility
            function togglePasswordVisibility(inputId, iconId) {
                $('#' + inputId).on('click', function () {
                    var passwordInput = $(this).prev('input');
                    var icon = $('#' + iconId);

                    if (passwordInput.attr('type') === 'password') {
                        passwordInput.attr('type', 'text');
                        icon.removeClass('bi-eye').addClass('bi-eye-slash');
                    } else {
                        passwordInput.attr('type', 'password');
                        icon.removeClass('bi-eye-slash').addClass('bi-eye');
                    }
                });
            }

            togglePasswordVisibility('toggleCurrentPassword', 'iconCurrentPassword');
            togglePasswordVisibility('toggleNewPassword', 'iconNewPassword');
            togglePasswordVisibility('toggleConfirmPassword', 'iconConfirmPassword');

            // Password strength checker
            $('#NewPassword').on('keyup', function () {
                var password = $(this).val();
                var strength = 0;
                var $strengthBar = $('#passwordStrength');
                var $strengthText = $('#passwordStrengthText');

                // Check length
                if (password.length >= 6) {
                    strength += 25;
                    $('#reqLength').removeClass('text-muted').addClass('text-success')
                        .find('i').removeClass('bi-circle').addClass('bi-check-circle-fill');
                } else {
                    $('#reqLength').removeClass('text-success').addClass('text-muted')
                        .find('i').removeClass('bi-check-circle-fill').addClass('bi-circle');
                }

                if (password.length >= 8) strength += 25;
                if (password.match(/[a-z]+/)) strength += 25;
                if (password.match(/[A-Z]+/)) strength += 12.5;
                if (password.match(/[0-9]+/)) strength += 12.5;

                // Update progress bar
                $strengthBar.css('width', strength + '%');
                $strengthBar.removeClass('bg-danger bg-warning bg-info bg-success');

                if (strength < 25) {
                    $strengthBar.addClass('bg-danger');
                    $strengthText.text('Yếu').removeClass().addClass('text-danger small');
                } else if (strength < 50) {
                    $strengthBar.addClass('bg-warning');
                    $strengthText.text('Trung bình').removeClass().addClass('text-warning small');
                } else if (strength < 75) {
                    $strengthBar.addClass('bg-info');
                    $strengthText.text('Khá').removeClass().addClass('text-info small');
                } else {
                    $strengthBar.addClass('bg-success');
                    $strengthText.text('Mạnh').removeClass().addClass('text-success small');
                }
            });

            // Check password match
            $('#ConfirmPassword').on('keyup', function () {
                var newPassword = $('#NewPassword').val();
                var confirmPassword = $(this).val();

                if (confirmPassword.length > 0) {
                    if (newPassword === confirmPassword) {
                        $('#reqMatch').removeClass('text-muted text-danger').addClass('text-success')
                            .find('i').removeClass('bi-circle bi-x-circle-fill').addClass('bi-check-circle-fill');
                    } else {
                        $('#reqMatch').removeClass('text-muted text-success').addClass('text-danger')
                            .find('i').removeClass('bi-circle bi-check-circle-fill').addClass('bi-x-circle-fill');
                    }
                } else {
                    $('#reqMatch').removeClass('text-success text-danger').addClass('text-muted')
                        .find('i').removeClass('bi-check-circle-fill bi-x-circle-fill').addClass('bi-circle');
                }
            });

            // Check different from current
            $('#NewPassword, #CurrentPassword').on('keyup', function () {
                var currentPassword = $('#CurrentPassword').val();
                var newPassword = $('#NewPassword').val();

                if (currentPassword.length > 0 && newPassword.length > 0) {
                    if (currentPassword !== newPassword) {
                        $('#reqDifferent').removeClass('text-muted text-danger').addClass('text-success')
                            .find('i').removeClass('bi-circle bi-x-circle-fill').addClass('bi-check-circle-fill');
                    } else {
                        $('#reqDifferent').removeClass('text-muted text-success').addClass('text-danger')
                            .find('i').removeClass('bi-circle bi-check-circle-fill').addClass('bi-x-circle-fill');
                    }
                } else {
                    $('#reqDifferent').removeClass('text-success text-danger').addClass('text-muted')
                        .find('i').removeClass('bi-check-circle-fill bi-x-circle-fill').addClass('bi-circle');
                }
            });

            // Form validation
            $('form').submit(function () {
                if ($(this).valid()) {
                    $(this).find('button[type="submit"]')
                        .prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');
                }
            });
        });
    </script>

    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .card-header {
            border-bottom: 3px solid rgba(255, 255, 255, 0.3);
        }

        .form-label {
            margin-bottom: 0.5rem;
        }

        .input-group .form-control {
            border-right: 0;
        }

        .input-group .btn {
            border-left: 0;
        }

        .input-group:focus-within .form-control,
        .input-group:focus-within .btn {
            border-color: #0dcaf0;
        }

        .input-group .form-control:focus {
            box-shadow: none;
        }

        .btn {
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }

        button[disabled] {
            cursor: not-allowed;
            opacity: 0.7;
        }

        .invalid-feedback {
            display: block;
            margin-top: 0.25rem;
        }

        .input-validation-error {
            border-color: #dc3545 !important;
        }

        #passwordRequirements li {
            transition: all 0.3s ease;
        }

        #passwordRequirements li.text-success {
            font-weight: 500;
        }

        .progress {
            background-color: #e9ecef;
        }

        media (max-width: 576px) {
            .container {
                padding-left: 15px;
                padding-right: 15px;
            }

            .card-body {
                padding: 1.5rem !important;
            }

            .card-header h5 {
                font-size: 1.1rem;
            }

            .card-footer {
                font-size: 0.75rem;
            }
        }

        keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card {
            animation: fadeIn 0.3s ease;
        }
    </style>
}