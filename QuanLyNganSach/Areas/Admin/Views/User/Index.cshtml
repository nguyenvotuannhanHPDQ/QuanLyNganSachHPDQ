@using PagedList.Mvc
@model PagedList.IPagedList<QuanLyNganSach.Models.ViewModels.UserListViewModel>
@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Quản lý tài khoản
                    </li>
                </ol>
            </nav>

            <!-- Header với nút thêm mới -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0 fw-semibold">
                        <i class="bi bi-people-fill text-primary me-2"></i>
                        Danh sách tài khoản
                    </h4>
                    <small class="text-muted">
                        Tổng số: <span>@Model.Count()</span> tài khoản
                    </small>
                </div>
                <a href="@Url.Action("Create", "User", new { area = "Admin" })"
                   class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Tạo tài khoản mới
                </a>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Html.Raw(TempData["Success"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Card chứa bảng -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    @using (Html.BeginForm("Index", "User", new { area = "Admin" }, FormMethod.Get, new { id = "searchForm" }))
                    {
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           id="searchInput"
                                           name="search"
                                           value="@ViewBag.CurrentSearch"
                                           class="form-control"
                                           placeholder="Tìm kiếm theo mã NV, họ tên, quyền...">
                                    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch))
                                    {
                                        <button type="button" class="btn btn-outline-secondary" id="clearSearch" title="Xóa tìm kiếm">
                                            <i class="bi bi-x-lg"></i>Clear
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                <div class="btn-group" role="group">
                                    <input type="radio" class="btn-check" name="status" id="filterAll" value="all"
                                           @(ViewBag.CurrentStatus == "all" ? "checked" : "")>
                                    <label class="btn btn-outline-secondary btn-sm" for="filterAll">
                                        <i class="bi bi-list-ul"></i> Tất cả
                                    </label>

                                    <input type="radio" class="btn-check" name="status" id="filterActive" value="active"
                                           @(ViewBag.CurrentStatus == "active" ? "checked" : "")>
                                    <label class="btn btn-outline-success btn-sm" for="filterActive">
                                        <i class="bi bi-check-circle"></i> Đang hoạt động
                                    </label>

                                    <input type="radio" class="btn-check" name="status" id="filterInactive" value="inactive"
                                           @(ViewBag.CurrentStatus == "inactive" ? "checked" : "")>
                                    <label class="btn btn-outline-danger btn-sm" for="filterInactive">
                                        <i class="bi bi-x-circle"></i> Ngừng hoạt động
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <!-- Desktop Table -->
                        <div class="table-responsive d-none d-lg-block">
                            <table class="table table-hover align-middle mb-0" id="userTable">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">
                                            <i class="bi bi-hash text-primary"></i>
                                            STT
                                        </th>
                                        <th>
                                            Mã nhân viên
                                        </th>
                                        <th>
                                            <i class="bi bi-person text-primary"></i>
                                            Họ và tên
                                        </th>
                                        <th>
                                            <i class="bi bi-shield-check text-primary"></i>
                                            Đơn vị
                                        </th>
                                        <th>
                                            <i class="bi bi-shield-check text-primary"></i>
                                            Quyền
                                        </th>
                                        <th class="text-center">
                                            <i class="bi bi-toggle-on text-primary"></i>
                                            Trạng thái
                                        </th>
                                        <th>
                                            <i class="bi bi-clock-history text-primary"></i>
                                            Ngày tạo
                                        </th>
                                        <th class="text-center px-4">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int index = 1; }
                                    @foreach (var user in Model)
                                    {
                                        <tr data-status="@(user.IsActive ? "active" : "inactive")">
                                            <td class="px-4 fw-semibold text-muted">@index</td>
                                            <td>
                                                <span>@user.MaNhanVien</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@user.HoTen</div>
                                            </td>
                                            <td>
                                                <span>
                                                    @user.TenPhongBan
                                                </span>
                                            </td>
                                            <td>
                                                <span>
                                                    @user.RoleName
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (user.IsActive)
                                                {
                                                    <span>
                                                        <i class="bi bi-check-circle-fill me-1"></i>
                                                        Hoạt động
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        <i class="bi bi-x-circle-fill me-1"></i>
                                                        Ngừng hoạt động
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @user.CreatedDate.ToString("dd/MM/yyyy")
                                                    <br />
                                                </small>
                                            </td>
                                            <td class="text-center px-4">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="@Url.Action("Edit", "User", new { area = "Admin", id = user.UserId })"
                                                       class="btn btn-outline-warning"
                                                       title="Chỉnh sửa">
                                                        <i class="bi bi-pencil"></i>Sửa
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-outline-info btn-reset"
                                                            data-user-id="@user.UserId"
                                                            data-user-name="@user.HoTen"
                                                            data-user-code="@user.MaNhanVien"
                                                            title="Reset mật khẩu">
                                                        <i class="bi bi-arrow-clockwise"></i>Reset mật khẩu
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-delete"
                                                            data-user-id="@user.UserId"
                                                            data-user-name="@user.HoTen"
                                                            title="Xóa">
                                                        <i class="bi bi-trash"></i>Xóa
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Cards -->
                        <div class="d-lg-none" id="userCards">
                            @foreach (var user in Model)
                            {
                                <div class="card border-0 border-bottom rounded-0 user-card"
                                     data-status="@(user.IsActive ? "active" : "inactive")">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1 fw-semibold">@user.HoTen</h6>
                                                <span>@user.MaNhanVien</span>
                                            </div>
                                            @if (user.IsActive)
                                            {
                                                <span>
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </span>
                                            }
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="bi bi-shield-check text-primary"></i>
                                                Quyền:
                                            </small>
                                            <span>
                                                @user.RoleName
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="bi bi-clock-history"></i>
                                                @user.CreatedDate.ToString("dd/MM/yyyy")
                                            </small>
                                            <div class="btn-group btn-group-sm">
                                                <a href="@Url.Action("Edit", "User", new { area = "Admin", id = user.UserId })"
                                                   class="btn btn-outline-warning btn-sm">
                                                    <i class="bi bi-pencil"></i>Sửa
                                                </a>
                                                <button type="button"
                                                        class="btn btn-outline-info btn-sm btn-reset"
                                                        data-user-id="@user.UserId"
                                                        data-user-name="@user.HoTen"
                                                        data-user-code="@user.MaNhanVien">
                                                    <i class="bi bi-arrow-clockwise"></i>Reset mật khẩu
                                                </button>
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm btn-delete"
                                                        data-user-id="@user.UserId"
                                                        data-user-name="@user.HoTen">
                                                    <i class="bi bi-trash"></i>Xóa
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @*else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox display-1 text-muted"></i>
                                <p class="text-muted mt-3">Chưa có tài khoản nào trong hệ thống</p>
                                <a href="@Url.Action("Create", "User", new { area = "Admin" })"
                                   class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Tạo tài khoản
                                </a>
                            </div>
                        }*@
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="card-footer bg-light py-3">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Hiển thị <span id="displayCount">@Model.Count</span> / @Model.TotalItemCount tài khoản
                                    <span class="mx-2">|</span>
                                    <i class="bi bi-clock-history"></i>
                                    Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div class="col-md-6">
                                <div class="pagination-wrapper">
                                    @if (Model.PageCount > 1)
                                    {
                                        <nav aria-label="Phân trang">
                                            <ul class="pagination pagination-sm mb-0 justify-content-center justify-content-md-end">
                                                <!-- First page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Đầu</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Đầu</span>
                                                    }
                                                </li>

                                                <!-- Previous page -->
                                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                                    @if (Model.HasPreviousPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Trước</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Trước</span>
                                                    }
                                                </li>

                                                <!-- Page numbers -->
                                                @{
                                                    int startPage = Math.Max(1, Model.PageNumber - 2);
                                                    int endPage = Math.Min(Model.PageCount, Model.PageNumber + 2);

                                                    // Adjust if at the beginning
                                                    if (Model.PageNumber <= 3)
                                                    {
                                                        endPage = Math.Min(5, Model.PageCount);
                                                    }

                                                    // Adjust if at the end
                                                    if (Model.PageNumber >= Model.PageCount - 2)
                                                    {
                                                        startPage = Math.Max(1, Model.PageCount - 4);
                                                    }
                                                }

                                                @for (int i = startPage; i <= endPage; i++)
                                                {
                                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                        @if (i == Model.PageNumber)
                                                        {
                                                            <span class="page-link">@i</span>
                                                        }
                                                        else
                                                        {
                                                            <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">@i</a>
                                                        }
                                                    </li>
                                                }

                                                <!-- Next page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Sau</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Sau</span>
                                                    }
                                                </li>

                                                <!-- Last page -->
                                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                                    @if (Model.HasNextPage)
                                                    {
                                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageCount, search = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Cuối</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="page-link">Cuối</span>
                                                    }
                                                </li>
                                            </ul>
                                        </nav>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Xác nhận vô hiệu hóa tài khoản
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="bi bi-person-x display-1 text-danger"></i>
                </div>
                <p class="text-center mb-3">
                    Bạn có chắc chắn muốn vô hiệu hóa tài khoản:
                </p>
                <div class="alert alert-warning mb-3">
                    <strong id="deleteUserName"></strong>
                </div>
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle"></i>
                    Tài khoản sẽ không thể đăng nhập vào hệ thống. Bạn có thể kích hoạt lại tài khoản bằng cách chỉnh sửa.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Hủy bỏ
                </button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="bi bi-check-circle me-1"></i>
                    Xác nhận vô hiệu hóa
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal xác nhận reset mật khẩu -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="resetPasswordModalLabel">
                    <i class="bi bi-arrow-clockwise me-2"></i>
                    Xác nhận reset mật khẩu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="bi bi-key display-1 text-info"></i>
                </div>
                <p class="text-center mb-3">
                    Bạn có chắc chắn muốn reset mật khẩu cho tài khoản:
                </p>
                <div class="mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold" id="resetUserName"></div>
                            <small class="text-muted">Mã NV: <span id="resetUserCode"></span></small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Hủy bỏ
                </button>
                <button type="button" class="btn btn-info text-white" id="confirmReset">
                    <i class="bi bi-check-circle me-1"></i>
                    Xác nhận reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal hiển thị mật khẩu mới -->
<div class="modal fade" id="resetSuccessModal" tabindex="-1" aria-labelledby="resetSuccessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="resetSuccessModalLabel">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Reset mật khẩu thành công
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="bi bi-shield-check display-1 text-success mb-3"></i>
                <p class="mb-3" id="resetSuccessMessage"></p>
                <div class="alert alert-success border border-success mb-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <button type="button" class="btn btn-success btn-sm" id="copyPassword" title="Copy mật khẩu">
                            <i class="bi bi-clipboard"></i>
                            Copy
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                    <i class="bi bi-check-lg me-1"></i>
                    Đã hiểu
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Form ẩn để submit delete -->
@using (Html.BeginForm("Delete", "User", new { area = "Admin" }, FormMethod.Post, new { id = "deleteForm" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteUserId" name="id" value="" />
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var deleteUserId = null;

            // Auto-dismiss alerts
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Search on input with debounce
            var searchTimeout;
            $('#searchInput').on('keyup', function (e) {
                // Don't submit on Enter key here (handled separately)
                if (e.which === 13) {
                    return;
                }

                clearTimeout(searchTimeout);
                var searchValue = $(this).val(); // Capture value

                searchTimeout = setTimeout(function () {
                    // Ensure value is set before submit
                    $('#searchInput').val(searchValue);
                    $('#searchForm').submit();
                }, 500); // Wait 500ms after user stops typing
            });

            // Filter by status - submit form immediately
            $('input[name="status"]').on('change', function () {
                $('#searchForm').submit();
            });

            // Clear search button
            $('#clearSearch').on('click', function () {
                $('#searchInput').val('');
                $('#searchForm').submit();
            });

            // Handle Enter key explicitly
            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    clearTimeout(searchTimeout); // Cancel debounce
                    $('#searchForm').submit();
                }
            });

            // Reset password button click
            $('.btn-reset').on('click', function () {
                resetUserId = $(this).data('user-id');
                var userName = $(this).data('user-name');
                var userCode = $(this).data('user-code');

                $('#resetUserName').text(userName);
                $('#resetUserCode').text(userCode);
                $('#resetPasswordModal').modal('show');
            });

            // Confirm reset password
            $('#confirmReset').on('click', function () {
                if (resetUserId) {
                    var $button = $(this);
                    $button.prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');

                    $.ajax({
                        url: '@Url.Action("ResetPassword", "User", new { area = "Admin" })',
                        type: 'POST',
                        data: {
                            id: resetUserId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            $('#resetPasswordModal').modal('hide');

                            if (response.success) {
                                // Show success modal with new password
                                $('#resetSuccessMessage').html(response.message);
                                $('#resetSuccessModal').modal('show');
                            } else {
                                // Show error message
                                var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                    '<i class="bi bi-exclamation-triangle-fill me-2"></i>' +
                                    response.message +
                                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                    '</div>';
                                $('.container .row .col-12').prepend(alertHtml);
                            }
                        },
                        error: function () {
                            $('#resetPasswordModal').modal('hide');
                            var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                '<i class="bi bi-exclamation-triangle-fill me-2"></i>' +
                                'Đã xảy ra lỗi. Vui lòng thử lại.' +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>';
                            $('.container .row .col-12').prepend(alertHtml);
                        },
                        complete: function () {
                            $button.prop('disabled', false)
                                .html('<i class="bi bi-check-circle me-1"></i>Xác nhận reset');
                        }
                    });
                }
            });

            // Reset modal on close
            $('#resetPasswordModal').on('hidden.bs.modal', function () {
                resetUserId = null;
                $('#confirmReset').prop('disabled', false)
                    .html('<i class="bi bi-check-circle me-1"></i>Xác nhận reset');
            });

            // Copy password to clipboard
            $('#copyPassword').on('click', function () {
                var password = $('#displayNewPassword').text();
                var $button = $(this);

                // Create temporary input
                var $temp = $('<input>');
                $('body').append($temp);
                $temp.val(password).select();
                document.execCommand('copy');
                $temp.remove();

                // Show feedback
                var originalHtml = $button.html();
                $button.html('<i class="bi bi-check-lg"></i> Đã copy')
                    .removeClass('btn-success')
                    .addClass('btn-outline-success');

                setTimeout(function () {
                    $button.html(originalHtml)
                        .removeClass('btn-outline-success')
                        .addClass('btn-success');
                }, 2000);
            });

            // Delete button click
            $('.btn-delete').on('click', function () {
                deleteUserId = $(this).data('user-id');
                var userName = $(this).data('user-name');

                $('#deleteUserName').text(userName);
                $('#deleteModal').modal('show');
            });

            // Confirm delete
            $('#confirmDelete').on('click', function () {
                if (deleteUserId) {
                    var $button = $(this);
                    $button.prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');

                    $.ajax({
                        url: '@Url.Action("Delete", "User", new { area = "Admin" })',
                        type: 'POST',
                        data: {
                            id: deleteUserId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            $('#deleteModal').modal('hide');

                            if (response.success) {
                                var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                    '<i class="bi bi-check-circle-fill me-2"></i>' +
                                    response.message +
                                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                    '</div>';
                                $('.container .row .col-12').prepend(alertHtml);

                                setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            } else {
                                var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                    '<i class="bi bi-exclamation-triangle-fill me-2"></i>' +
                                    response.message +
                                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                    '</div>';
                                $('.container .row .col-12').prepend(alertHtml);
                            }
                        },
                        error: function () {
                            $('#deleteModal').modal('hide');
                            alert('Đã xảy ra lỗi. Vui lòng thử lại.');
                        },
                        complete: function () {
                            $button.prop('disabled', false)
                                .html('<i class="bi bi-check-circle me-1"></i>Xác nhận vô hiệu hóa');
                        }
                    });
                }
            });

            // Reset modal on close
            $('#deleteModal').on('hidden.bs.modal', function () {
                deleteUserId = null;
                $('#confirmDelete').prop('disabled', false)
                    .html('<i class="bi bi-check-circle me-1"></i>Xác nhận vô hiệu hóa');
            });

            // Row hover effect
            $('#userTable tbody tr').hover(
                function () { $(this).addClass('table-active'); },
                function () { $(this).removeClass('table-active'); }
            );

            // Loading indicator when form submits
            $('#searchForm').on('submit', function () {
                var $searchInput = $('#searchInput');

                // Don't disable the input to preserve value
                // $searchInput.prop('disabled', true);

                // Show loading spinner
                if ($('.loading-spinner').length === 0) {
                    $('<div class="loading-spinner position-fixed top-50 start-50 translate-middle">' +
                        '<div class="spinner-border text-primary" role="status">' +
                        '<span class="visually-hidden">Đang tải...</span>' +
                        '</div></div>').appendTo('body');
                }
            });
        });
    </script>

