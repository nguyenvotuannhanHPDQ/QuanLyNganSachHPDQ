@model QuanLyNganSach.Models.ViewModels.EditUserViewModel
@{
    ViewBag.Title = "Chỉnh sửa tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "User", new { area = "Admin" })">
                            Quản lý tài khoản
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Chỉnh sửa
                    </li>
                </ol>
            </nav>

            <!-- Card chính -->
            <div class="card shadow-sm border-0">
                <!-- Header -->
                <div class="card-header text-bg-warning text-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square fs-5"></i>
                        <h5 class="mb-0 fw-semibold">Chỉnh sửa tài khoản</h5>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @Html.Raw(TempData["Error"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Form -->
                    @using (Html.BeginForm("Edit", "User", new { area = "Admin" }, FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.UserId)

                        <!-- Validation Summary -->
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <!-- Mã nhân viên -->
                        <div class="mb-3">
                            <label for="MaNhanVien" class="form-label fw-semibold">
                                <i class="bi bi-person-badge text-warning"></i>
                                Mã nhân viên
                                <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.MaNhanVien, new
                            {
                                @class = "form-control" + (Html.ViewData.ModelState["MaNhanVien"]?.Errors.Count > 0 ? " is-invalid" : ""),
                                placeholder = "Nhập mã nhân viên",
                                autocomplete = "off"
                            })
                            @Html.ValidationMessageFor(m => m.MaNhanVien, "", new { @class = "invalid-feedback d-block" })
                        </div>

                        <!-- Họ tên -->
                        <div class="mb-3">
                            <label for="HoTen" class="form-label fw-semibold">
                                <i class="bi bi-person text-warning"></i>
                                Họ và tên
                                <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.HoTen, new
                            {
                                @class = "form-control" + (Html.ViewData.ModelState["HoTen"]?.Errors.Count > 0 ? " is-invalid" : ""),
                                placeholder = "Nhập họ và tên đầy đủ",
                                autocomplete = "name"
                            })
                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "invalid-feedback d-block" })
                        </div>

                        <!-- Phòng ban -->
                        <div class="mb-3">
                            <label for="PhongBanId" class="form-label fw-semibold">
                                <i class="bi bi-diagram-3 text-warning"></i>
                                Phòng ban / Đơn vị
                                <span class="text-danger">*</span>
                            </label>

                            @Html.DropDownListFor(m => m.PhongBanId,
                                Model?.PhongBans ?? Enumerable.Empty<SelectListItem>(),
                                "-- Chọn phòng ban --",
                                new
                                {
                                    @class = "form-select" + (Html.ViewData.ModelState["PhongBanId"]?.Errors.Count > 0 ? " is-invalid" : "")
                                })

                            @Html.ValidationMessageFor(m => m.PhongBanId, "", new { @class = "invalid-feedback d-block" })
                        </div>

                        <!-- Quyền -->
                        <div class="mb-3">
                            <label for="RoleId" class="form-label fw-semibold">
                                <i class="bi bi-shield-check text-warning"></i>
                                Quyền hệ thống
                                <span class="text-danger">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.RoleId,
                                Model?.Roles ?? Enumerable.Empty<SelectListItem>(),
                                "-- Chọn quyền --",
                                new { @class = "form-select" + (Html.ViewData.ModelState["RoleId"]?.Errors.Count > 0 ? " is-invalid" : "") })
                            @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "invalid-feedback d-block" })
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i>
                                Quyền sẽ quy định các chức năng người dùng có thể truy cập
                            </div>
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-toggle-on text-warning"></i>
                                Trạng thái tài khoản
                            </label>
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch", id = "IsActive" })
                                <label class="form-check-label" for="IsActive">
                                    <span id="statusLabel">
                                        @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                                    </span>
                                </label>
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i>
                                Tài khoản ngừng hoạt động sẽ không thể đăng nhập vào hệ thống
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 flex-column flex-sm-row">
                            <button type="submit" class="btn btn-warning text-white flex-fill">
                                <i class="bi bi-check-circle me-1"></i>
                                Cập nhật
                            </button>
                            <a href="@Url.Action("Index", "User", new { area = "Admin" })"
                               class="btn btn-outline-secondary flex-fill">
                                <i class="bi bi-x-circle me-1"></i>
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light text-muted small py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>
                            <i class="bi bi-shield-lock"></i>
                            Thông tin được mã hóa và bảo mật
                        </span>
                        <span class="text-end">
                            <i class="bi bi-clock-history"></i>
                            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Helper text -->
            <div class="mt-3 text-center">
                <small class="text-muted">
                    <i class="bi bi-question-circle"></i>
                    Cần hỗ trợ? Liên hệ
                    <a href="mailto:support@company.com">P.CNTT & CĐS</a>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Auto-dismiss alerts
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Update status label on toggle
            $('#IsActive').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#statusLabel').text('Đang hoạt động')
                        .removeClass('text-danger')
                        .addClass('text-success');
                } else {
                    $('#statusLabel').text('Ngừng hoạt động')
                        .removeClass('text-success')
                        .addClass('text-danger');
                }
            });

            // Trigger on page load
            $('#IsActive').trigger('change');

            // Form validation
            $('form').submit(function () {
                if ($(this).valid()) {
                    $(this).find('button[type="submit"]')
                        .prop('disabled', true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');
                }
            });

            // Uppercase employee code
            $('#MaNhanVien').on('input', function () {
                $(this).val($(this).val().toUpperCase());
            });
        });
    </script>
}