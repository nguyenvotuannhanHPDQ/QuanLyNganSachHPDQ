@model QuanLyNganSach.Models.ViewModels.CreateUserViewModel
@{
    ViewBag.Title = "Tạo tài khoản người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Tạo tài khoản
                    </li>
                </ol>
            </nav>

            <!-- Card chính -->
            <div class="card shadow-sm border-0">
                <!-- Header -->
                <div class="card-header text-bg-primary text-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-plus-fill fs-5"></i>
                        <h5 class="mb-0 fw-semibold">Tạo tài khoản người dùng</h5>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Form -->
                    @using (Html.BeginForm("Create", "User", new { area = "Admin" }, FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Mã nhân viên -->
                        <div class="mb-3">
                            <label for="MaNhanVien" class="form-label fw-semibold">
                                <i class="bi bi-person-badge text-primary"></i>
                                Mã nhân viên
                                <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.MaNhanVien, new
                            {
                                @class = "form-control",
                                placeholder = "Nhập mã nhân viên",
                                autocomplete = "off"
                            })
                            @Html.ValidationMessageFor(m => m.MaNhanVien, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <!-- Họ tên -->
                        <div class="mb-3">
                            <label for="HoTen" class="form-label fw-semibold">
                                <i class="bi bi-person text-primary"></i>
                                Họ và tên
                                <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.HoTen, new
                            {
                                @class = "form-control",
                                placeholder = "Nhập họ và tên đầy đủ",
                                autocomplete = "name"
                            })
                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <!-- Đơn vị -->
                        <div class="mb-4">
                            <label for="PhongBanId" class="form-label fw-semibold">
                                <i class="bi bi-diagram-3 text-primary"></i>
                                Đơn vị / Phòng ban
                                <span class="text-danger">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.PhongBanId,
                                Model?.PhongBans ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                                "-- Chọn đơn vị --",
                                new { @class = "form-select" })

                            @Html.ValidationMessageFor(m => m.PhongBanId, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <!-- Quyền -->
                        <div class="mb-4">
                            <label for="RoleId" class="form-label fw-semibold">
                                <i class="bi bi-shield-check text-primary"></i>
                                Quyền hệ thống
                                <span class="text-danger">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.RoleId,
                                Model?.Roles ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                                "-- Chọn quyền --",
                                new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger small mt-1" })
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i>
                                Quyền sẽ quy định các chức năng người dùng có thể truy cập
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 flex-column flex-sm-row">
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-check-circle me-1"></i>
                                Tạo tài khoản
                            </button>
                            <a href="@Url.Action("Index", "Home", new { area = "" })"
                               class="btn btn-outline-secondary flex-fill">
                                <i class="bi bi-x-circle me-1"></i>
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light text-muted small py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>
                            <i class="bi bi-shield-lock"></i>
                            Thông tin được mã hóa và bảo mật
                        </span>
                        <span class="text-end">
                            <i class="bi bi-clock-history"></i>
                            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Helper text -->
            <div class="mt-3 text-center">
                <small class="text-muted">
                    <i class="bi bi-question-circle"></i>
                    Cần hỗ trợ? Liên hệ
                    <a href="mailto:support@company.com">P.CNTT & CĐS</a>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Form validation
            $('form').submit(function () {
                if ($(this).valid()) {
                    // Disable submit button to prevent double submission
                    $(this).find('button[type="submit"]')
                        .prop('disabled', true)
                        .html('<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...');
                }
            });

            // Uppercase employee code input
            $('#MaNhanVien').on('input', function () {
                $(this).val($(this).val().toUpperCase());
            });
        });
    </script>

    <style>
        /* Custom styles matching layout theme */
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .card-header {
            border-bottom: 3px solid rgba(255, 255, 255, 0.3);
        }

        .form-label {
            margin-bottom: 0.5rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .btn {
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }

        /* Responsive adjustments */
        media (max-width: 576px) {
            .container {
                padding-left: 15px;
                padding-right: 15px;
            }

            .card-body {
                padding: 1.5rem !important;
            }

            .card-header h5 {
                font-size: 1.1rem;
            }
        }

        /* Loading state */
        button[disabled] {
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* Validation styles */
        .field-validation-error {
            display: block;
            margin-top: 0.25rem;
        }

        .input-validation-error {
            border-color: #dc3545 !important;
        }

        /* Alert animations */
        .alert {
            animation: slideDown 0.3s ease-out;
        }

        keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}